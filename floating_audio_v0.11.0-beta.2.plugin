    def _settings_log_storage(self):
        return [Header(text="日志存储"),
                Text(text="保留时间", subtext="%d 天" % self._log_limits()[0],
                     on_click=lambda *a: self._edit_log_limit("log_retention_days")),
                Switch(key="log_auto_delete",text="自动删除过期日志",default=True,
                       on_change=self._changed_callback("log_auto_delete")),
                Divider(text="关闭后不按时间删除。容量达到上限时，仍会清理最旧记录。"),
                Text(text="容量上限", subtext="%d MB" % (self._log_limits()[1]//1048576),
                     on_click=lambda *a: self._edit_log_limit("log_capacity_mb")),
                Divider(text="默认保留 7 天、最多 100 MB。容量先满时，实际保留时间可能不足 7 天。达到上限会提醒，每天最多一次。")]

    def _edit_log_limit(self, key):
        activity = self._get_activity()
        if activity is None: return
        days = key == "log_retention_days"
        upper = 3650 if days else 4096
        current = self._log_limits()[0 if days else 1]
        if not days: current //= 1048576
        edit = self._themed_edit(activity)
        edit.setSingleLine(True)
        edit.setInputType(2)
        edit.setText(str(current))
        builder = AlertDialogBuilder(activity)
        builder.set_title("保留天数" if days else "容量上限（MB）")
        builder.set_message("请输入 1～%d 的整数。保存后生效。" % upper)
        builder.set_view(edit)
        builder.set_negative_button("取消")
        def save(bld, which):
            value = str(edit.getText()).strip()
            if not re.fullmatch(r"[0-9]{1,4}",value) or not 1 <= int(value) <= upper:
                edit.setError("请输入 1～%d 的整数" % upper)
                return
            self.set_setting(key,str(int(value)),reload_settings=True)
            self._setting_changed(key,value)
            bld.dismiss()
        builder.set_positive_button("保存")
        builder.show()
        button = builder.get_button(-1)
        if button is not None:
            button.setOnClickListener(OnClickListener(lambda v:save(builder,-1)))

    def _settings_backup(self):
        self._settings_hint_until = time.monotonic()+1.8
        return [Header(text="设置备份"),
                Text(text="复制设置（JSON）", on_click=self._export_backup_clicked),
                Text(text="导入设置（JSON）", on_click=self._import_backup_clicked)]

    @diagnostic_operation
    def _setting_changed(self, key, value):
        if key.startswith("log_"):
            self._log_scan_at = 0
        # UI callback values are trusted only for a declared key. Never log free text.
        if key not in SETTING_DEFAULTS:
            return
        if isinstance(SETTING_DEFAULTS[key], bool):
            reported = bool(value)
        elif key == "speed_rates":
            reported = "speed_count:" + str(len(parse_speed_list(value)))
        elif isinstance(SETTING_DEFAULTS[key], int):
            reported = config_int(value, 0, 0, 100000)
        else:
            reported = config_int(value, 0, -9999, 9999)
        self._record("setting_changed", setting=key, value=str(reported))
        if key in ("spectrum_mode", "glow_style"):
            self._update_glow_style_cell()
            if getattr(self,"_flash_animator",None) is not None:
                self._clear_flash_glow()
            self._record("effect_selected", style=self._active_effect_name(), source=key)
        if key == "spectrum_source":
            # Explicit source choice only; backups cannot turn capture on.
            self._fft_release("waiting" if config_int(value,0,0,1) else "simulated")
            self._real_fft_levels = None
        if key in ("spectrum_bands", "spectrum_refresh_rate"):
            self._spectrum_live_bitmap = None
            self._spectrum_smoothed = None
            self._spectrum_next_capture_at = 0.0
            if key == "spectrum_bands":
                # Switching modes releases the previous listener/Visualizer;
                # a new capture chain starts with the next playback frame.
                self._fft_release("stopped")
                self._fft_track_key = None
                self._real_fft_levels = None
                self._fft_32_retry_at = 0.0
        if key == "sleep_choice":
            # Only the next start uses the new preference. No deadline reset,
            # full settings reload, material redraw or persisted active flag.
            run_on_ui_thread(self._sync_sleep_settings)
            if config_int(value,2,0,5) == 5:
                run_on_ui_thread(self._edit_sleep_duration)
            return
        if key in ("show_cover", "cover_quality"):
            self.last_cover_key = None
        if key == "ball_size" and config_int(value,58,40,86) <= 48 and \
                config_int(self.get_setting("touch_mode",0),0,0,1) == 0:
            self._record("touch_zone_warning", reason="small_ball_classic", size_dp=config_int(value,58,40,86))
            run_on_ui_thread(self._warn_small_ball)
        if getattr(self, "alive", False):
            # In-place change: no remove/recreate, so no (0,0) flash.
            self._settings_apply_generation = getattr(self, "_settings_apply_generation", 0)+1
            generation = self._settings_apply_generation
            run_on_ui_thread(lambda: self._apply_settings() if generation == self._settings_apply_generation else None, 16)

    def _warn_small_ball(self):
        try:
            self._show_info("圆盘较小，圆环容易误触。可调大圆盘或改为智能状态模式。")
        except Exception as exc:
            self._failure("small_ball_hint", exc)

    @diagnostic_operation
    def _apply_settings(self):
        if not self.alive: return
        try:
            self._update_glow_style_cell()
            if not self.get_setting("enabled", True):
                self._remove_overlay()
                return
            if self.backgrounded:
                self._last_layout_signature = None
                self._glow_bitmap_key = None
                self._glow_state = None
                return
            if self.container is not None and self.main is not None:
                ball, _, _ = self._sizes()
                self.cover.setRoundRadius(dp(ball / 2))
                self._apply_button_style()
                self._stop_color_flow()
                self._wave_shader_key = None
                self._glow_bitmap_key = None
                self._last_layout_signature = None
                self._progress_last_value = None
                self._glow_state = None
                self._spectrum_cache_key = None
                self._spectrum_frames.clear()
                self._relayout()
                self._render_glow()
                self._render_progress_ring(self._playing_message())
                self._record("effect_applied", style=self._active_effect_name(), result="draw_requested")
                if config_int(self.get_setting("light_transition",2),2,0,3)==0:
                    self._light_transition_generation+=1
                    self._light_envelope=self._light_target
                    self._apply_light_envelope()
                    if self._light_target <= 0: self._finish_light_transition(self._light_transition_generation)
                self._update_glow(force=True)
                if self.expanded:
                    self._refresh_material_backdrops()
                self._record("settings_applied", status="in_place",
                             expanded=self.expanded, x_px=int(self.center_x or 0),
                             y_px=int(self.center_y or 0))
            self._refresh()
        except Exception as exc:
            self._failure("settings_apply", exc)

    # -----------------------------------------------------------------
    # Privacy-preserving settings backup and opt-in interface probe.
    # -----------------------------------------------------------------
    @diagnostic_operation
    def _export_backup_clicked(self, view=None):
        try:
            prefs = {key: self.get_setting(key, default) for key, default in SETTING_DEFAULTS.items()
                     if key not in ("animation_migration_v085", "preview", "spectrum_source", "sleep_timer_enabled")}
            content = json.dumps({"format": "AyuGramFloatingAudioSettings", "schema": 1,
                                  "settings": prefs}, ensure_ascii=False, indent=2)
            activity = self._get_activity()
            if activity is None: raise RuntimeError("no activity")
            clipboard = activity.getSystemService("clipboard")
            clipboard.setPrimaryClip(ClipData.newPlainText("AyuGram Floating Audio", content))
            self._record("backup_export", result="copied", count=len(prefs))
            self._show_info("设置备份已复制。请粘贴到文本文件妥善保存。")
        except Exception as exc:
            self._failure("backup_export", exc)
            try: BulletinHelper.show_error("设置备份复制失败")
            except Exception: pass

    def _import_backup_clicked(self, view=None):
        try:
            activity = self._get_activity()
            if activity is None: return
            edit = self._themed_edit(activity)
            edit.setHint("粘贴此前复制的 JSON 设置备份")
            edit.setSingleLine(False)
            edit.setMinLines(4)
            edit.setMaxLines(8)
            self._backup_import_listener = BackupImportListener(self, edit)
            dialog = AlertDialogBuilder(activity)
            dialog.set_title("导入设置")
            dialog.set_message("恢复备份中的已知设置。建议先备份当前设置。")
            dialog.set_view(edit)
            dialog.set_negative_button("取消")
            dialog.set_positive_button("导入",lambda bld,which: self._backup_import_listener.onClick(bld,which))
            dialog.show()
        except Exception as exc:
            self._failure("backup_dialog", exc)

    @diagnostic_operation
    def _import_backup_text(self, value):
        try:
            if len(value) > 16000: raise ValueError("backup too large")
            obj = json.loads(value)
            if not isinstance(obj, dict) or obj.get("format") != "AyuGramFloatingAudioSettings":
                raise ValueError("invalid backup format")
            prefs = obj.get("settings")
            if not isinstance(prefs, dict): raise ValueError("missing settings")
            clean = {}
            for k, v in prefs.items():
                if k not in SETTING_DEFAULTS or k in ("preview", "animation_migration_v085", "spectrum_source", "sleep_timer_enabled"):
                    continue
                default = SETTING_DEFAULTS[k]
                if isinstance(default, bool) and type(v) is bool:
                    clean[k] = v
                elif isinstance(default, int) and type(v) is int and 0 <= v <= (1440 if k == "sleep_custom_minutes" else 12):
                    clean[k] = v
                elif isinstance(default, str) and isinstance(v, str) and len(v) <= 120:
                    clean[k] = v
            if not clean: raise ValueError("no matching settings")
            # Do not overwrite unknown plugin preferences or enable preview.
            changed = {k for k,v in clean.items() if self.get_setting(k,SETTING_DEFAULTS[k]) != v}
            self.import_settings(clean, reload_settings=False)
            if changed.intersection(("show_cover", "cover_quality")):
                self.last_cover_key = None
                self._wave_shader_key = None
            if any(k.startswith("log_") for k in changed):
                self._log_scan_at = 0
            if changed.intersection(("spectrum_bands", "spectrum_mode")):
                self._fft_release("stopped")
                self._fft_track_key = None
                self._real_fft_levels = None
                self._fft_32_retry_at = 0.0
            self._record("backup_import", result="ok", count=len(clean))
            self._settings_apply_generation = getattr(self, "_settings_apply_generation", 0)+1
            generation = self._settings_apply_generation
            run_on_ui_thread(lambda: self._apply_settings() if generation == self._settings_apply_generation else None, 16)
            self._show_info("已恢复 %d 项设置，请返回设置首页查看。" % len(clean))
        except Exception as exc:
            self._failure("backup_import", exc)
            try: BulletinHelper.show_error("设置备份无效，请检查 JSON 格式")
            except Exception: pass

    @staticmethod
    def _fft_cast_field(value, name):
        """Recover Java interface members after reflective Field.get() on Chaquopy.

        java.lang.reflect.Field.get() is typed as Object at the Python bridge,
        even when the runtime value is VideoPlayer/ExoPlayer. On this Object
        view, getattr(value, "getAudioSessionId") is absent. Cast only to
        a small allowlist of known playback *types*: never change the player.
        """
        if value is None:
            return None
        try:
            from java import cast, jclass
        except ImportError:
            return value
        if name in ("audioPlayer", "videoPlayer"):
            types = (
                "org.telegram.ui.Components.VideoPlayer",
                "androidx.media3.exoplayer.ExoPlayer",
                "com.google.android.exoplayer2.ExoPlayer",
                "com.google.android.exoplayer2.SimpleExoPlayer",
                "android.media.AudioTrack",
            )
        elif name == "player":
            # Prefer the concrete ExoPlayer contract. Older Telegram forks
            # expose audio sessions on ExoPlayer but not on common.Player.
            types = (
                "androidx.media3.exoplayer.ExoPlayer",
                "com.google.android.exoplayer2.ExoPlayer",
                "com.google.android.exoplayer2.SimpleExoPlayer",
                "androidx.media3.common.Player",
                "com.google.android.exoplayer2.Player",
            )
        else:  # audioTrackPlayer (older Telegram forks)
            types = (
                "android.media.AudioTrack",
                "androidx.media3.exoplayer.ExoPlayer",
                "com.google.android.exoplayer2.ExoPlayer",
                "androidx.media3.common.Player",
                "com.google.android.exoplayer2.Player",
            )
        for typename in types:
            try:
                return cast(jclass(typename), value)
            except Exception:
                # The named class may not exist in this Telegram fork, or the
                # runtime field may use a different player implementation.
                continue
        return value

    @staticmethod
    def _fft_read_field(obj, name):
        # Narrow, read-only compatibility access. Never inspect audio buffers.
        if obj is None or name not in ("audioPlayer", "player", "audioTrackPlayer", "videoPlayer"):
            return None
        try:
            value = getattr(obj, name)
            if value is not None:
                return FloatingAudioPlugin._fft_cast_field(value, name)
        except Exception:
            pass
        try:
            cls = obj.getClass()
            for _ in range(4):
                if cls is None:
                    break
                try:
                    field = cls.getDeclaredField(name)
                    field.setAccessible(True)
                    value = field.get(obj)
                    return FloatingAudioPlugin._fft_cast_field(value, name)
                except Exception:
                    cls = cls.getSuperclass()
        except Exception:
            pass
        return None

    @staticmethod
    def _fft_expand_native_bands(values, count=28):
        """Turn Telegram's six *measured* FFT buckets into interpolated display bars.

        These are interpolated display bars, not 28 independent frequency bins.
        Native values[6] is overall strength, not a seventh frequency bin.
        """
        if values is None or len(values) < 7:
            return None
        bands = []
        for v in values[:6]:
            x = float(v)
            if not math.isfinite(x):
                return None
            bands.append(clamp(x, 0.0, 1.0))
        # Interpolate only between real frequency measurements. No simulated
        # ripple or artificial beat is introduced.
        out = []
        count = 32 if count == 32 else 28
        for i in range(count):
            at = (i * 5.0) / float(count - 1)
            lower = int(at)
            upper = min(lower + 1, 5)
            w = at - lower
            out.append(bands[lower] * (1.0 - w) + bands[upper] * w)
        return out

    def _fft_native_detach(self):
        """Restore Telegram's original visualizer delegate on unplug/unload.

        Only restore if our proxy is STILL attached. Never overwrite a delegate
        replaced by Telegram itself during a track or player transition.
        """
        self._fft_native_want = False
        hook = getattr(self, "_fft_native_hook", None)
        self._fft_native_hook = None
        self._fft_native_last_values = None
        self._fft_native_at = 0.0
        if not hook:
            return
        wrapper, field, original, proxy = hook
        try:
            from java.lang import System as JavaSystem
            current = field.get(wrapper)
            if JavaSystem.identityHashCode(current) == JavaSystem.identityHashCode(proxy):
                wrapper.setAudioVisualizerDelegate(original)
                self._record("real_fft_native_probe", stage="detach", result="restored")
            else:
                self._record("real_fft_native_probe", stage="detach", result="host_changed")
        except Exception as exc:
            self._record("real_fft_native_probe", stage="detach", result="failed", type=type(exc).__name__)

    @diagnostic_operation
    def _fft_native_attach(self, mc, now):
        """Non-destructive tee of Telegram's own FFT visualization callback.

        Telegram creates its visualizing audio renderer before starting playback
        when a native delegate is present. We *only* bridge an existing delegate,
        leaving the original implementation responsible for its own UI.
        """
        if getattr(self, "_fft_native_hook", None):
            return True
        if now < getattr(self, "_fft_native_retry_at", 0.0):
            return False
        self._fft_native_retry_at = now + 8.0
        try:
            from java import jclass, cast
            wrapper = self._fft_read_field(mc, "audioPlayer")
            if wrapper is None:
                self._record("real_fft_native_probe", stage="wrapper", result="missing")
                return False
            klass = jclass("org.telegram.ui.Components.VideoPlayer")
            interface = jclass("org.telegram.ui.Components.VideoPlayer$AudioVisualizerDelegate")
            wrapper = cast(klass, wrapper)
            field = wrapper.getClass().getDeclaredField("audioVisualizerDelegate")
            field.setAccessible(True)
            original = field.get(wrapper)
            if original is None:
                # Native FFT renderer would not be installed on this already
                # constructed player; do not replace an absent native delegate.
                self._record("real_fft_native_probe", stage="delegate", result="missing")
                return False
            original = cast(interface, original)
            plugin_ref = weakref.ref(self)

            class NativeFFTBridge(dynamic_proxy(interface)):
                def needUpdate(self):
                    plugin = plugin_ref()
                    old_want = False
                    try:
                        old_want = bool(original.needUpdate())
                    except Exception:
                        pass
                    return old_want or bool(plugin is not None and plugin._fft_native_want and plugin.alive)

                def onVisualizerUpdate(self, playing, animate, values):
                    plugin = plugin_ref()
                    # Do not break Telegram's own audio visualizer callback.
                    try:
                        original.onVisualizerUpdate(playing, animate, values)
                    except Exception:
                        pass
                    try:
                        if plugin is None or not plugin.alive or not plugin._fft_native_want or not playing or values is None:
                            return
                        if len(values) < 7:
                            return
                        vals = tuple(float(values[i]) for i in range(7))
                        if all(math.isfinite(x) for x in vals):
                            plugin._fft_native_last_values = vals
                            plugin._fft_native_at = time.monotonic()
                            plugin._fft_received_frames += 1
                    except Exception:
                        pass

            proxy = NativeFFTBridge()
            wrapper.setAudioVisualizerDelegate(proxy)
            self._fft_native_hook = (wrapper, field, original, proxy)
            self._fft_native_started = now
            self._fft_native_want = True
            self._record("real_fft_native_probe", stage="attach", result="ok")
            return True
        except Exception as exc:
            self._record("real_fft_native_probe", stage="attach", result="failed", type=type(exc).__name__)
            return False

    def _fft_native_levels(self, mc, now):
        """Return (handled, bars). handled=True means we are waiting on native FFT."""
        hooked = getattr(self, "_fft_native_hook", None)
        if hooked is None:
            if not self._fft_native_attach(mc, now):
                return False, None
        self._fft_native_want = True
        if not getattr(self, "_fft_native_hook", None):
            return False, None
        values = getattr(self, "_fft_native_last_values", None)
        age = now - getattr(self, "_fft_native_at", 0.0)
        if values is not None and age <= 1.5:
            bars = self._fft_expand_native_bands(values, self._spectrum_band_count())
            if bars is not None:
                self._real_fft_levels = bars
                self._fft_set_status("live_native")
                return True, bars
        # Wait for async callbacks. If the playback renderer never sends one,
        # restore the native delegate and try the existing session-ID path.
        if now - getattr(self, "_fft_native_started", now) <= 3.0:
            self._fft_set_status("waiting")
            return True, None
        self._record("real_fft_native_probe", stage="frames", result="timeout")
        self._fft_native_detach()
        return False, None

    def _spectrum_band_count(self):
        return 32 if config_int(self.get_setting("spectrum_bands", 0), 0, 0, 1) == 0 else 28

    def _fft_32_event(self, stage, result, exc=None):
        """Bounded enum-only diagnostics. Never log session IDs or PCM."""
        tag = (stage, result, type(exc).__name__ if exc else None)
        if tag == getattr(self, "_fft_32_last_state", None):
            return
        self._fft_32_last_state = tag
        self._fft_32_diagnostic = stage + ":" + result
        kwargs = {"stage": stage, "result": result}
        if exc is not None:
            kwargs["type"] = type(exc).__name__
        self._record("real_fft_32_probe", **kwargs)

    def _fft_analytics_detach(self):
        hook = getattr(self, "_fft_analytics_hook", None)
        self._fft_analytics_hook = None
        self._fft_analytics_session = None
        self._fft_analytics_at = 0.0
        if hook is None:
            return
        player, listener = hook
        try:
            player.removeAnalyticsListener(listener)
            self._fft_32_event("listener_detach", "ok")
        except Exception as exc:
            self._fft_32_event("listener_detach", "failed", exc)

    def _fft_analytics_attach(self, mc, now):
        """Listen for future Media3 session changes, never modify playback.

        A listener attached during an already-playing track may not get an
        initial event. Changing track once triggers the next opportunity.
        """
        if now < getattr(self, "_fft_analytics_retry_at", 0.0):
            return False
        try:
            from java import cast, jclass
            wrapper = self._fft_read_field(mc, "audioPlayer")
            player = self._fft_read_field(wrapper, "player")
            if player is None:
                self._fft_32_event("player", "missing")
                self._fft_analytics_retry_at = now + 8.0
                return False
            player = cast(jclass("androidx.media3.exoplayer.ExoPlayer"), player)
            old = getattr(self, "_fft_analytics_hook", None)
            if old is not None:
                try:
                    from java.lang import System as JavaSystem
                    if (JavaSystem.identityHashCode(old[0]) ==
                            JavaSystem.identityHashCode(player)):
                        return True
                except Exception:
                    pass
                self._fft_analytics_detach()
            interface = jclass("androidx.media3.exoplayer.analytics.AnalyticsListener")
            owner_ref = weakref.ref(self)

            class SessionListener(dynamic_proxy(interface)):
                def onAudioSessionIdChanged(self, event_time, session_id):
                    owner = owner_ref()
                    if owner is None or not getattr(owner, "alive", False):
                        return
                    try:
                        value = int(session_id)
                        owner._fft_analytics_session = value if value > 0 else None
                        owner._fft_analytics_at = time.monotonic()
                        owner._fft_32_event("session_event", "valid" if value > 0 else "invalid")
                    except Exception as exc:
                        owner._fft_32_event("session_event", "failed", exc)

            listener = SessionListener()
            player.addAnalyticsListener(listener)
            self._fft_analytics_hook = (player, listener)
            self._fft_analytics_retry_at = 0.0
            self._fft_32_event("listener_attach", "ok")
            return True
        except Exception as exc:
            self._fft_analytics_retry_at = now + 10.0
            self._fft_32_event("listener_attach", "failed", exc)
            return False

    def _fft_release_visualizer_only(self):
        visualizer = getattr(self, "_fft_visualizer", None)
        self._fft_visualizer = None
        self._fft_session = None
        self._fft_buffer = None
        if visualizer is not None:
            try:
                visualizer.setEnabled(False)
            except Exception:
                pass
            try:
                visualizer.release()
            except Exception as exc:
                self._fft_32_event("visualizer_release", "failed", exc)

    def _fft_try_32_levels(self, mc, now, speed, strength):
        """32 distinct logarithmic FFT bands, with native six-band fallback.

        Requires a positive session ID delivered by the current Media3 player.
        Never claim success until getFft has returned valid data.
        """
        if self._spectrum_band_count() != 32:
            return None
        attached = self._fft_analytics_attach(mc, now)
        if not attached:
            return None
        session = getattr(self, "_fft_analytics_session", None)
        if session is None:
            self._fft_32_event("session", "awaiting_event")
            return None
        if not self._fft_permission_granted():
            self._fft_32_event("permission", "missing")
            return None
        if now < getattr(self, "_fft_32_retry_at", 0.0):
            return None
        try:
            if self._fft_visualizer is None or self._fft_session != session:
                self._fft_release_visualizer_only()
                self._fft_visualizer = self._fft_open(session)
                self._fft_session = session
                size = int(self._fft_visualizer.getCaptureSize())
                self._fft_buffer = jarray(jbyte)([0] * size)
                self._fft_32_event("visualizer", "opened")
            if int(self._fft_visualizer.getFft(self._fft_buffer)) != 0:
                raise RuntimeError("fft_capture_failed")
            # Verify playback and session again before displaying this sample.
            if (not self._fft_should_capture() or
                    self._fft_analytics_session != session):
                self._fft_release_visualizer_only()
                return None
            levels = fft_band_levels(self._fft_buffer, self._fft_visualizer.getSamplingRate(), 32, strength)
            if not all(math.isfinite(x) for x in levels):
                raise RuntimeError("nonfinite_fft")
            self._fft_32_at = now
            self._fft_32_frames += 1
            self._fft_received_frames += 1
            self._real_fft_levels = levels
            self._fft_set_status("live32")
            if self._fft_32_frames == 1:
                self._fft_32_event("frames", "live")
            return levels
        except Exception as exc:
            self._fft_release_visualizer_only()
            self._fft_32_retry_at = now + 15.0
            self._fft_32_event("visualizer", "failed", exc)
            return None

    def _fft_permission_granted(self):
        activity = self._get_activity()
        return bool(activity is not None and
                    activity.checkSelfPermission("android.permission.RECORD_AUDIO") == 0)

    def _fft_set_status(self, status):
        if status not in FFT_STATUS_TEXT:
            status = "capture_failed"
        previous = getattr(self, "_fft_status", None)
        self._fft_status = status
        if status in ("permission_missing", "session_unavailable", "wrong_thread", "capture_failed"):
            self._fft_last_fallback_status = status
        elif status in ("live", "live_native", "live32"):
            self._fft_last_fallback_status = None
        if status != previous:
            # Enumerations only: no session identifiers, FFT bytes or media.
            self._record("real_fft_state", status=status)

    def _fft_release(self, reason="stopped"):
        resources = any(getattr(self,key,None) is not None for key in
                        ("_fft_visualizer", "_fft_native_hook", "_fft_analytics_hook"))
        if not resources and getattr(self,"_fft_status",None) == reason:
            self._fft_idle_release_count = getattr(self,"_fft_idle_release_count",0)+1
            now = time.monotonic()
            if now-getattr(self,"_fft_idle_release_at",now) >= 60:
                self._flush_fft_idle_releases()
            elif not hasattr(self,"_fft_idle_release_at"):
                self._fft_idle_release_at = now
            return
        self._flush_fft_idle_releases()
        self._release_fft_resources(reason)

    def _flush_fft_idle_releases(self):
        count = getattr(self,"_fft_idle_release_count",0)
        if count:
            self._record("fft_release_idle", count=count, status=getattr(self,"_fft_status","stopped"),
                         result="no_resources")
        self._fft_idle_release_count = 0
        self._fft_idle_release_at = time.monotonic()

    @diagnostic_operation
    def _release_fft_resources(self, reason="stopped"):
        # A listener is attached only while B is visible and playing.
        # On track transitions the caller explicitly preserves it so it can
        # receive the upcoming onAudioSessionIdChanged notification.
        if reason not in ("waiting", "track_change"):
            self._fft_analytics_detach()
        self._fft_native_detach()
        visualizer = getattr(self, "_fft_visualizer", None)
        self._fft_visualizer = None
        self._fft_session = None
        self._fft_buffer = None
        # Preserve the last real 28-band frame only for the shared fade-out.
        # New capture/track and failures clear it before it can become stale.
        if visualizer is not None:
            try: visualizer.setEnabled(False)
            except Exception: pass
            try: visualizer.release()
            except Exception as exc:
                self._record("real_fft_release", result="failed", type=type(exc).__name__)
        self._fft_set_status(reason)

    def _fft_should_capture(self):
        reason = None
        if not getattr(self, "alive", False):
            reason = "stopped"
        elif getattr(self, "backgrounded", False):
            reason = "background"
        elif (not self.get_setting("enabled", True) or
              config_int(self.get_setting("spectrum_mode",0),0,0,2) == 0):
            reason = "disabled"
        elif config_int(self.get_setting("spectrum_source",0),0,0,1) != 1:
            reason = "simulated"
        elif (self.container is None or self.container.getVisibility() != View.VISIBLE or
              self.manual_hidden_key is not None):
            reason = "hidden"
        else:
            try:
                mc = get_media_controller()
                if mc.getPlayingMessageObject() is None:
                    reason = "no_audio"
                elif (bool(mc.isMessagePaused()) or
                      (getattr(self, "_requested_paused", None) is True and
                       time.monotonic() < self._requested_paused_deadline)):
                    reason = "paused"
            except Exception:
                reason = "capture_failed"
        self._fft_block_reason = reason
        return reason is None

    def _fft_lifecycle_sync(self):
        if not self._fft_should_capture():
            self._fft_release(self._fft_block_reason)

    @diagnostic_operation
    def _fft_open(self, session_id):
        if isinstance(session_id, bool) or not 0 < int(session_id) <= 2147483647:
            raise ValueError("positive playback session required")
        from android.media.audiofx import Visualizer
        visualizer = None
        try:
            visualizer = Visualizer(jint(session_id))
            if int(visualizer.setEnabled(False)) != 0:
                raise RuntimeError("FFT disable failed")
            limits = Visualizer.getCaptureSizeRange()
            lower, upper = int(limits[0]), min(1024, int(limits[1]))
            size = 1
            while size * 2 <= upper:
                size *= 2
            if size < max(4, lower):
                raise RuntimeError("FFT capture size unsupported")
            if int(visualizer.setCaptureSize(jint(size))) != 0:
                raise RuntimeError("FFT size failed")
            # AS_PLAYED avoids normalizing quiet/silent audio into full bars.
            scaling = getattr(visualizer, "setScalingMode", None)
            if scaling is not None:
                if int(scaling(jint(Visualizer.SCALING_MODE_AS_PLAYED))) != 0:
                    raise RuntimeError("FFT scaling failed")
            if int(visualizer.setEnabled(True)) != 0:
                raise RuntimeError("FFT enable failed")
            return visualizer
        except Exception:
            if visualizer is not None:
                try: visualizer.release()
                except Exception: pass
            raise

    def _fft_levels(self, speed, strength):
        """Use Media3-listener 32-bin FFT or Telegram native 6-bin FFT only.

        The retired getAudioSessionId polling + 28-band Visualizer path has
        been removed. The 28 bar setting now means visual bar COUNT only.
        """
        if not self._fft_should_capture():
            self._fft_release(self._fft_block_reason)
            return None
        now = time.monotonic()
        try:
            mc = get_media_controller()
            msg = mc.getPlayingMessageObject()
            key = self._internal_audio_key(msg)
            if key != getattr(self, "_fft_track_key", None):
                self._fft_release("track_change")
                # Old session IDs must not authorize FFT from the next track.
                self._fft_analytics_session = None
                self._real_fft_levels = None
                self._fft_track_key = key
            # 32-bin real FFT requires a Media3 session event; no legacy poll.
            real32 = self._fft_try_32_levels(mc, now, speed, strength)
            if real32 is not None:
                return real32
            handled, native_levels = self._fft_native_levels(mc, now)
            if handled:
                return native_levels
            self._fft_set_status("waiting")
            return None
        except Exception as exc:
            self._fft_release("capture_failed")
            self._real_fft_levels = None
            self._record("real_fft_error", type=type(exc).__name__, status="capture_failed")
            return None

    def _refresh_fft_display_status(self):
        if not self._fft_should_capture():
            self._fft_set_status(self._fft_block_reason)
            return
        now = time.monotonic()
        if (getattr(self,"_fft_visualizer",None) is not None and
                0 <= now-getattr(self,"_fft_32_at",0) <= 1.5):
            self._fft_set_status("live32")
        elif (getattr(self,"_fft_native_hook",None) is not None and
              getattr(self,"_fft_native_want",False) and
              getattr(self,"_fft_native_last_values",None) is not None and
              0 <= now-getattr(self,"_fft_native_at",0) <= 1.5):
            self._fft_set_status("live_native")
        elif getattr(self,"_fft_status","") in ("live32","live_native","live"):
            self._fft_set_status("waiting")

    def _fft_status_clicked(self, view=None):
        self._refresh_fft_display_status()
        if config_int(self.get_setting("spectrum_source",0),0,0,1) == 0:
            text = FFT_STATUS_TEXT["simulated"]
        else:
            text = FFT_STATUS_TEXT.get(self._fft_status, FFT_STATUS_TEXT["waiting"])
            last_error = getattr(self, "_fft_last_fallback_status", None)
            if last_error is not None and self._fft_status not in ("live", "live_native", "live32"):
                text += "\n最近一次回退原因（历史）：" + FFT_STATUS_TEXT[last_error]
        if self._fft_status == "live_native":
            text += "\n说明：6 个频段来自播放器原生 FFT，%d 根柱子通过插值展示，不是独立采样。" % self._spectrum_band_count()
        elif self._fft_status == "live32":
            text += "\n32 频段来自 Android Visualizer；采样率和 FFT 长度决定低频分辨率。"
        if self._spectrum_band_count() == 32 and self._fft_status not in ("live32", "live_native"):
            text += "\n独立 32 频段接口（不影响原生通道）：" + str(getattr(self, "_fft_32_diagnostic", "not_started"))
            text += "\n说明：若监听器刚连接，请切换一次歌曲或重新播放。"
        text += "\n本次插件运行累计读取 FFT 帧：%d（历史，不代表当前正在采样）" % getattr(self, "_fft_received_frames", 0)
        try: self._show_info(text)
        except Exception: pass

    @diagnostic_operation
    def _probe_true_spectrum(self, view=None):
        """Read-only FFT readiness: prioritize a fresh *actual* native callback.

        Telegram's native FFT does not require getAudioSessionId, so an old
        session-only probe must NOT label the working native path not_ready.
        Never start a Visualizer or inject another delegate from this probe.
        """
        try:
            self._refresh_fft_display_status()
            if not self._fft_should_capture():
                self._show_info(FFT_STATUS_TEXT.get(self._fft_block_reason,"等待播放数据"))
                return
            if config_int(self.get_setting("spectrum_source", 0), 0, 0, 1) == 0:
                self._record("real_fft_probe", result="simulated", available=False)
                self._show_info("当前选择 A 模拟频谱。如需真实采样，请选择 B 方案。")
                return
            if (getattr(self, "_fft_status", "") == "live32" and
                    getattr(self, "_fft_visualizer", None) is not None and
                    self._fft_should_capture()):
                self._record("real_fft_probe", result="fft32_live", available=True,
                             source="android_visualizer", frames=self._fft_32_frames)
                self._show_info("✅ 已获取 Android FFT，正在显示 32 个独立频段。")
                return
            age = time.monotonic() - getattr(self, "_fft_native_at", 0.0)
            native_hook = getattr(self, "_fft_native_hook", None) is not None
            native_values = getattr(self, "_fft_native_last_values", None)
            native_fresh = (native_hook and
                            bool(getattr(self, "_fft_native_want", False)) and
                            getattr(self, "_fft_status", "") == "live_native" and
                            native_values is not None and
                            0 <= age <= 1.5 and
                            self._fft_should_capture())
            if native_fresh:
                self._record("real_fft_probe", result="native_live", available=True,
                             source="telegram_native",
                             frames=int(getattr(self, "_fft_received_frames", 0)))
                self._show_info(
                    "✅ B 方案正在接收 Telegram 原生 FFT 数据。\n"
                    "6 个真实频段插值为 %d 根频谱柱（不是独立采样）。" % self._spectrum_band_count()
                )
                return
            if native_hook:
                self._record("real_fft_probe", result="native_not_current", available=False,
                             source="telegram_native",
                             status=str(getattr(self, "_fft_status", "waiting")))
                self._show_info(
                    "原生 FFT 桥接已接入，但此刻未确认收到新鲜数据。"
                    "请在前台保持播放并查看频谱状态。"
                )
                return
            self._record("real_fft_probe", result="not_ready", available=False,
                         status=str(getattr(self, "_fft_status", "waiting")))
            self._show_info(
                "尚未确认实时采样。请在前台播放音乐后查看当前频谱状态；"
                "新 Media3 监听器可能需要下一首歌曲才能获得会话事件。"
            )
        except Exception as exc:
            self._record("real_fft_probe", result="not_ready", type=type(exc).__name__)
            try: self._show_info("当前无法确认实时采集状态，请在前台播放后查看频谱状态。")
            except Exception: pass

    # -----------------------------------------------------------------
    # Sleep timer (uses existing Telegram playback controller only).
    # -----------------------------------------------------------------
    @diagnostic_operation
    def _sleep_native_toggle(self, enabled):
        """AyuGram native Switch callback; timer state is the sole authority."""
        if getattr(self, "_sleep_switch_syncing", False):
            return
        try:
            self._request_sleep_enabled(bool(enabled))
        except Exception as exc:
            self._failure("sleep_native_toggle", exc)
        finally:
            # SDK implementations may persist the row value immediately
            # before or after invoking on_change. Reconcile after callback.
            run_on_ui_thread(self._sync_sleep_settings, 90)

    def _sync_sleep_settings(self):
        """Sync the native setting to real timer state, including completion.

        SDK set_setting(..., reload_settings=True) rebonds visible rows on hosts
        that support it; failures must never change the actual timer state.
        """
        if getattr(self, "_sleep_switch_syncing", False):
            return
        active = bool(getattr(self, "_sleep_active", False))
        try:
            stored = bool(self.get_setting("sleep_timer_enabled", False))
            if stored == active:
                return
            self._sleep_switch_syncing = True
            try:
                self.set_setting("sleep_timer_enabled", active, reload_settings=True)
            except TypeError:
                self.set_setting("sleep_timer_enabled", active)
        except Exception as exc:
            self._failure("sleep_native_sync", exc)
        finally:
            self._sleep_switch_syncing = False

    def _request_sleep_enabled(self, enabled):
        """Called by a controlled UI widget; never persist a running flag."""
        if not getattr(self, "alive", False):
            self._sync_sleep_settings()
            return False
        if bool(enabled):
            return self._start_sleep_timer()
        self._cancel_sleep_timer()
        return True

    @diagnostic_operation
    def _start_sleep_timer(self, view=None):
        if self._sleep_active:
            self._sync_sleep_settings()
            return True  # Duplicate callbacks must not restart a live task.
        choice = config_int(self.get_setting("sleep_choice", 2), 2, 0, len(SLEEP_CHOICES)-1)
        # Query failure is not an empty player, and cannot create a task.
        try:
            msg = get_media_controller().getPlayingMessageObject()
        except Exception as exc:
            self._failure("sleep_start", exc)
            msg = None
        if msg is None:
            self._sync_sleep_settings()
            try: self._show_info("请先播放一首真实音频再开启定时器")
            except Exception: pass
            return False
        self._sleep_generation = getattr(self, "_sleep_generation", 0) + 1
        self._sleep_active = True
        self._sleep_choice_running = choice
        self._sleep_deadline = None
        self._sleep_track_key = None
        self._sleep_gap_since = None
        self._sleep_pause_retry_at = 0.0
        self._sleep_pause_pending = False
        self._sleep_pause_accepted_key = None
        self._sleep_phase = "running"
        if choice == 4:
            self._sleep_track_key = self._internal_audio_key(msg)
            notice = "已开启：本曲结束后暂停"
        else:
            minutes = (config_int(self.get_setting("sleep_custom_minutes",45),45,1,1440)
                       if choice == 5 else (10, 20, 30, 60)[choice])
            self._sleep_deadline = time.monotonic() + 60 * minutes
            notice = "已开启：%d 分钟后暂停" % minutes
        self._record("sleep_start", mode="track_end" if choice == 4 else "timer")
        self._sync_sleep_settings()
        try: self._show_info(notice)
        except Exception: pass
        return True

    def _sleep_status_text(self):
        if not self._sleep_active:
            return "未启用"
        if self._sleep_track_key is not None:
            status = "本曲结束后暂停"
        else:
            remain = max(0, int(math.ceil((self._sleep_deadline or 0)-time.monotonic())))
            status = "剩余 %d 分 %02d 秒" % (remain//60, remain%60)
        phase = getattr(self, "_sleep_phase", "running")
        if phase == "gap":
            return status + " · 正在确认播放状态"
        if phase == "retry":
            return status + " · 暂停未成功，正在重试"
        if phase == "waiting":
            return status + " · 等待播放就绪后暂停" if self._sleep_pause_pending else status + " · 等待播放状态更新"
        if getattr(self, "_sleep_pause_pending", False):
            return status + " · 正在暂停"
        return status

    def _sleep_status_clicked(self, view=None):
        try: self._show_info(self._sleep_status_text())
        except Exception: pass

    def _clear_sleep_timer(self, sync=True):
        self._sleep_generation = getattr(self, "_sleep_generation", 0) + 1
        self._sleep_active = False
        self._sleep_deadline = None
        self._sleep_track_key = None
        self._sleep_choice_running = None
        self._sleep_gap_since = None
        self._sleep_pause_retry_at = 0.0
        self._sleep_pause_pending = False
        self._sleep_pause_accepted_key = None
        self._sleep_phase = "off"
        if sync:
            self._sync_sleep_settings()

    @diagnostic_operation
    def _cancel_sleep_timer(self, view=None):
        was_active = self._sleep_active
        self._clear_sleep_timer()
        if was_active:
            self._record("sleep_cancel", result="ok")
            try: self._show_info("睡眠定时器已取消，音乐继续播放")
            except Exception: pass

    def _set_sleep_phase(self, phase, reason):
        if getattr(self, "_sleep_phase", "off") != phase:
            self._sleep_phase = phase
            self._record("sleep_state", status=phase, reason=reason)

    @diagnostic_operation
    def _complete_sleep_timer(self, reason, generation):
        if not self._sleep_active or generation != self._sleep_generation:
            return
        self._record("sleep_completed", reason=reason, result="ok")
        self._clear_sleep_timer()

    def _poll_sleep_timer(self):
        if not self._sleep_active:
            return
        now = time.monotonic()
        try:
            msg = get_media_controller().getPlayingMessageObject()
        except Exception as exc:
            # An unavailable controller cannot confirm continuous absence.
            self._sleep_gap_since = None
            self._set_sleep_phase("waiting", "controller_unavailable")
            if now >= self._sleep_pause_retry_at:
                self._sleep_pause_retry_at = now + 2.0
                self._failure("sleep_media_query", exc)
            return
        self._sleep_tick(msg, now)

    @staticmethod
    def _sleep_downloading(mc):
        probe = getattr(mc, "isDownloadingCurrentMessage", None)
        return bool(probe()) if probe is not None else None

    @diagnostic_operation
    def _try_sleep_pause(self, msg, now):
        """Pause the current real message and verify controller acceptance.

        Telegram's isMessagePaused also means 'downloading'. False returns
        and internally caught Java failures must not consume the timer.
        """
        generation = self._sleep_generation
        key = self._internal_audio_key(msg)
        try:
            mc = get_media_controller()
            downloading = self._sleep_downloading(mc)
            if downloading is True:
                self._sleep_pause_accepted_key = None
                self._set_sleep_phase("waiting", "downloading")
                return False
            # An accepted asynchronous pause may become visible on a later poll.
            if (self._sleep_pause_accepted_key == key and
                    self._internal_audio_key(mc.getPlayingMessageObject()) == key and
                    bool(mc.isMessagePaused()) and downloading is False):
                return True
            if now < self._sleep_pause_retry_at:
                return False
            result = mc.pauseMessage(msg)
            if generation != self._sleep_generation or not self._sleep_active:
                return False  # Reentrant cancel/restart must not affect a new task.
            self._sleep_pause_retry_at = now + 2.0
            if result is not None and not bool(result):
                self._sleep_pause_accepted_key = None
                self._set_sleep_phase("retry", "controller_rejected")
                self._record("sleep_pause_retry", result="rejected")
                return False
            self._sleep_pause_accepted_key = key
            current = mc.getPlayingMessageObject()
            downloading = self._sleep_downloading(mc)
            if self._internal_audio_key(current) != key:
                self._sleep_pause_accepted_key = None
                self._set_sleep_phase("waiting", "current_track_changed")
                return False
            # Unknown/void return types require an unambiguous observed state.
            # A known True from older forks still establishes acceptance when
            # the optional downloading query does not exist.
            if bool(mc.isMessagePaused()) and (downloading is False or
                                               (downloading is None and result is True)):
                return True
            self._set_sleep_phase("waiting", "pause_not_confirmed")
        except Exception as exc:
            if generation == self._sleep_generation and self._sleep_active:
                self._sleep_pause_accepted_key = None
                self._sleep_pause_retry_at = now + 2.0
                self._set_sleep_phase("retry", "controller_exception")
                self._failure("sleep_pause", exc)
        return False

    def _sleep_tick(self, msg, now=None):
        """Advance one runtime task; independent of all overlay/render settings."""
        if not self._sleep_active:
            return
        now = time.monotonic() if now is None else float(now)
        generation = self._sleep_generation
        if msg is None:
            if self._sleep_gap_since is None:
                self._sleep_gap_since = now
                self._record("sleep_gap", result="pending")
            self._set_sleep_phase("gap", "no_current_audio")
            if now - self._sleep_gap_since >= 20.0:
                self._complete_sleep_timer("confirmed_no_next_track", generation)
            return
        key = self._internal_audio_key(msg)
        if self._sleep_gap_since is not None:
            self._record("sleep_gap", result="resumed_same_track" if key == self._sleep_track_key else "audio_returned")
            self._sleep_gap_since = None
        due = self._sleep_deadline is not None and now >= self._sleep_deadline
        changed = self._sleep_track_key is not None and key != self._sleep_track_key
        if not (self._sleep_pause_pending or due or changed):
            self._set_sleep_phase("running", "waiting_for_condition")
            return
        # Once the condition fired, retries apply even if B changes back to A.
        self._sleep_pause_pending = True
        if self._try_sleep_pause(msg, now):
            self._complete_sleep_timer("time_elapsed" if self._sleep_deadline is not None else "track_changed", generation)

    def _sleep_track_transition(self, msg, now=None):
        # Compatibility entry point for focused regressions; the main polling
        # chain calls _sleep_tick once for either mode, never both methods.
        if self._sleep_track_key is not None:
            self._sleep_tick(msg, now)

    @staticmethod
    def _internal_audio_key(msg):
        if msg is None: return None
        try: return (int(msg.currentAccount), int(msg.getDialogId()), int(msg.getId()))
        except Exception: return id(msg)

    # -----------------------------------------------------------------
    # Song-change information card and passive circular progress bar.
    # -----------------------------------------------------------------
    def _song_label(self, msg):
        if msg is None: return "", ""
        def take(method):
            try:
                value = getattr(msg, method)()
                s = str(value).strip() if value is not None else ""
                return s[:72] if s and s.lower() != "null" else ""
            except Exception:
                return ""
        title = take("getMusicTitle") or take("getDocumentName") or "下一首音频"
        author = take("getMusicAuthor")
        duration = self._duration(msg)
        desc = (author + "  ·  " if author else "") + (fmt_time(duration) if duration > 0 else "音频")
        return title, desc

    @diagnostic_operation
    def _notice_track_changed(self, msg):
        if msg is None or not self.get_setting("track_popup", True): return
        title, desc = self._song_label(msg)
        self._track_notice_title_cache, self._track_notice_detail_cache = title, desc
        self._track_notice_until = time.monotonic() + config_int(
            self.get_setting("track_popup_seconds", "4"), 4, 2, 8)
        if self.track_notice_title is not None:
            self.track_notice_title.setText(title)
            self.track_notice_detail.setText(desc)
        self._record("track_notice", result="shown", duration_s=self._duration(msg))

    def _update_track_notice(self):
        view = self.track_notice
        if view is None: return
        active = bool(not self.backgrounded and self._track_notice_until > time.monotonic()
                      and self.get_setting("track_popup", True))
        if active:
            self.track_notice_title.setText(self._track_notice_title_cache)
            self.track_notice_detail.setText(self._track_notice_detail_cache)
        if active == getattr(self,"_notice_shown",False): return
        self._notice_shown = active
        self._notice_generation = getattr(self,"_notice_generation",0)+1
        token = self._notice_generation
        kind = self._animation_kind()
        duration = self._animation_duration() if kind else 0
        view.animate().cancel()
        scale = .97 if kind == 5 else .54 if kind == 6 else .70
        rotation = (-9.0 if self.right_edge else 9.0) if kind == 3 else 0.0
        shift = float(dp(4 if kind == 5 else 22)*(-1 if self.right_edge else 1))
        if active:
            if view.getVisibility() != View.VISIBLE:
                view.setAlpha(0.0 if kind else 1.0)
                view.setScaleX(scale if kind else 1.0)
                view.setScaleY(scale if kind else 1.0)
                view.setTranslationX(shift if kind else 0.0)
                view.setRotation(rotation)
            view.setVisibility(View.VISIBLE)
        interpolator = OvershootInterpolator(1.1) if kind in (4,6) and active else DecelerateInterpolator()
        view.animate().alpha(1.0 if active else 0.0).scaleX(1.0 if active else scale).scaleY(
            1.0 if active else scale).translationX(0.0 if active else shift).rotation(
            0.0 if active else rotation).setStartDelay(0).setDuration(duration).setInterpolator(interpolator).start()
        wave = getattr(self,"_notice_ripple",None)
        if wave is not None:
            wave.animate().cancel()
            wave.setVisibility(View.GONE)
            if active and kind == 2:
                wave.setVisibility(View.VISIBLE)
                wave.setAlpha(.65)
                wave.setScaleX(.85)
                wave.setScaleY(.85)
                wave.animate().alpha(0.0).scaleX(1.15).scaleY(1.35).setStartDelay(0).setDuration(duration).start()
        if not active:
            def finish():
                if token == self._notice_generation and self.track_notice is view:
                    view.setVisibility(View.GONE)
            run_on_ui_thread(finish,duration+20)

    def _render_progress_ring(self, msg):
        if self.progress_ring is None: return
        duration = self._duration(msg) if msg is not None else 0
        if duration <= 0 or not self.get_setting("progress_ring", True):
            self.progress_ring.setVisibility(View.GONE)
            return
        fraction = clamp(float(max(0, int(msg.audioProgressSec))) / float(duration), 0.0, 1.0)
        ball, _, _ = self._sizes()
        side = dp(ball + 36)
        # One persistent bitmap per size; avoid large per-tick allocations.
        if self._progress_bitmap is None or self._progress_bitmap_side != side:
            self._progress_bitmap = Bitmap.createBitmap(side, side, Bitmap.Config.ARGB_8888)
            self._progress_bitmap_side = side
            self._progress_last_value = None
            self.progress_ring.setImageBitmap(self._progress_bitmap)
        start, sweep = -90.0, 360.0
        if config_int(self.get_setting("progress_arc_mode",0),0,0,1):
            x = float(self.center_x or 0)
            if self.motion_host is not None: x += float(self.motion_host.getTranslationX())
            start, sweep = visible_progress_arc(x, self.container.getWidth(), dp(ball/2+4), self.right_edge)
            if self.is_snapped and not self.expanded and not self._closing_menu and self._depth() >= 100:
                sweep = 0.0
        marker = (round(fraction, 4), side, round(start,2), round(sweep,2))
        if self._progress_last_value != marker:
            self._progress_bitmap.eraseColor(argb32(0, 0, 0, 0))
            canvas = Canvas(self._progress_bitmap)
            paint = Paint(Paint.ANTI_ALIAS_FLAG)
            paint.setStyle(Paint.Style.STROKE)
            paint.setStrokeWidth(float(dp(2.5)))
            paint.setStrokeCap(Paint.Cap.ROUND)
            center = side / 2.0
            radius = dp(ball / 2 + 4)
            frame = RectF(float(center-radius), float(center-radius),
                          float(center+radius), float(center+radius))
            paint.setColor(argb32(80, 180, 205, 235))
            canvas.drawArc(frame, float(start), float(sweep), False, paint)
            paint.setColor(argb32(240, 115, 210, 255))
            canvas.drawArc(frame, float(start), float(sweep*fraction), False, paint)
            self.progress_ring.invalidate()
            self._progress_last_value = marker
        self.progress_ring.setVisibility(View.VISIBLE if sweep > .01 else View.GONE)
        self._diagnostic_sample("progress_render", fraction=fraction, width_px=side, available=sweep>.01, result="draw_requested")

    # -----------------------------------------------------------------
    # Diagnostics: JSONL, bounded rotation, explicit allowed keys only.
    # -----------------------------------------------------------------
    def _record(self, kind, **kwargs):
        try:
            if not hasattr(self,"_log_lock"): self._log_lock = threading.RLock()
            with self._log_lock:
                local = getattr(self,"_diagnostic_local",None)
                stack = getattr(local,"stack",[]) if local is not None else []
                if stack: kwargs.setdefault("operation_id",stack[-1][0])
                # Only repetitive samples/errors are coalesced; user operations stay intact.
                if kind in ("sample","exception"):
                    key = (kind,kwargs.get("stage"),kwargs.get("error_id"),kwargs.get("reason"))
                    now = time.monotonic()
                    rates = getattr(self,"_log_rate",{})
                    last, suppressed = rates.get(key,(-100.0,0))
                    if now-last < 1.0:
                        rates[key] = (last,suppressed+1)
                        self._log_rate = rates
                        return
                    kwargs["suppressed"] = suppressed
                    if len(rates)>256: rates.clear()
                    rates[key]=(now,0)
                    self._log_rate=rates
                self._write_record(kind,**kwargs)
        except Exception:
            pass  # Diagnostics must never interrupt playback or UI.

    def _write_record(self, kind, **kwargs):
        try:
            self._event_seq += 1
            payload = {"utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                       "mono_ms": int(time.monotonic() * 1000),
                       "seq": self._event_seq, "kind": kind}
            for k, v in kwargs.items():
                if k not in SAFE_FIELDS:
                    continue
                if isinstance(v, (bool, int, float)):
                    payload[k] = round(v, 3) if isinstance(v, float) else v
                elif isinstance(v, str) and k in SAFE_STRING_FIELDS:
                    payload[k] = v[:64]
                elif k == "frames" and isinstance(v, list):
                    payload[k] = [str(x)[:128] for x in v[:12]]
            raw = json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n"
            if self.log_dir:
                incoming = len(raw.encode("utf-8"))
                now = time.time()
                if now >= getattr(self,"_log_scan_at",0):
                    self._prune_logs(incoming)
                if getattr(self,"_log_total_bytes",0)+incoming > self._log_limits()[1]:
                    self._queue_log_full_notice()
                    self._prune_logs(incoming)
                day = time.strftime("%Y%m%d",time.gmtime(now))
                path = getattr(self,"_active_log_path",None)
                if (path is None or not os.path.isfile(path) or
                        getattr(self,"_active_log_day",None) != day or
                        os.path.getsize(path)+incoming > MAX_LOG_BYTES):
                    path = os.path.join(self.log_dir,"events.%s.%d.jsonl" % (day,time.time_ns()))
                    self._active_log_path = path
                    self._active_log_day = day
                self._log_total_bytes = getattr(self,"_log_total_bytes",0)+incoming
                with open(path, "a", encoding="utf-8") as f:
                    f.write(raw)
                    if kind in ("exception", "plugin_unloaded", "export_saved"):
                        f.flush()
                        os.fsync(f.fileno())
        except Exception as exc:
            try: self.logger.error("Diagnostics write failed: %s", type(exc).__name__)
            except Exception: pass

    def _log_limits(self):
        return (config_int(self.get_setting("log_retention_days","7"),7,1,3650),
                config_int(self.get_setting("log_capacity_mb","100"),100,1,4096)*1048576)

    def _log_files(self):
        # Include v0.10.7 rotations for migration; never delete cover/settings/ZIP.
        result = []
        if not self.log_dir: return result
        for name in os.listdir(self.log_dir):
            if re.fullmatch(r"events(?:\.[0-9]+)*\.jsonl",name):
                path = os.path.join(self.log_dir,name)
                if os.path.isfile(path):
                    stat = os.stat(path)
                    result.append((stat.st_mtime,path,stat.st_size))
        return sorted(result)

    def _prune_logs(self, incoming=0):
        now = time.time()
        days, capacity = self._log_limits()
        remaining = []
        for stamp,path,size in self._log_files():
            if self.get_setting("log_auto_delete",True) and stamp < now-days*86400:
                os.remove(path)
            else: remaining.append((stamp,path,size))
        total = sum(row[2] for row in remaining)
        if total+incoming > capacity:
            self._queue_log_full_notice()
        for stamp,path,size in remaining:
            if total+incoming <= capacity: break
            os.remove(path)
            total -= size
        self._log_total_bytes = total
        self._log_scan_at = now+60

    def _queue_log_full_notice(self):
        if getattr(self,"_log_notice_pending",False): return
        last = float(self.get_setting("log_last_notice",0) or 0)
        if time.time()-last < 86400: return
        self._log_notice_pending = True
        run_on_ui_thread(self._show_log_full_notice)

    def _show_log_full_notice(self):
        if not getattr(self,"alive",False):
            self._log_notice_pending = False
            return
        activity = self._get_activity()
        if activity is None or getattr(self,"backgrounded",False):
            run_on_ui_thread(self._show_log_full_notice,5000)
            return
        self._log_notice_pending = False
        self.set_setting("log_last_notice",time.time())
        builder = AlertDialogBuilder(activity)
        builder.set_title("日志已满")
        builder.set_message("已达容量上限，将自动清理最旧日志。")
        builder.set_positive_button("知道了")
        builder.set_negative_button("导出",lambda b,w:self._export_clicked(None))
        builder.set_neutral_button("设置",lambda b,w:self._edit_log_limit("log_capacity_mb"))
        builder.show()

    def _failure(self, stage, exc):
        # Hash of the exception message helps group recurring bugs without leaking its text.
        try:
            import hashlib
            error_id = hashlib.sha256(str(exc).encode("utf-8", "replace")).hexdigest()[:12]
        except Exception:
            error_id = "unknown"
        self._record("exception", stage=stage, type=type(exc).__name__,
                     error_id=error_id, error_detail=safe_error_detail(exc),
                     frames=short_stack(exc))

    # Export the existing bounded diagnostic ZIP through MediaStore and sharesheet.
    # v0.2 previously succeeded on the user's AyuGram. No Activity-result hook.
    @diagnostic_operation
    def _export_clicked(self, view):
        if getattr(self,"_export_busy",False):
            self._show_info("日志正在导出，请稍候")
            return
        try:
            self._flush_fft_idle_releases()
            state = self._diagnostic_summary()
        except Exception as exc:
            self._failure("export_summary",exc)
            BulletinHelper.show_error("无法读取诊断状态")
            return
        self._export_busy = True
        self._show_info("正在整理日志，完成后打开分享菜单")
        threading.Thread(target=lambda:self._export_worker(state),daemon=True).start()

    def _export_worker(self, state):
        stage = "prepare"
        uri = None
        try:
            self._record("export_requested", status="preparing", mode="share")
            path, filename = self._prepare_diagnostics_zip(state)
            stage = "activity"
            activity = self._get_activity()
            if activity is None:
                raise RuntimeError("AyuGram Activity unavailable")
            if int(Build.VERSION.SDK_INT) < 29:
                raise RuntimeError("Android 10+ Downloads required")
            stage = "mediastore_insert"
            values = ContentValues()
            values.put(MediaStore.MediaColumns.DISPLAY_NAME, filename)
            values.put(MediaStore.MediaColumns.MIME_TYPE, "application/zip")
            values.put(MediaStore.MediaColumns.RELATIVE_PATH,
                       Environment.DIRECTORY_DOWNLOADS + "/AyuGramDiagnostics")
            resolver = activity.getContentResolver()
            uri = resolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values)
            if uri is None:
                raise RuntimeError("MediaStore insert returned null")
            stage = "mediastore_write"
            stream = resolver.openOutputStream(uri)
            if stream is None:
                raise RuntimeError("MediaStore stream unavailable")
            written = 0
            try:
                with open(path, "rb") as src:
                    while True:
                        chunk = src.read(32768)
                        if not chunk: break
                        # Chaquopy Python bytes -> explicit Java byte[].
                        java_chunk = jarray(jbyte)(chunk)
                        stream.write(java_chunk, 0, len(java_chunk))
                        written += len(chunk)
                stream.flush()
            finally:
                stream.close()
            self._record("export_saved", status="ok", size_bytes=written, mode="share")
            # UI work is posted only after file I/O completes.
            stage = "share_chooser"
            def share(saved_uri=uri):
                try:
                    current = self._get_activity()
                    if current is None or self.backgrounded:
                        self._show_info("日志已保存：下载/AyuGramDiagnostics")
                        return
                    intent = Intent(Intent.ACTION_SEND)
                    intent.setType("application/zip")
                    intent.putExtra(Intent.EXTRA_STREAM,saved_uri)
                    intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
                    current.startActivity(Intent.createChooser(intent,"分享诊断日志"))
                    self._record("share_chooser_opened",result="ok")
                except Exception as exc:
                    self._failure("share_chooser",exc)
                    self._show_info("日志已保存：下载/AyuGramDiagnostics")
            run_on_ui_thread(share)
        except Exception as exc:
            self._failure("export_" + stage, exc)
            if uri is not None and stage != "share_chooser":
                try: self._get_activity().getContentResolver().delete(uri, None, None)
                except Exception: pass
            try:
                run_on_ui_thread(lambda:BulletinHelper.show_error("日志导出失败，请稍后重试"))
            except Exception: pass
        finally:
            # Temporary file is private and can be removed; exported file is in Downloads.
            if self.log_dir:
                pending = os.path.join(self.log_dir, "pending_diagnostics.zip")
                try:
                    if os.path.isfile(pending): os.remove(pending)
                except Exception: pass
            self._export_busy = False

    def _diagnostic_summary(self):
        if not self.log_dir:
            raise RuntimeError("diagnostic folder unavailable")
        state = {
            "plugin_version": __version__,
            "plugin_icon_status": getattr(self,"_plugin_icon_status","not_started"),
            "diagnostics": {"detail_enabled": True,
                "semantics": "entered/returned describe function execution; draw_requested is not a measured displayed frame",
                "coverage": "gestures, shortcuts, media, playlist, artwork, crop, effects, FFT, notices, timer, settings, lifecycle, export",
                "retention_days": self._log_limits()[0],
                "capacity_bytes": self._log_limits()[1],
                "auto_delete_expired": bool(self.get_setting("log_auto_delete",True)),
                "limits": "1 MiB/day segments; oldest-first capacity eviction; repeated samples/errors coalesced each second"},
            "timestamp_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "android_release": str(Build.VERSION.RELEASE),
            "android_sdk": int(Build.VERSION.SDK_INT),
            "host_app_version": "unknown",
            "ui": {
                "expanded": bool(self.expanded), "snapped": bool(self.is_snapped),
                "right_edge": bool(self.right_edge),
                "container_width_px": int(self.container.getWidth()) if self.container else 0,
                "container_height_px": int(self.container.getHeight()) if self.container else 0,
                "center_x_px": int(self.center_x or 0),
                "center_y_px": int(self.center_y or 0),
                "touch_hook_active": bool(self._touch_hook),
                "touch_hook_verified": bool(self._touch_event_seen),
                "touch_hook_count": len(self._touch_hooks),
                "fallback_touch_active": bool(self._fallback_touch_hook),
            },
            "settings": {key: self._safe_setting(key, default)
                         for key, default in SETTING_DEFAULTS.items()},
        }
        activity = self._get_activity()
        if activity is not None:
            try:
                state["host_app_version"] = str(activity.getPackageManager().getPackageInfo(
                    activity.getPackageName(), 0).versionName)
            except Exception: pass
        return state

    def _prepare_diagnostics_zip(self, state=None):
        import tempfile
        import shutil
        if state is None: state = self._diagnostic_summary()
        filename = "AyuGram_FloatingAudio_Diagnostics_%s.zip" % time.strftime("%Y%m%d_%H%M%S", time.localtime())
        path = os.path.join(self.log_dir, "pending_diagnostics.zip")
        snapshot = tempfile.mkdtemp(prefix="export_snapshot_",dir=self.log_dir)
        try:
            with self._log_lock:
                self._prune_logs()
                for stamp,source,size in self._log_files():
                    target = os.path.join(snapshot,os.path.basename(source))
                    if source == getattr(self,"_active_log_path",None):
                        shutil.copyfile(source,target)  # At most one 1 MiB live segment.
                    else:
                        try: os.link(source,target)
                        except OSError: shutil.copyfile(source,target)
            # No log lock during compression: drawing/touch events can keep logging.
            with zipfile.ZipFile(path,"w",compression=zipfile.ZIP_DEFLATED) as z:
                names = sorted(os.listdir(snapshot))
                report = coverage_report(names, lambda name:open(os.path.join(snapshot,name),"rb"))
                z.writestr("日志覆盖报告.txt", report)
                z.writestr("diagnostic_summary.json",json.dumps(state,ensure_ascii=False,indent=2))
                z.writestr("README.txt","Diagnostic events do not intentionally collect chat text or media. Review before sharing.\n")
                for name in sorted(os.listdir(snapshot)):
                    z.write(os.path.join(snapshot,name),name)
        finally:
            shutil.rmtree(snapshot,ignore_errors=True)
        with zipfile.ZipFile(path) as check_zip:
            member_count = len(check_zip.namelist())
        self._record("export_archive_ready", file_count=member_count,
                     size_bytes=os.path.getsize(path))
        return path, filename

    def _safe_setting(self, key, default):
        value = self.get_setting(key, default)
        if isinstance(default, bool): return bool(value)
        if isinstance(default, int): return config_int(value, default, 0, 100000)
        if key == "log_retention_days": return str(config_int(value,7,1,3650))
        if key == "log_capacity_mb": return str(config_int(value,100,1,4096))
        if key == "speed_rates":
            return [float(x) for x in parse_speed_list(value)]
        return config_int(value, config_int(default, 0, 0, 3600), 0, 3600)

    # -----------------------------------------------------------------
    # Overlay / layout
    # -----------------------------------------------------------------
    def _get_activity(self):
        try:
            from org.telegram.ui import LaunchActivity
            activity = LaunchActivity.instance
            return activity if activity is not None and not activity.isFinishing() else None
        except Exception:
            return None

    @diagnostic_operation
    def _ensure_overlay(self):
        activity = self._get_activity()
        if activity is None: return False
        if (self.container is not None and self.activity == activity and
                self.container.getParent() == activity.getWindow().getDecorView()):
            return True
        self._remove_overlay()
        try:
            parent = activity.getWindow().getDecorView()
            layer = FrameLayout(activity)
            layer.setClickable(False)
            layer.setFocusable(False)
            # Do not flash at 0,0 before a valid view size and position exist.
            layer.setVisibility(View.INVISIBLE)
            parent.addView(layer, ViewGroup.LayoutParams(-1, -1))
            self.container = layer
            self.activity = activity
            self.overlay_ready = False
            self._last_layout_signature = None
            self.is_snapped = True
            self._build_views(activity)
            self._record("overlay_created", status="waiting_for_layout")
            self._install_interaction_hook()
            self._layout_generation = getattr(self,"_layout_generation",0)+1
            token = self._layout_generation
            self._begin_layout_wait(token)
            return True
        except Exception as exc:
            self._failure("overlay_create", exc)
            self._remove_overlay()
            return False

    @diagnostic_operation
    def _build_views(self, ctx):
        ball, button, _ = self._sizes()
        main = FrameLayout(ctx)
        # All moving ball layers live under a single fullscreen-sized parent.
        # Only this parent translates when docking/expanding. Material scale,
        # flash alpha, RGB rotation and progress are entirely child-local.
        motion_host = FrameLayout(ctx)
        motion_host.setClickable(False)
        motion_host.setFocusable(False)
        motion_host.setClipChildren(False)
        motion_host.setClipToPadding(False)
        self.container.addView(motion_host, FrameLayout.LayoutParams(-1, -1))
        self.motion_host = motion_host
        # Glow and click flash must share ONE moving coordinate system.
        # v0.8.3 animated both children directly. _flash_glow() then called
        # flash.animate().cancel(), which also cancelled the pending XY glide,
        # leaving a visible ring at the previous docked position.
        glow_host = FrameLayout(ctx)
        glow_host.setClickable(False)
        glow_host.setClipChildren(False)
        glow_host.setClipToPadding(False)
        motion_host.addView(glow_host, FrameLayout.LayoutParams(dp(ball + 36), dp(ball + 36)))
        # Envelope fades ONLY the luminous graphics. Progress stays readable
        # when the sound is paused or when all light is turned off.
        light_host = FrameLayout(ctx)
        light_host.setClickable(False)
        light_host.setAlpha(0.0)
        glow_host.addView(light_host, FrameLayout.LayoutParams(-1, -1))
        self.light_host = light_host
        glow = ImageView(ctx)
        glow.setClickable(False)
        light_host.addView(glow, FrameLayout.LayoutParams(-1, -1))
        flash = ImageView(ctx)
        flash.setClickable(False)
        flash.setAlpha(0.0)
        light_host.addView(flash, FrameLayout.LayoutParams(-1, -1))
        spectrum = ImageView(ctx)
        spectrum.setClickable(False)
        spectrum.setVisibility(View.GONE)
        light_host.addView(spectrum, FrameLayout.LayoutParams(-1, -1))
        progress_ring = ImageView(ctx)
        progress_ring.setClickable(False)
        progress_ring.setVisibility(View.GONE)
        glow_host.addView(progress_ring, FrameLayout.LayoutParams(-1, -1))
        self.progress_ring = progress_ring
        self.glow_host, self.glow, self.glow_flash, self.spectrum = glow_host, glow, flash, spectrum
        ripple = View(ctx)
        ripple.setClickable(False)
        ripple.setVisibility(View.GONE)
        ripple.setBackground(shape("#00000000", "#70AFFF"))
        motion_host.addView(ripple, FrameLayout.LayoutParams(dp(ball), dp(ball)))
        self.ripple = ripple
        main.setBackground(shape("#17263B", "#73B3FE"))
        main.setElevation(float(dp(8)))
        main.setClickable(True)
        cover = BackupImageView(ctx)
        cover.setRoundRadius(dp(ball / 2))
        main.addView(cover, FrameLayout.LayoutParams(-1, -1, Gravity.CENTER))
        symbol = TextView(ctx)
        symbol.setText("▶")
        symbol.setTextSize(22)
        symbol.setTextColor(Color.WHITE)
        symbol.setShadowLayer(float(dp(4)), 0, 1, Color.BLACK)
        symbol.setGravity(Gravity.CENTER)
        main.addView(symbol, FrameLayout.LayoutParams(-1, -1))
        self.touch_listener = BallTouch(self)
        hit = View(ctx)
        hit.setClickable(True)
        hit.setOnTouchListener(self.touch_listener)
        self.main_hit = hit
        motion_host.addView(hit, FrameLayout.LayoutParams(dp(ball + 12), dp(ball + 12)))
        main.setOnTouchListener(self.touch_listener)
        motion_host.addView(main, FrameLayout.LayoutParams(dp(ball), dp(ball)))
        self.main, self.cover, self.symbol = main, cover, symbol

        time_text = TextView(ctx)
        time_text.setTextSize(float(config_int(self.get_setting("time_font", "10"), 10, 8, 16)))
        time_text.setTextColor(Color.parseColor("#C8D9F2"))
        time_text.setShadowLayer(float(dp(2)), 0, 1, Color.BLACK)
        time_text.setGravity(Gravity.CENTER)
        motion_host.addView(time_text, FrameLayout.LayoutParams(dp(104), dp(22)))
        self.time_text = time_text
        # Compact outward-opening notice; layout anchored to the visible ball.
        notice = FrameLayout(ctx)
        notice.setClickable(False)
        notice.setBackground(shape("#DD182A41", "#648EB8", radius=16))
        notice.setClipChildren(False)
        notice.setClipToPadding(False)
        wave = View(ctx)
        wave.setBackground(shape("#00000000","#70AFFF",radius=16))
        wave.setVisibility(View.GONE)
        notice.addView(wave,FrameLayout.LayoutParams(-1,-1))
        self._notice_ripple = wave
        title = TextView(ctx)
        title.setTextColor(Color.WHITE)
        title.setTextSize(13.0)
        title.setSingleLine(True)
        title.setEllipsize(TextUtils.TruncateAt.END)
        title.setPadding(dp(10), dp(5), dp(8), 0)
        notice.addView(title, FrameLayout.LayoutParams(-1, dp(29)))
        subtitle = TextView(ctx)
        subtitle.setTextColor(Color.parseColor("#BCD2EE"))
        subtitle.setTextSize(10.5)
        subtitle.setSingleLine(True)
        subtitle.setPadding(dp(10), 0, dp(8), 0)
        sp = FrameLayout.LayoutParams(-1, dp(21))
        sp.topMargin = dp(28)
        notice.addView(subtitle, sp)
        notice.setVisibility(View.GONE)
        self.container.addView(notice, FrameLayout.LayoutParams(dp(195), dp(52)))
        self._notice_shown = False
        self._notice_generation = getattr(self,"_notice_generation",0)+1
        self.track_notice = notice
        self.track_notice_title = title
        self.track_notice_detail = subtitle
        self.small, self.small_labels = {}, {}
        self.small_backdrops, self.small_sheens, self.small_materials = {}, {}, {}
        self._satellite_listeners = {}
        for name, label in (("speed", "1×"), ("left", "−15"), ("right", "+20"), ("close", "×")):
            v = FrameLayout(ctx)
            v.setClickable(True)
            v.setClipToOutline(True)
            backdrop = ImageView(ctx)
            backdrop.setVisibility(View.GONE)
            v.addView(backdrop, FrameLayout.LayoutParams(-1, -1))
            material = ImageView(ctx)
            material.setClickable(False)
            v.addView(material, FrameLayout.LayoutParams(-1, -1))
            sheen = View(ctx)
            sheen.setClickable(False)
            v.addView(sheen, FrameLayout.LayoutParams(-1, -1))
            glyph = TextView(ctx)
            glyph.setText(label)
            glyph.setTextSize(13 if name == "speed" else 15)
            glyph.setTextColor(Color.WHITE)
            glyph.setShadowLayer(float(dp(2)), 0, 1, Color.BLACK)
            glyph.setGravity(Gravity.CENTER)
            v.addView(glyph, FrameLayout.LayoutParams(-1, -1))
            v.setVisibility(View.GONE)
            v.setOnClickListener(OnClickListener(lambda view, name=name: self._button_action(name)))
            listener = SatelliteTouch(self, name)
            self._satellite_listeners[name] = listener
            v.setOnTouchListener(listener)
            self.container.addView(v, FrameLayout.LayoutParams(dp(button), dp(button)))
            self.small[name] = v
            self.small_labels[name] = glyph
            self.small_backdrops[name] = backdrop
            self.small_sheens[name] = sheen
            self.small_materials[name] = material
        # Non-clickable red drop target appears only after a valid long hold.
        drop = FrameLayout(ctx)
        drop.setClickable(False)
        drop.setFocusable(False)
        drop.setBackground(shape("#C62F435D", "#FF728A", radius=100))
        cross = TextView(ctx)
        cross.setText("×")
        cross.setTextSize(36)
        cross.setTextColor(Color.WHITE)
        cross.setGravity(Gravity.CENTER)
        drop.addView(cross, FrameLayout.LayoutParams(-1, -1))
        drop.setVisibility(View.GONE)
        self.container.addView(drop, FrameLayout.LayoutParams(dp(76), dp(76)))
        self.dismiss_target = drop
        self._apply_button_style()

    def _background_gradient(self, base, colors, stroke_color, stroke_width=1):
        """Layered Android gradient, not just a flat tint."""
        drawable = GradientDrawable()
        try:
            drawable.setOrientation(GradientDrawable.Orientation.TL_BR)
            drawable.setColors(jarray(jint)(list(colors)))
        except Exception:
            drawable.setColor(jint(base))
        drawable.setCornerRadius(float(dp(120)))
        if stroke_color:
            drawable.setStroke(dp(stroke_width), stroke_color)
        return drawable

    def _clear_material_backdrops(self):
        # Bitmaps are ONLY held in memory for the visible menu, never written
        # to disk, added to diagnostics, uploaded, or shared.
        for image in self.small_backdrops.values():
            try:
                image.setImageDrawable(None)
                image.setRenderEffect(None)
                image.setVisibility(View.GONE)
            except Exception:
                pass
        self._blur_backdrop_bitmaps.clear()

    def _refresh_material_backdrops(self):
        """Sample the underlying UI ONCE for all four glass buttons.

        Previous versions drew the entire Activity decor four times for one
        expansion. A downscaled full-screen snapshot is enough for a blurred
        glass material; per-button samples are cropped from the same frame.
        If crop or downscale fails on an OEM Android build, fall back to the
        previously working per-button capture rather than hiding buttons.
        """
        style = config_int(self.get_setting("button_style", 0), 0, 0, 6)
        if self.container is None or not self.expanded or style not in (0, 4):
            self._clear_material_backdrops()
            return
        decor = self.container.getParent()
        if decor is None: return
        was_visible = self.container.getVisibility()
        snapshot = None
        try:
            self.container.setVisibility(View.INVISIBLE)
            self._clear_material_backdrops()
            screen_w, screen_h = int(decor.getWidth()), int(decor.getHeight())
            scale = 0.5 if style == 0 else 0.75
            if screen_w > 0 and screen_h > 0:
                sw = max(1, int(screen_w * scale))
                sh = max(1, int(screen_h * scale))
                snapshot = Bitmap.createBitmap(sw, sh, Bitmap.Config.ARGB_8888)
                frame = Canvas(snapshot)
                frame.scale(float(scale), float(scale))
                decor.draw(frame)
                self._blur_backdrop_bitmaps.append(snapshot)
            for name, button in self.small.items():
                img = self.small_backdrops.get(name)
                if img is None: continue
                params = button.getLayoutParams()
                if params is None: continue
                side = max(1, int(dp(self._sizes()[1])))
                crop = None
                if snapshot is not None:
                    sx = max(0, min(sw-1, int(params.leftMargin*scale)))
                    sy = max(0, min(sh-1, int(params.topMargin*scale)))
                    cw = min(sw-sx, max(1, int(side*scale)))
                    ch = min(sh-sy, max(1, int(side*scale)))
                    if cw > 0 and ch > 0:
                        try:
                            crop = Bitmap.createBitmap(snapshot, sx, sy, cw, ch)
                        except Exception as exc:
                            self._failure("material_crop", exc)
                if crop is None:
                    # Compatibility fallback: older Android/Java wrapper.
                    crop = Bitmap.createBitmap(side, side, Bitmap.Config.ARGB_8888)
                    canvas = Canvas(crop)
                    canvas.translate(float(-params.leftMargin),float(-params.topMargin))
                    decor.draw(canvas)
                img.setImageBitmap(crop)
                img.setScaleType(ImageView.ScaleType.CENTER_CROP)
                img.setScaleX(1.035 if style == 4 else 1.0)
                img.setScaleY(1.035 if style == 4 else 1.0)
                img.setVisibility(View.VISIBLE)
                if int(Build.VERSION.SDK_INT) >= 31:
                    fog=config_int(self.get_setting("glass_blur", "15"),15,0,30)
                    blur=max(0.1,dp(max(1,fog))*(0.7 if style==0 else 0.15))
                    img.setRenderEffect(RenderEffect.createBlurEffect(
                        float(blur),float(blur),Shader.TileMode.CLAMP))
                self._blur_backdrop_bitmaps.append(crop)
            self._record("material_backdrop", style=str(style),
                         result="sampled", count=len(self._blur_backdrop_bitmaps))
        except Exception as exc:
            self._failure("material_backdrop", exc)
            self._clear_material_backdrops()
        finally:
            try: self.container.setVisibility(was_visible)
            except Exception: pass

    def _apply_button_style(self):
        """Physically distinct glass, gel and embossed materials.

        True backdrop blur is rendered from short-lived in-memory host
        snapshots at expansion; old Android/SDK interfaces fall back to
        multi-stop lighting gradients, never to icon-blurring RenderEffect.
        """
        if not self.small:
            return
        style = config_int(self.get_setting("button_style", 0), 0, 0, 6)
        opacity = config_int(self.get_setting("button_opacity", "75"), 75, 20, 100)
        stroke_pct = config_int(self.get_setting("outline_strength", "55"), 55, 0, 100)
        outline = bool(self.get_setting("blue_outline", True))
        a = int(255 * opacity / 100)
        def c(alpha, rgb):
            return Color.argb(clamp(int(alpha), 0, 255), *rgb)
        # Four types are not mere color swaps: each uses a distinct lighting
        # ramp, opacity, silhouette and press depth, plus optional backdrop.
        if style == 0:  # Frosted background capture + restrained diffusion
            colors = [c(a*.61, (201,219,244)), c(a*.42,(74,96,127)), c(a*.51,(37,55,82))]
            edge = c(145, (227,240,255)); elev = 5
        elif style == 1:  # Translucent, with almost no shading
            colors = [c(a*.50,(69,106,147)),c(a*.34,(39,67,110))]
            edge = c(80,(154,198,255)); elev = 2
        elif style == 2:  # Nonreflective matte
            colors = [c(255,(65,70,78)),c(255,(43,48,57))]
            edge = c(85,(135,147,161)); elev = 2
        elif style == 3:  # Original blue glow
            colors = [c(a*.78,(61,125,200)),c(a*.85,(15,42,83))]
            edge = c(240,(102,181,255)); elev = 8
        elif style == 4:  # Liquid lens with directional edge reflections
            colors = [c(a*.54,(235,247,255)),c(a*.18,(98,144,190)),c(a*.44,(20,40,73))]
            edge = c(218,(235,249,255)); elev = 9
        elif style == 5:  # Gel: high specular shoulder + dark thick base
            colors = [c(a*.91,(239,250,255)),c(a*.55,(109,166,217)),c(a*.97,(20,48,91))]
            edge = c(210,(218,245,255)); elev = 11
        else:           # Skeuomorphic: hard bezel, deep shadow
            colors = [c(255,(181,196,210)),c(255,(77,92,113)),c(255,(21,32,50))]
            edge = c(220,(208,222,235)); elev = 12
        if not outline:
            edge = c(80, (224,233,248)) if style in (4,5,6) else 0
        else:
            # Preserve material-specific white rim rather than turning every
            # material into the same saturated blue stroke.
            if style in (1,2,3):
                edge = c(max(50,int(stroke_pct*2.35)), (118,183,249))
        self._stop_material_dynamics()
        self._material_bitmaps = []
        bitmap = None
        if style in (0, 4, 5, 6):
            try:
                bitmap = render_material_bitmap(style, dp(self._sizes()[1]), opacity)
                self._material_bitmaps.append(bitmap)
            except Exception as exc:
                self._failure("material_render", exc)
        for name, button in self.small.items():
            try:
                # Retain a circular outline for Android clipping and elevation,
                # but let the bitmap/material layers be visible above backdrop.
                if bitmap is not None:
                    button.setBackground(self._background_gradient(
                        Color.TRANSPARENT, [Color.TRANSPARENT,Color.TRANSPARENT],
                        edge, 2 if style in (4,5,6) else 1))
                else:
                    button.setBackground(self._background_gradient(
                        colors[-1], colors, edge, 2 if style == 3 else 1))
                button.setElevation(float(dp(elev)))
                material = self.small_materials.get(name)
                if material is not None:
                    material.setImageBitmap(bitmap) if bitmap is not None else material.setImageDrawable(None)
                    material.setVisibility(View.VISIBLE if bitmap is not None else View.GONE)
                gloss = self.small_sheens.get(name)
                if gloss is not None:
                    if style in (0,4,5,6):
                        # A separate specular overlay reinforces volume.
                        sh = GradientDrawable()
                        sh.setOrientation(GradientDrawable.Orientation.TOP_BOTTOM)
                        sh.setColors(jarray(jint)([
                            c(165 if style==5 else 54 if style==0 else 120,(255,255,255)),
                            c(5,(255,255,255)),c(0,(255,255,255))]))
                        sh.setCornerRadius(float(dp(120)))
                        gloss.setBackground(sh)
                        # Material bitmap already owns its specular highlights;
                        # avoid tint-like white overlay making all styles alike.
                        gloss.setAlpha(.08 if style==0 else .05 if style==4 else .13 if style==5 else .04)
                        gloss.setVisibility(View.VISIBLE)
                    else:
                        gloss.setVisibility(View.GONE)
                backdrop = self.small_backdrops.get(name)
                if backdrop is not None and style not in (0,4):
                    backdrop.setVisibility(View.GONE)
            except Exception as exc:
                self._failure("button_material", exc)
        self._record("button_style_applied", style=str(style),
                     result="layered_material" if bitmap is not None else "legacy_gradient")
        if style in (0,4,5,6):
            self._record("material_render", style=str(style),
                         result="ok" if bitmap is not None else "fallback")
        if self.expanded:
            self._start_material_dynamics()

    def _satellite_touch(self, view, event, name):
        """Touchable physical characteristics differ per material; no click intercept."""
        level=config_int(self.get_setting("material_motion",1),1,0,3)
        if level==0:return False
        try:
            action=event.getActionMasked()
            style=config_int(self.get_setting("button_style",0),0,0,6)
            if action == MotionEvent.ACTION_DOWN:
                view.animate().cancel()
                factor=(.025,.045,.075)[level-1]
                if style==5:  # squish wide/short rather than uniform scale
                    view.animate().scaleX(1.+factor*.9).scaleY(1.-factor*1.55).setDuration(105).start()
                elif style==6:  # rigid physical key sinks, doesn't jelly
                    view.animate().scaleX(1.-factor*.30).scaleY(1.-factor*.30).setDuration(65).start()
                elif style==4:
                    view.animate().scaleX(1.-factor*.55).scaleY(1.-factor*.55).setDuration(120).start()
                elif style==0:  # frosted glass very light feedback
                    view.animate().scaleX(1.-factor*.25).scaleY(1.-factor*.25).setDuration(125).start()
                else:
                    view.animate().scaleX(1.-factor).scaleY(1.-factor).setDuration(85).start()
            elif action in (MotionEvent.ACTION_UP,MotionEvent.ACTION_CANCEL):
                elastic=1.5 if style==5 else .45 if style==6 else .90
                view.animate().scaleX(1.).scaleY(1.).setDuration(225 if style==5 else 160).setInterpolator(
                    OvershootInterpolator(elastic)).start()
        except Exception as exc:
            self._failure("material_press",exc)
        return False

    def _stop_material_dynamics(self):
        for animation in getattr(self, "_material_animators", []):
            try: animation.cancel()
            except Exception: pass
        self._material_animators = []

    def _start_material_dynamics(self):
        self._stop_material_dynamics()
        level = config_int(self.get_setting("material_motion",1),1,0,3)
        style = config_int(self.get_setting("button_style",0),0,0,6)
        if not self.expanded or level == 0 or style not in (0,4,5):
            return
        for n, sheen in self.small_sheens.items():
            if sheen.getVisibility() != View.VISIBLE:
                continue
            base = (.10, .11, .13)[level-1]
            top = (.18, .23, .31)[level-1]
            try:
                a = ObjectAnimator.ofFloat(sheen, "alpha", float(base), float(top))
                a.setDuration(2400 + BUTTON_KEYS.index(n)*250)
                a.setRepeatCount(ValueAnimator.INFINITE)
                a.setRepeatMode(ValueAnimator.REVERSE)
                a.setInterpolator(LinearInterpolator())
                a.start()
                self._material_animators.append(a)
            except Exception as exc:
                self._failure("material_motion", exc)

    def _spectrum_config(self):
        return (config_int(self.get_setting("spectrum_mode",0),0,0,2),
                config_int(self.get_setting("spectrum_style",0),0,0,2),
                config_int(self.get_setting("spectrum_speed",1),1,0,2),
                config_int(self.get_setting("spectrum_strength",1),1,0,2),
                config_int(self.get_setting("spectrum_color",0),0,0,2))

    def _spectrum_rgb(self, color_choice):
        if color_choice != 2: return self._glow_rgb()
        try:
            if self.cover is not None:
                bitmap=self.cover.getImageReceiver().getBitmap()
                if bitmap is not None:
                    pixel=bitmap.getPixel(int(bitmap.getWidth()*.5),int(bitmap.getHeight()*.5))
                    return tuple(int(clamp(.55*x+112,112,250)) for x in
                                 (Color.red(pixel),Color.green(pixel),Color.blue(pixel)))
        except Exception:
            pass
        return (105,181,255)

    def _stop_spectrum(self):
        if (getattr(self, "_fft_visualizer", None) is not None or
                getattr(self, "_fft_native_hook", None) is not None or
                getattr(self, "_fft_analytics_hook", None) is not None):
            self._fft_release("stopped")
        self._spectrum_generation += 1
        self._spectrum_active = False
        self._spectrum_live_bitmap = None
        self._spectrum_smoothed = None
        self._spectrum_next_capture_at = 0.0
        if self.spectrum is not None:
            self.spectrum.setVisibility(View.GONE)
            self.spectrum.setImageDrawable(None)

    def _spectrum_visible(self):
        return (not self.backgrounded and self.container is not None
                and self.container.getVisibility() == View.VISIBLE)

    def _update_spectrum(self, paused):
        if paused and getattr(self, "_fft_visualizer", None) is not None:
            self._fft_release("paused")
        mode,style,speed,strength,color=self._spectrum_config()
        allowed=(self._spectrum_visible() and mode != 0 and self.glow_host is not None
                 and self.spectrum is not None and
                 (self._real_audio_present or
                  (self._light_fade_cleanup_pending and self._light_envelope > .001)) and
                 (not paused or self._light_envelope > .001))
        if not allowed:
            if self._spectrum_active:
                self._stop_spectrum()
            elif self.spectrum is not None:
                self.spectrum.setVisibility(View.GONE)
            return
        if not self._spectrum_active:
            self._spectrum_active=True
            self._spectrum_generation+=1
            self._spectrum_frame=0
            generation=self._spectrum_generation
            self._record("spectrum_motion",result="started",mode=str(mode),style=str(style))
            self._spectrum_tick(generation)
        else:
            self.spectrum.setVisibility(View.VISIBLE)

    def _spectrum_tick(self, generation):
        self._diagnostic_sample("spectrum_frame", status=getattr(self,"_fft_status","waiting"), available=bool(getattr(self,"_spectrum_active",False)))
        if (generation != self._spectrum_generation or not self._spectrum_active or
                not self.alive or self.spectrum is None or self.container is None):
            return
        if not self._spectrum_visible():
            self._diagnostic_sample("spectrum_callback", result="skipped", reason="hidden")
            self._stop_spectrum()
            return
        try:
            mode,style,speed,strength,color=self._spectrum_config()
            if (mode == 0 or self._glow_state is None or
                    (not self._real_audio_present and not self._light_fade_cleanup_pending) or
                    (self._glow_state[1] and self._light_envelope <= .001)):
                self._stop_spectrum()
                return
            ball = self._sizes()[0]
            glow_col=7 if mode==2 else config_int(self.get_setting("glow_color",0),0,0,len(GLOW_COLORS)-1)
            rgb=self._spectrum_rgb(color)
            palette=spectrum_palette(1 if mode==2 else color,glow_col,rgb)
            flow_speed=config_int(self.get_setting("glow_flow_speed",1),1,0,2)
            colorful=(mode==2 or color==1 or (color==0 and glow_col>=3))
            phase=(time.monotonic()/(12.0,8.0,5.0)[flow_speed])%1.0 if colorful else 0.0
            bands=self._spectrum_band_count()
            key=(ball,style,speed,strength,color,glow_col,tuple(rgb),bands)
            if key!=self._spectrum_cache_key:
                self._spectrum_cache_key=key
                self._spectrum_frames.clear()
                self._spectrum_live_bitmap = None
                self._spectrum_smoothed = None
            # Preserve A's chosen motion speed at 60 FPS rather than making
            # the simulated wave six times faster.
            frame_idx=int(time.monotonic()*1000//(165,115,85)[speed])%24
            brightness=float(clamp(self._light_envelope,0.0,1.0))
            real_levels = None
            if config_int(self.get_setting("spectrum_source", 0), 0, 0, 1) == 1:
                if self._real_audio_present and not bool(self._glow_state[1]):
                    if (time.monotonic() >= self._spectrum_next_capture_at or
                            getattr(self, "_real_fft_levels", None) is None):
                        real_levels = self._fft_levels(speed, strength)
                        self._spectrum_next_capture_at = time.monotonic() + 1.0/30.0
                    else:
                        real_levels = getattr(self, "_real_fft_levels", None)
                    if (real_levels is None and getattr(self, "_fft_status", None) in
                            ("paused", "no_audio", "hidden", "background", "disabled", "stopped")):
                        # The real controller can stop before the slower UI
                        # snapshot observes it. Freeze B instead of flashing A.
                        real_levels = getattr(self, "_real_fft_levels", None)
                        if real_levels is None:
                            real_levels = [0.0] * bands
                else:
                    # Fade the last measured frame without sampling a paused
                    # or missing player, and never flash back to simulated A.
                    real_levels = getattr(self, "_real_fft_levels", None)
                    if real_levels is None:
                        real_levels = [0.0] * bands
            # During fade, shorten EACH bar rather than uniformly shrinking
            # the entire ring. Live FFT frames never enter the A frame cache.
            if real_levels is not None:
                if len(real_levels) != bands:
                    real_levels = [0.0] * bands
                prev = self._spectrum_smoothed
                if prev is None or len(prev) != bands:
                    smoothed = list(real_levels)
                else:
                    smoothed = [a + (b-a) * (0.36 if b > a else 0.24)
                                for a,b in zip(prev, real_levels)]
                self._spectrum_smoothed = smoothed
                bitmap=render_spectrum_bitmap(dp(ball+36),dp(18),smoothed,
                    style,strength,palette,envelope=brightness,real_data=True,
                    reusable=self._spectrum_live_bitmap,color_phase=phase)
                self._spectrum_live_bitmap=bitmap
            elif colorful:
                bitmap=render_spectrum_bitmap(dp(ball+36),dp(18),
                    spectrum_levels(frame_idx,bands,speed,strength),style,strength,palette,
                    envelope=brightness,reusable=self._spectrum_live_bitmap,color_phase=phase)
                self._spectrum_live_bitmap=bitmap
            elif brightness >= .999:
                if frame_idx not in self._spectrum_frames:
                    self._spectrum_frames[frame_idx]=render_spectrum_bitmap(
                        dp(ball+36),dp(18),spectrum_levels(frame_idx,bands,speed,strength),
                        style,strength,palette)
                bitmap=self._spectrum_frames[frame_idx]
            else:
                bitmap=render_spectrum_bitmap(dp(ball+36),dp(18),
                    spectrum_levels(frame_idx,bands,speed,strength),style,strength,palette,
                    envelope=brightness)
            self.spectrum.setImageBitmap(bitmap)
            self.spectrum.invalidate()  # necessary when reusing the same Bitmap
            self.spectrum.setVisibility(View.VISIBLE)
            self._spectrum_frame+=1
        except Exception as exc:
            self._failure("spectrum_render",exc)
            self._stop_spectrum()
            return
        # Visual animation only. Separate from the 850ms media refresh and
        # from glow_host XY animation. Only A's 24 base frames are reused.
        if self._spectrum_active and generation==self._spectrum_generation:
            target_ms = 16 if config_int(self.get_setting("spectrum_refresh_rate", 1),1,0,1) else 33
            run_on_ui_thread(lambda gen=generation:self._spectrum_tick(gen), target_ms)

    def _glow_rgb(self):
        option = config_int(self.get_setting("glow_color", 0), 0, 0, len(GLOW_COLORS)-1)
        if option == 1:
            return (241, 248, 255)
        if option == 2 and self.cover is not None:
            try:
                artwork = self.cover.getImageReceiver().getBitmap()
                if artwork is not None:
                    x, y = int(artwork.getWidth()/2), int(artwork.getHeight()/2)
                    pixel = artwork.getPixel(x,y)
                    # Lift very dark album pixels, without leaking artwork to disk.
                    return tuple(int(clamp(.55*component + 112, 112, 250)) for component in
                                 (Color.red(pixel), Color.green(pixel), Color.blue(pixel)))
            except Exception:
                pass
        return (105, 181, 255)

    def _render_glow(self):
        if self.glow is None or self.container is None:
            return
        ball = self._sizes()[0]
        margin = 18
        color_setting = config_int(self.get_setting("glow_color", 0), 0, 0, len(GLOW_COLORS)-1)
        spectrum_mode=self._spectrum_config()[0]
        if spectrum_mode == 2: color_setting = 7
        style = config_int(self.get_setting("glow_style",0),0,0,2)
        key = (ball, color_setting, self.last_cover_key if color_setting == 2 else None, style)
        if key == self._glow_bitmap_key:
            return
        if self._glow_last_failure_time and time.monotonic()-self._glow_last_failure_time < 5.0:
            return
        try:
            color_mode = color_setting
            rgb = self._glow_rgb()
            self._glow_bitmap = render_glow_bitmap(dp(ball + 2*margin), dp(margin), rgb,
                                                     glow_palette(color_mode, rgb))
            self.glow.setImageBitmap(self._glow_bitmap)
            self.glow_flash.setImageBitmap(self._glow_bitmap)
            self._glow_bitmap_key = key
            self._glow_last_failure_time = 0.0
            self._record("glow_render", result="ok", glow_mode=str(self.get_setting("glow_mode",1)),
                         bitmap_w_px=int(self._glow_bitmap.getWidth()), bitmap_h_px=int(self._glow_bitmap.getHeight()))
        except Exception as exc:
            self._glow_bitmap_key = None
            self._glow_last_failure_time = time.monotonic()
            self._failure("glow_render", exc)
            self.glow.setVisibility(View.GONE)
            self.glow_flash.setVisibility(View.GONE)

    def _stop_color_flow(self):
        self._wave_generation = getattr(self,"_wave_generation",0)+1
        self._wave_active = False
        if self._glow_color_animator is not None:
            try: self._glow_color_animator.cancel()
            except Exception: pass
            self._glow_color_animator = None
        self._glow_flow_speed_applied = None
        if self.glow is not None:
            self.glow.setRotation(0.0)

    def _sync_color_flow(self, paused):
        """Rotate colored image child, never the moving glow_host parent.

        This preserves the proven v0.8.4 ghost-ring fix: the parent's
        translation and the child's alpha/rotation are independent.
        """
        option = config_int(self.get_setting("glow_color",0),0,0,len(GLOW_COLORS)-1)
        spectrum_mode=self._spectrum_config()[0]
        mode = config_int(self.get_setting("glow_mode",1),1,0,3)
        if spectrum_mode == 2:
            option,mode=7,max(1,mode)
        elif spectrum_mode == 1:
            mode=0
        style = 0 if spectrum_mode else config_int(self.get_setting("glow_style",0),0,0,2)
        if style and mode != 0 and not paused:
            if self._glow_color_animator is not None:
                self._stop_color_flow()
            if not getattr(self,"_wave_active",False):
                self._wave_active = True
                self._wave_generation = getattr(self,"_wave_generation",0)+1
                self._wave_tick(self._wave_generation)
            return
        if getattr(self,"_wave_active",False): self._stop_color_flow()
        should_flow = option >= 3 and mode != 0 and not paused
        if not should_flow:
            self._stop_color_flow()
            return
        speed = config_int(self.get_setting("glow_flow_speed",1),1,0,2)
        if self._glow_color_animator is not None:
            if self._glow_flow_speed_applied == speed:
                return
            self._stop_color_flow()
        try:
            durations = (12000,8000,5000)
            a = ObjectAnimator.ofFloat(self.glow,"rotation",0.0,360.0)
            a.setDuration(durations[speed])
            a.setInterpolator(LinearInterpolator())
            a.setRepeatCount(ValueAnimator.INFINITE)
            a.start()
            self._glow_color_animator=a
            self._glow_flow_speed_applied=speed
            self._record("glow_color_flow",result="started",mode=str(option),duration_ms=durations[speed])
        except Exception as exc:
            self._failure("glow_color_flow",exc)
            self._stop_color_flow()

    def _light_duration(self, going_on):
        setting = config_int(self.get_setting("light_transition",2),2,0,3)
        if setting == 0: return 0
        return ((220,320), (400,700), (850,1150))[setting-1][0 if going_on else 1]

    def _apply_light_envelope(self):
        level = float(clamp(self._light_envelope,0.0,1.0))
        if self.light_host is not None:
            self.light_host.setAlpha(level)
            self.light_host.setVisibility(View.VISIBLE if level > .001 else View.GONE)
        if self.glow_host is not None:
            progress = self.progress_ring is not None and self.progress_ring.getVisibility() == View.VISIBLE
            self.glow_host.setVisibility(View.VISIBLE if level > .001 or progress else View.GONE)

    def _set_light_target(self, on):
        """One shared playback-state envelope for every glow and spectrum.

        The glow_host still owns XY motion, light_host owns playback fade,
        and individual children own breathing, RGB rotation and flash.
        Pausing during fade-in reverses smoothly from the current brightness.
        """
        target = 1.0 if on else 0.0
        if getattr(self,"_resume_immediate",False):
            self._light_transition_generation += 1
            self._light_target = target
            self._light_envelope = target
            self._apply_light_envelope()
            return
        if target == self._light_target:
            return
        self._light_target = target
        self._light_transition_generation += 1
        generation = self._light_transition_generation
        start = float(self._light_envelope)
        duration = self._light_duration(bool(on))
        if duration <= 0 or abs(start-target) < .001:
            self._light_envelope=target
            self._apply_light_envelope()
            self._finish_light_transition(generation)
            return
        start_mono=time.monotonic()
        self._record("light_transition",result="started",status="on" if on else "off",
                     duration_ms=duration)
        def step():
            if generation != self._light_transition_generation or not self.alive:
                return
            fraction=clamp((time.monotonic()-start_mono)*1000.0/duration,0.0,1.0)
            eased=fraction*fraction*(3.0-2.0*fraction)
            self._light_envelope=start+(target-start)*eased
            self._apply_light_envelope()
            if fraction < 1.0:
                run_on_ui_thread(step,40)
            else:
                self._light_envelope=target
                self._apply_light_envelope()
                self._finish_light_transition(generation)
        run_on_ui_thread(step,40)

    def _finish_light_transition(self, generation):
        if generation != self._light_transition_generation: return
        if self._light_target > 0: return
        self._stop_color_flow()
        self._stop_spectrum()
        self._clear_flash_glow()
        if self._glow_animator is not None:
            try: self._glow_animator.cancel()
            except Exception: pass
            self._glow_animator=None
        if self.glow is not None:
            self.glow.setVisibility(View.GONE)
        self._apply_light_envelope()
        self._record("light_transition",result="completed",status="off")
        if self._light_fade_cleanup_pending and self.container is not None:
            # Do not remove the overlay if a new song began during fade-out.
            if (self._playing_message() is None and
                    time.monotonic() >= getattr(self, "_settings_preview_until", 0.0)):
                self._remove_overlay()
            self._light_fade_cleanup_pending = False

    def _update_glow(self, paused=None, force=False):
        if self.glow is None or self.container is None: return
        mode=config_int(self.get_setting("glow_mode",1),1,0,3)
        spectrum_mode=self._spectrum_config()[0]
        if paused is None: paused=bool(self.last_paused)
        paused=bool(paused) or not bool(self._real_audio_present)
        self._glow_current_paused=paused
        strength=config_int(self.get_setting("glow_strength",0),0,0,2)
        color=config_int(self.get_setting("glow_color",0),0,0,len(GLOW_COLORS)-1)
        speed=config_int(self.get_setting("glow_flow_speed",1),1,0,2)
        ring_on=(mode!=0 and spectrum_mode!=1) or spectrum_mode==2
        any_light=ring_on or spectrum_mode!=0
        self._set_light_target(bool(any_light and not paused))
        ring_visible=(self.progress_ring is not None and
                      self.progress_ring.getVisibility()==View.VISIBLE)
        state=(mode,paused,bool(self.expanded),strength,color,speed,spectrum_mode,ring_visible,self.get_setting("glow_style",0))
        if not force and state==self._glow_state:
            if ring_on and not paused: self._sync_color_flow(False)
            self._update_spectrum(paused)
            return
        self._diagnostic_sample("glow_state", paused=paused, style=str(self.get_setting("glow_style",0)), glow_mode=mode, mode=str(spectrum_mode))
        self._glow_state=state
        self._update_spectrum(paused)
        if self._glow_animator is not None:
            try: self._glow_animator.cancel()
            except Exception: pass
            self._glow_animator=None
        if ring_on and (not paused or self._light_envelope > .001):
            # Remain drawn until the common envelope reaches zero; never
            # hard-hide the light at the instant pause is detected.
            self.glow.setVisibility(View.VISIBLE)
            self._sync_color_flow(paused and self._light_envelope <= .001)
            base=(.28,.52,.82)[strength]*(0.48 if not self.expanded else 1.0)
            effective_mode=1 if spectrum_mode==2 and mode==0 else mode
            if effective_mode in (1,3):
                low=base*(.66 if effective_mode==1 else .52)
                high=base*(1.0 if effective_mode==1 else 1.13)
                try:
                    a=ObjectAnimator.ofFloat(self.glow,"alpha",float(low),float(min(.95,high)))
                    a.setDuration(3200 if effective_mode==1 else 1850)
                    a.setRepeatCount(ValueAnimator.INFINITE)
                    a.setRepeatMode(ValueAnimator.REVERSE)
                    a.setInterpolator(LinearInterpolator())
                    a.start()
                    self._glow_animator=a
                except Exception as exc:
                    self._failure("glow_animation",exc)
                    self.glow.setAlpha(float(base))
            else:
                self.glow.setAlpha(float(base))
        else:
            self.glow.setVisibility(View.GONE)
            self._stop_color_flow()
        self._apply_light_envelope()
        self._record("glow_playback_gate",result="on" if not paused else "fade_out",paused=paused)

    def _clear_flash_glow(self):
        """Stop transient light without touching the moving host's XY animator."""
        if self._flash_animator is not None:
            try: self._flash_animator.cancel()
            except Exception as exc: self._failure("glow_flash_cancel", exc)
            self._flash_animator = None
        if self.glow_flash is not None:
            # All click flashes start from zero translation. Parent owns XY.
            self.glow_flash.setAlpha(0.0)

    def _flash_glow(self):
        if (self.glow_flash is None or self.glow_host is None or
                ((config_int(self.get_setting("glow_mode",1),1,0,3) == 0 and
                  self._spectrum_config()[0]!=2) or self._spectrum_config()[0]==1) or
                bool(self.last_paused) or not self._real_audio_present):
            return
        try:
            self._clear_flash_glow()
            self.glow_host.setVisibility(View.VISIBLE)
            self.glow_flash.setVisibility(View.VISIBLE)
            # Crucially: ObjectAnimator affects ONLY the child's alpha, while
            # ViewPropertyAnimator translates the shared parent. These two
            # animation channels cannot cancel each other's position.
            self.glow_flash.setAlpha(0.65)
            animator = ObjectAnimator.ofFloat(self.glow_flash, "alpha", 0.65, 0.0)
            animator.setDuration(300)
            animator.start()
            self._flash_animator = animator
            self._record("glow_flash", result="started", expanded=self.expanded)
        except Exception as exc:
            self._failure("glow_click_feedback", exc)
            self._clear_flash_glow()

    def _animation_kind(self):
        return config_int(self.get_setting("animation_style", 2), 2, 0, 6)

    def _animation_duration(self):
        return (160, 235, 340)[config_int(self.get_setting("animation_speed", 1), 1, 0, 2)]

    def _ball_motion_layers(self):
        """One and only one movable layer for the ball and all its effects."""
        return [self.motion_host] if self.motion_host is not None else []

    def _stop_visual_animations(self):
        self._animation_token += 1
        self._clear_flash_glow()
        self._cancel_jelly_wobble()
        # Cancel XY only on the common motion parent. Reset child-local
        # transforms separately (no child can retain a stale dock offset).
        for view in (self._ball_motion_layers() + [self.main, self.ripple,
                      self.time_text] + list(self.small.values())):
            if view is None: continue
            try:
                view.animate().cancel()
                view.setTranslationX(0.0)
                view.setTranslationY(0.0)
                view.setScaleX(1.0)
                view.setScaleY(1.0)
                view.setRotation(0.0)
                view.setAlpha(1.0)
            except Exception as exc:
                self._failure("animation_cancel", exc)
        self._closing_menu = False
        if self.ripple is not None:
            self.ripple.setVisibility(View.GONE)
        return self._animation_token

    def _motion_debug(self, stage, result, duration=0):
        """Only numeric, privacy-safe diagnostics at animation boundaries."""
        if self.motion_host is None: return
        try:
            self._record("ball_layers_motion", stage=stage, result=result,
                         count=1, duration_ms=int(duration),
                         x_px=int(self.motion_host.getTranslationX()),
                         y_px=int(self.motion_host.getTranslationY()))
        except Exception:
            pass

    @diagnostic_operation
    def _expand_menu(self):
        if self.container is None or self.main is None or self.expanded or self._closing_menu:
            return
        token = self._stop_visual_animations()
        ox, oy = float(self.center_x or 0), float(self.center_y or 0)
        self.expanded = True
        self.is_snapped = True
        self.last_interaction = time.monotonic()
        kind = self._animation_kind()
        dur = self._animation_duration() if kind else 0
        # A touch that opens the menu can NEVER play/pause. Delay the next
        # playback action until its own subsequent DOWN after animation ends.
        final_stagger = (280 if kind == 4 else 115 if kind == 3 else 65 if kind == 6 else 36)
        self._menu_ready_at = time.monotonic() + (dur + final_stagger + 85)/1000.0
        self._relayout()
        self._refresh_material_backdrops()
        self._update_glow(force=True)
        self._record("menu_toggled", expanded=True, style=str(kind),
                     gesture_seq=self._main_gesture_seq)
        if kind == 0:
            self._start_material_dynamics()
            return
        try:
            dx, dy = ox - float(self.center_x or 0), oy - float(self.center_y or 0)
            host = self.motion_host
            host.setTranslationX(float(dx))
            host.setTranslationY(float(dy))
            host.animate().translationX(0.0).translationY(0.0).setDuration(
                dur).setInterpolator(DecelerateInterpolator()).start()
            # Jelly squash is CHILD-LOCAL. Its interpolator cannot move the
            # main disc ahead of the glow, progress ring or click target.
            if kind == 6:
                self.main.setScaleX(.94)
                self.main.setScaleY(.94)
                self.main.animate().scaleX(1.0).scaleY(1.0).setDuration(
                    dur).setInterpolator(OvershootInterpolator(1.05)).start()
            self._animate_progress_arc(dur)
            self._motion_debug("expand", "started", dur)
            run_on_ui_thread(lambda t=token:self._complete_expand_motion(t), dur+35)
            for n, button in self.small.items():
                p = button.getLayoutParams()
                bx = p.leftMargin + dp(self._sizes()[1]) / 2.0
                by = p.topMargin + dp(self._sizes()[1]) / 2.0
                index = BUTTON_KEYS.index(n)
                button.setVisibility(View.VISIBLE)
                dx, dy = ox - bx, oy - by
                start_scale = .68
                start_rot = 0.
                start_alpha = 0.
                stagger = index * 18
                interp = DecelerateInterpolator()
                if kind == 3:            # Fan spin, visible curved rotation
                    start_rot = (-87 if self.right_edge else 87) + index * 18
                    stagger = index * 28
                    start_scale = .70
                elif kind == 4:          # Cascading: pronounced individual steps
                    stagger = index * 85
                    start_scale = .42
                    interp = OvershootInterpolator(1.1)
                elif kind == 5:          # Soft fade, almost stationary
                    dx, dy = dx*.08, dy*.08
                    start_scale = .97
                    stagger = index * 12
                elif kind == 6:          # Jelly: staged secondary wobble after landing
                    start_scale = .54
                    interp = OvershootInterpolator(1.18)
                button.setTranslationX(float(dx))
                button.setTranslationY(float(dy))
                button.setRotation(float(start_rot))
                button.setAlpha(float(start_alpha))
                button.setScaleX(float(start_scale*(.84 if kind == 6 else 1.0)))
                button.setScaleY(float(start_scale*(1.16 if kind == 6 else 1.0)))
                button.animate().translationX(0.0).translationY(0.0).rotation(0.0).alpha(1.0).scaleX(1.0).scaleY(1.0).setStartDelay(stagger).setDuration(dur).setInterpolator(interp).start()
            if kind == 6:
                run_on_ui_thread(lambda: self._jelly_wobble_if(token), dur + final_stagger)
            if kind == 2 and self.ripple is not None:
                self.ripple.setVisibility(View.VISIBLE)
                self.ripple.setAlpha(.65)
                self.ripple.setScaleX(.65)
                self.ripple.setScaleY(.65)
                # Ripple shares the parent XY. Its animator only affects alpha/scale.
                self.ripple.animate().alpha(0.0).scaleX(2.1).scaleY(2.1).setDuration(dur).start()
                run_on_ui_thread(lambda: self._hide_ripple_if(token), dur + 25)
            # Material idle motion should not fight with expansion motion.
            run_on_ui_thread(lambda: self._start_material_dynamics_if(token), dur + final_stagger + 75)
            self._record("animation_started", style=str(kind), duration_ms=dur, result="expand")
        except Exception as exc:
            self._failure("animate_expand", exc)
            self._stop_visual_animations()
            self._relayout()

    def _complete_expand_motion(self, token):
        if token != self._animation_token or self.motion_host is None:
            return
        # Diagnostics only: do not cancel an animator to force a final frame.
        self._motion_debug("expand", "finished", self._animation_duration())

    def _jelly_wobble_if(self, token):
        if token != self._animation_token or not self.expanded or self._closing_menu:
            return
        self._cancel_jelly_wobble()
        try:
            for index,name in enumerate(BUTTON_KEYS):
                v=self.small.get(name)
                if v is None:continue
                # Nonuniform delayed deformation: distinct from generic bounce.
                x=ObjectAnimator.ofFloat(v,"scaleX",1.0,1.14,.91,1.05,1.0)
                y=ObjectAnimator.ofFloat(v,"scaleY",1.0,.86,1.11,.96,1.0)
                for a in (x,y):
                    a.setDuration(390+index*22)
                    a.setInterpolator(DecelerateInterpolator())
                    a.start()
                    self._jelly_animators.append(a)
            self._record("jelly_wobble",result="started",count=len(self._jelly_animators))
        except Exception as exc:
            self._failure("jelly_wobble",exc)

    def _cancel_jelly_wobble(self):
        for a in self._jelly_animators:
            try:a.cancel()
            except Exception:pass
        self._jelly_animators=[]

    def _start_material_dynamics_if(self, token):
        if token == self._animation_token and self.expanded:
            self._start_material_dynamics()

    def _hide_ripple_if(self, token):
        if token == self._animation_token and self.ripple is not None:
            self.ripple.setVisibility(View.GONE)

    @diagnostic_operation
    def _animate_collapse(self, reason, target_x, target_y):
        token = self._stop_visual_animations()
        kind = self._animation_kind()
        if kind == 0:
            self._finish_collapse(token, reason)
            return
        dur = max(120, int(self._animation_duration() * .78))
        self._closing_menu = True
        self._menu_ready_at = time.monotonic() + (dur+90)/1000.0
        self._stop_material_dynamics()
        try:
            old_x, old_y = float(self.center_x or 0), float(self.center_y or 0)
            dx, dy = float(target_x-old_x), float(target_y-old_y)
            self.motion_host.animate().translationX(dx).translationY(dy).setDuration(
                dur).setInterpolator(DecelerateInterpolator()).start()
            if self.time_text is not None and self.get_setting("hide_time_snapped", True):
                self.time_text.animate().alpha(0.0).setDuration(dur).start()
            self._animate_progress_arc(dur+65)
            self._motion_debug("collapse", "started", dur)
            for n, button in self.small.items():
                p = button.getLayoutParams()
                bx = p.leftMargin + dp(self._sizes()[1]) / 2.0
                by = p.topMargin + dp(self._sizes()[1]) / 2.0
                button.setVisibility(View.VISIBLE)
                index = BUTTON_KEYS.index(n)
                dx,dy = old_x - bx, old_y - by
                if kind == 5:
                    dx,dy = dx*.08, dy*.08
                button.animate().translationX(float(dx)).translationY(float(dy)).rotation(
                    (-84 if self.right_edge else 84) if kind == 3 else 0
                ).alpha(0.0).scaleX(.48 if kind in (4,6) else .80).scaleY(.62 if kind == 6 else .80).setStartDelay(
                    (3-index)*30 if kind == 4 else 0).setDuration(max(105,dur - (40 if kind==4 else 0))).start()
            self._record("animation_started", style=str(kind), result="collapse", duration_ms=dur)
            run_on_ui_thread(lambda: self._finish_collapse(token, reason), dur + 65)
        except Exception as exc:
            self._failure("animate_collapse", exc)
            self._finish_collapse(token, reason)

    @diagnostic_operation
    def _finish_collapse(self, token, reason):
        if token != self._animation_token or self.container is None:
            return
        self._motion_debug("collapse", "finished")
        self._clear_material_backdrops()
        self._stop_visual_animations()
        self._relayout()
        self._motion_debug("collapse", "aligned")
        self._commit_snap(reason)
        self._update_glow(force=True)

    def _place(self, view, width_dp, height_dp, cx, cy):
        if view is None: return
        width, height = dp(width_dp), dp(height_dp)
        x, y = int(round(cx - width / 2)), int(round(cy - height / 2))
        old = view.getLayoutParams()
        if (old is not None and old.width == width and old.height == height and
                old.leftMargin == x and old.topMargin == y):
            return
        p = FrameLayout.LayoutParams(width, height, Gravity.LEFT | Gravity.TOP)
        p.leftMargin, p.topMargin = x, y
        view.setLayoutParams(p)

    def _sizes(self):
        ball = config_int(self.get_setting("ball_size", "58"), 58, 40, 86)
        button = config_int(self.get_setting("button_size", "40"), 40, 32, 56)
        radius = config_int(self.get_setting("menu_radius", "87"), 87, 65, 135)
        radius = max(radius, int((ball + button) / 2) + 8)
        return ball, button, radius

    def _snap(self, reason):
        if self.container is None:
            return
        # All external auto-collapse triggers pass through this gate; a hook
        # may run after the main ball's ACTION_UP and after it has moved.
        if reason in ("outside_touch", "page_swipe", "host_interaction", "page_changed"):
            if self._own_gesture_guard(reason=reason):
                return
        w = self.container.getWidth()
        if w <= 0:
            self._record("snap_skipped", reason="width_zero")
            return
        before_x = self.center_x or 0
        self.right_edge = before_x >= w / 2
        was_expanded = self.expanded
        self.is_snapped = True
        self.expanded = False
        self._stop_material_dynamics()
        self._glow_state = None
        self._clear_material_backdrops()
        ball, btn, radius = self._sizes()
        target_x, target_y = self._layout_centers(w, self.container.getHeight(), ball, btn, radius)
        self._record("snap_requested", reason=reason,
                     edge="right" if self.right_edge else "left",
                     x_px=int(before_x), y_px=int(self.center_y or 0),
                     target_x_px=int(target_x), target_y_px=int(target_y),
                     screen_w_px=w, screen_h_px=self.container.getHeight(),
                     depth_pct=self._depth())
        if was_expanded and self._animation_kind() > 0:
            self._animate_collapse(reason, target_x, target_y)
        else:
            self._stop_visual_animations()
            self._relayout()
            self._commit_snap(reason)
        self._update_glow(force=True)

    def _commit_snap(self, reason):
        run_on_ui_thread(lambda: self._verify_snap(reason), 85)
        try:
            self.set_setting("edge", "right" if self.right_edge else "left")
            self.set_setting("y_fraction", str(self.y_fraction))
        except Exception as exc:
            self._failure("save_position", exc)


    def _depth(self):
        # Percentage of the DIAMETER hidden outside screen, not a scaling factor.
        return config_int(self.get_setting("edge_depth", "50"), 50, 0, 70)

    def _layout_centers(self, w, h, ball, btn, radius):
        r = dp(ball) / 2.0
        depth = self._depth() / 100.0
        hidden_px = dp(ball) * depth
        if self.expanded:
            x = float(w - max(dp(ball / 2 + 8), dp(55)) if self.right_edge
                      else max(dp(ball / 2 + 8), dp(55)))
        elif self.is_snapped:
            x = float(w - r + hidden_px if self.right_edge else r - hidden_px)
        else:
            x = float(clamp(self.center_x if self.center_x is not None else w / 2,
                            -r + dp(12), w + r - dp(12)))
        margin = dp(max(ball / 2 + 20, 30))
        if self.expanded: margin = dp(radius + btn / 2 + 10)
        # In landscape / split-screen the requested radius may exceed half
        # the available height. Center safely and shrink individual satellites.
        margin = min(margin, max(dp(12), h * .5))
        y = clamp(self.center_y if self.center_y is not None else h * self.y_fraction,
                  margin, max(margin, h - margin))
        return x, y

    def _relayout(self):
        if self.container is None or self.main is None: return False
        if self._closing_menu: return True
        w, h = self.container.getWidth(), self.container.getHeight()
        if w <= dp(120) or h <= dp(150): return False
        ball, btn, radius = self._sizes()
        prev = (self.center_x, self.center_y)
        x, y = self._layout_centers(w, h, ball, btn, radius)
        signature = (int(w),int(h),ball,btn,radius,round(x,2),round(y,2),
                     bool(self.expanded),bool(self.is_snapped),bool(self.right_edge),
                     self._depth(),
                     config_int(self.get_setting("touch_padding", "6"),6,0,16),
                     config_int(self.get_setting("menu_spread", "75"),75,45,90),
                     config_int(self.get_setting("time_font", "10"),10,8,16),
                     bool(self.get_setting("show_time", True)),
                     bool(self.get_setting("hide_time_snapped", True)))
        if signature == self._last_layout_signature and not self._dismiss_armed:
            self._update_track_notice()
            return True
        self._last_layout_signature = signature
        self.center_x, self.center_y = x, y
        self._place(self.main, ball, ball, x, y)
        if self._dismiss_armed: self._dismiss_placement()
        touch_pad = config_int(self.get_setting("touch_padding","6"),6,0,16)
        self._place(self.main_hit, ball + 2*touch_pad, ball + 2*touch_pad, x, y)
        self._place(self.glow_host, ball + 36, ball + 36, x, y)
        if (self._spectrum_config()[0] == 2 or
                (self._spectrum_config()[0] != 1 and
                 config_int(self.get_setting("glow_mode",1),1,0,3) != 0)):
            self._render_glow()
        self._place(self.ripple, ball, ball, x, y)
        self._place(self.time_text, 104, 22, x, y + dp(ball / 2 + 13))
        if self.track_notice is not None:
            popup_w = min(195, max(120, int(w / dp(1) - 104)))
            inward = -1 if self.right_edge else 1
            nx = clamp(x + inward*dp(ball/2 + popup_w/2 + 8),
                       dp(popup_w/2+6), w-dp(popup_w/2+6))
            position = config_int(self.get_setting("track_popup_position",0),0,0,2)
            offset = dp(ball/2 + 50)
            below = position == 2 or (position == 0 and y-offset < dp(32))
            ny = clamp(y + (offset if below else -offset), dp(32), h-dp(32))
            self._place(self.track_notice, popup_w, 52, nx, ny)
            self._update_track_notice()
        sign = -1 if self.right_edge else 1
        spread = config_int(self.get_setting("menu_spread", "75"), 75, 45, 90)
        inner = max(12, int(spread / 3))
        angles = {"speed": -spread, "left": -inner, "right": inner, "close": spread}
        for name, angle in angles.items():
            rad = math.radians(angle)
            cx = x + sign * dp(radius * math.cos(rad))
            cy = y + dp(radius * math.sin(rad))
            safe = dp(btn / 2 + 4)
            cx = clamp(cx, min(safe, w/2), max(w/2, w-safe))
            cy = clamp(cy, min(safe, h/2), max(h/2, h-safe))
            self._place(self.small[name], btn, btn, cx, cy)
            self.small[name].setVisibility(View.VISIBLE if self.expanded else View.GONE)
        self.time_text.setTextSize(float(config_int(self.get_setting("time_font", "10"), 10, 8, 16)))
        show_time = bool(self.get_setting("show_time", True)) and (
            self.expanded or not self.is_snapped or not self.get_setting("hide_time_snapped", True))
        self.time_text.setVisibility(View.VISIBLE if show_time else View.GONE)
        if not self.overlay_ready:
            self._render_progress_ring(self._playing_message())
            self.overlay_ready = True
            if not self.backgrounded and not self._inside_plugin_settings() and not getattr(self,"_resume_pending",False):
                self.container.setVisibility(View.VISIBLE)
            self._record("layout_ready", screen_w_px=w, screen_h_px=h,
                         x_px=int(x), y_px=int(y), ball_px=dp(ball))
        elif prev != (x, y) and self.is_snapped:
            self._record("layout_changed", screen_w_px=w, screen_h_px=h,
                         x_px=int(x), y_px=int(y), expanded=self.expanded)
        return True

    def _verify_snap(self, reason):
        if self.container is None or self.main is None: return
        p = self.main.getLayoutParams()
        if p is None: return
        ball_px = self.main.getWidth() or dp(self._sizes()[0])
        actual_cx = self.main.getLeft() + ball_px / 2.0
        actual_cy = self.main.getTop() + ball_px / 2.0
        self._record("snap_verified", reason=reason, x_px=int(self.center_x or 0),
                     actual_x_px=int(actual_cx), y_px=int(self.center_y or 0),
                     actual_y_px=int(actual_cy), screen_w_px=self.container.getWidth(),
                     depth_pct=self._depth(), expanded=self.expanded)

    def _install_interaction_hook(self):
        """Observe actual Activity dispatches; tolerate SDK reflection wrapper differences.

        v0.5 used find_class(...).getName(), which raised AttributeError on
        the user's device before any hook was installed. Use the running
        Activity's getClass() first, and isolate per-method failure.
        """
        if self._touch_hooks or self._fallback_touch_hooks:
            return
        activity = self._get_activity()
        if activity is None:
            self._record("touch_hook", status="no_activity")
            return
        candidates = []
        try:
            candidates.append(activity.getClass())
        except Exception as exc:
            self._failure("touch_runtime_class", exc)
        try:
            klass = find_class("org.telegram.ui.LaunchActivity")
            if klass is not None and not candidates:
                candidates.append(klass)
        except Exception as exc:
            self._failure("touch_class_lookup", exc)
        visited = set()
        for start in candidates:
            cursor = start
            for depth in range(12):
                if cursor is None:
                    break
                try:
                    cname = str(cursor.getName())
                except Exception:
                    cname = "class_level_%d" % depth
                try:
                    methods = list(cursor.getDeclaredMethods())
                except Exception as exc:
                    self._failure("touch_methods_reflect", exc)
                    methods = []
                if not methods:
                    for name in ("dispatchTouchEvent", "onUserInteraction"):
                        try:
                            if name == "onUserInteraction":
                                method = cursor.getDeclaredMethod(name)
                            else:
                                motion_class = find_class("android.view.MotionEvent")
                                if motion_class is None:
                                    continue
                                method = cursor.getDeclaredMethod(name, motion_class)
                            methods.append(method)
                        except Exception:
                            pass
                for method in methods:
                    try:
                        name = str(method.getName())
                        pcount = len(method.getParameterTypes())
                    except Exception:
                        continue
                    if (name, str(method)) in visited:
                        continue
                    visited.add((name, str(method)))
                    if name not in ("dispatchTouchEvent", "onUserInteraction"):
                        continue
                    if (name == "dispatchTouchEvent" and pcount != 1) or (name == "onUserInteraction" and pcount != 0):
                        continue
                    try:
                        method.setAccessible(True)
                    except Exception:
                        pass
                    try:
                        hook = self.hook_method(method, after=self._on_host_touch if name == "dispatchTouchEvent" else self._on_user_interaction)
                        # SDK may return None for hooks which registered successfully.
                        token = hook if hook is not None else ("registered", name, cname)
                        if name == "dispatchTouchEvent":
                            self._touch_hooks.append(token)
                            self._touch_method_names.add(cname)
                        else:
                            self._fallback_touch_hooks.append(token)
                        self._record("touch_hook", status="requested", listener=name, hook_source=cname)
                    except Exception as exc:
                        self._failure("hook_" + name, exc)
                try:
                    cursor = cursor.getSuperclass()
                except Exception as exc:
                    self._failure("touch_superclass", exc)
                    break
        self._touch_hook = self._touch_hooks[0] if self._touch_hooks else None
        self._fallback_touch_hook = self._fallback_touch_hooks[0] if self._fallback_touch_hooks else None
        self._touch_hook_installed_at = time.monotonic()
        if not self._touch_hooks and not self._fallback_touch_hooks:
            self._record("touch_hook", status="unavailable", source="activity_chain")


    def _install_touch_fallback(self):
        # All available inherited onUserInteraction methods are probed during
        # _install_interaction_hook; do not repeatedly hook from the refresh loop.
        return

    def _protect_main_touch(self, duration=0.38):
        """Protect a main-ball gesture across the layout/animation transition."""
        self._main_protect_until = max(
            getattr(self, "_main_protect_until", 0.0), time.monotonic() + duration)

    def _own_gesture_guard(self, event=None, reason="outside_touch"):
        """Do not interpret the ball's own touch as another page interaction.

        Touch dispatch can be observed AFTER the overlay has moved the main
        ball. Current hit-testing against the new position would then be wrong.
        The Android downTime is also checked when available so duplicate
        callbacks from the same gesture are ignored without relying on bounds.
        """
        recent = time.monotonic() < getattr(self, "_main_protect_until", 0.0)
        active = bool(getattr(self, "_main_touch_active", False))
        same_down = False
        if event is not None:
            try:
                stamp = int(event.getDownTime())
                same_down = stamp >= 0 and stamp in (
                    getattr(self, "_main_touch_down_ms", -1),
                    getattr(self, "_main_last_down_ms", -1))
            except Exception:
                pass
        if active or same_down or recent:
            seq = int(getattr(self, "_main_gesture_seq", 0))
            if seq != getattr(self, "_last_guard_log_seq", -1):
                self._last_guard_log_seq = seq
                self._record("auto_collapse_suppressed", reason="own_ball_touch",
                             trigger=reason, gesture_seq=seq)
            return True
        return False

    def _on_user_interaction(self, param):
        if self._playlist_is_open(): return
        try:
            if not self.alive or not self.get_setting("auto_collapse_outside", True):
                return
            if not self.expanded and self.is_snapped:
                return
            if self._own_gesture_guard(reason="user_interaction"):
                return
            activity = self._get_activity()
            if activity is None or param.thisObject != activity:
                return
            # If the concrete dispatch hook is receiving events, it can
            # distinguish the overlay from chat precisely. Do not also react
            # to this imprecise fallback (which has no touch coordinates).
            if self._touch_hook is not None and self._touch_event_seen:
                return
            stamped = time.monotonic()
            def decide():
                try:
                    if not self.alive or not self.get_setting("auto_collapse_outside", True):
                        return
                    if not self.expanded and self.is_snapped:
                        return
                    if self._own_gesture_guard(reason="delayed_user_interaction"):
                        return
                    # Ignore the floating ball's own touch; its ACTION_DOWN
                    # updates last_interaction before this delayed decision.
                    if self.last_interaction >= stamped - 0.10:
                        return
                    self._record("outside_touch", trigger="host_interaction",
                                 listener="onUserInteraction")
                    self._snap("host_interaction")
                except Exception as exc:
                    self._failure("touch_fallback_event", exc)
            run_on_ui_thread(decide, 120)
        except Exception as exc:
            self._failure("touch_fallback_event", exc)

    def _on_host_touch(self, param):
        if self._playlist_is_open(): return
        # Read only; never alter param.args, param result or the native event.
        try:
            if not self.alive:
                return
            activity = self._get_activity()
            if activity is None or param.thisObject != activity:
                return
            event = param.args[0]
            action = int(event.getActionMasked())
            if not self._touch_event_seen:
                self._touch_event_seen = True
                self._record("touch_listener_verified", listener="dispatchTouchEvent")
            if not self.get_setting("auto_collapse_outside", True):
                return
            if not self.expanded and self.is_snapped:
                return
            if self._own_gesture_guard(event, "activity_touch"):
                return
            x, y = float(event.getRawX()), float(event.getRawY())
            if action == MotionEvent.ACTION_DOWN:
                self._outside_gesture_start = (x, y)
                if self._is_inside_controls(x, y):
                    self._outside_gesture_start = None
                    return
                # Clicking unrelated UI should collapse immediately; the app
                # still receives and handles its original touch event.
                try:
                    stamp = int(event.getEventTime())
                except Exception:
                    stamp = int(time.monotonic() * 1000)
                if stamp == self._last_outside_event_ms:
                    return
                self._last_outside_event_ms = stamp
                self._record("outside_touch", trigger="page_touch",
                             listener="dispatchTouchEvent", touch_action=action)
                self._snap("outside_touch")
            elif action == MotionEvent.ACTION_MOVE and self._outside_gesture_start:
                start = self._outside_gesture_start
                if abs(x - start[0]) > dp(8) or abs(y - start[1]) > dp(8):
                    self._outside_gesture_start = None
                    self._record("outside_touch", trigger="page_swipe",
                                 listener="dispatchTouchEvent", touch_action=action)
                    self._snap("page_swipe")
            elif action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
                self._outside_gesture_start = None
        except Exception as exc:
            self._failure("outside_touch", exc)

    def _is_inside_controls(self, x, y):
        if self.main is None: return False
        views = [self.main, self.main_hit] + (list(self.small.values()) if self.expanded else [])
        for view in views:
            if view is None or view.getVisibility() != View.VISIBLE: continue
            p = view.getLayoutParams()
            if p is None: continue
            # Host hook must treat our invisible touch padding as OUR touch,
            # otherwise a gesture in the 8..16dp margin collapses the menu.
            pad = dp(2) if view is self.main_hit else dp(8)
            loc = jarray(jint)([0, 0])
            view.getLocationOnScreen(loc)
            if int(loc[0]) - pad <= x <= int(loc[0]) + view.getWidth() + pad and \
               int(loc[1]) - pad <= y <= int(loc[1]) + view.getHeight() + pad:
                return True
        return False

    def _dismiss_threshold_ms(self):
        return (500,700,1000)[config_int(self.get_setting("dismiss_hold_time",1),1,0,2)]

    def _dismiss_placement(self):
        if self.container is None or self.dismiss_target is None: return
        w,h=self.container.getWidth(),self.container.getHeight()
        if w <= 0 or h <= 0: return
        self._place(self.dismiss_target,76,76,w*.5,clamp(h-dp(95),dp(65),h-dp(48)))

    def _cancel_dismiss_ui(self):
        self._dismiss_gesture_generation += 1
        self._dismiss_armed=False
        self._dismiss_hover=False
        if self.dismiss_target is not None:
            self.dismiss_target.setVisibility(View.GONE)
            self.dismiss_target.setScaleX(1.0)
            self.dismiss_target.setScaleY(1.0)
            self.dismiss_target.setAlpha(1.0)

    @diagnostic_operation
    def _arm_dismiss_if(self, generation):
        if (generation != self._dismiss_gesture_generation or
                not self._main_touch_active or self.has_moved or
                self.touch_start is None or self.dismiss_target is None or
                self.container is None or not self.get_setting("dismiss_drag_enabled",True)):
            return
        # Never open the target just from ACTION_DOWN. The gesture must
        # remain held beyond the configured dwell duration.
        if (time.monotonic()-self._dismiss_start_mono)*1000.0+8 < self._dismiss_threshold_ms():
            remaining = max(12,int(self._dismiss_threshold_ms() -
                                    (time.monotonic()-self._dismiss_start_mono)*1000.0))
            run_on_ui_thread(lambda g=generation:self._arm_dismiss_if(g),remaining)
            return
        self._dismiss_armed=True
        self._dismiss_placement()
        self.dismiss_target.setVisibility(View.VISIBLE)
        self._record("dismiss_target",result="armed",duration_ms=self._dismiss_threshold_ms())

    def _update_dismiss_hover(self, rx, ry):
        if not self._dismiss_armed or self.dismiss_target is None: return
        try:
            position=jarray(jint)([0,0])
            self.dismiss_target.getLocationOnScreen(position)
            cx=position[0]+self.dismiss_target.getWidth()*.5
            cy=position[1]+self.dismiss_target.getHeight()*.5
            hover=math.hypot(rx-cx,ry-cy)<=float(dp(57))
            if hover!=self._dismiss_hover:
                self._dismiss_hover=hover
                self.dismiss_target.setScaleX(1.14 if hover else 1.0)
                self.dismiss_target.setScaleY(1.14 if hover else 1.0)
                self.dismiss_target.setAlpha(1.0 if hover else .82)
                self._record("dismiss_target",result="hover" if hover else "leave")
        except Exception as exc:
            self._failure("dismiss_hover",exc)

    @diagnostic_operation
    def _hide_until_next_track(self):
        if getattr(self, "_fft_visualizer", None) is not None:
            self._fft_release("hidden")
        if config_int(self.get_setting("dismiss_playback",0),0,0,1) == 1:
            try:
                mc = get_media_controller()
                message = mc.getPlayingMessageObject()
                if message is not None and not mc.isMessagePaused():
                    mc.pauseMessage(message)
            except Exception as exc: self._failure("manual_hide_pause",exc)
        # Polling cannot restore the same manually hidden track.
        self.manual_hidden_key=(self._internal_audio_key(self._playing_message())
                                or self.last_audio_key or self._last_real_track_key)
        self._hidden_at_monotonic=time.monotonic()
        self.expanded=False
        self.is_snapped=True
        self._closing_menu=False
        # Cancel any partly completed translation before hiding. A later
        # song may reuse the same overlay, so no old XY transform may survive.
        self._stop_visual_animations()
        for layer in self._ball_motion_layers():
            layer.setTranslationX(0.0)
            layer.setTranslationY(0.0)
        if self.container is not None:
            self._relayout()
        self._light_transition_generation+=1
        self._light_envelope=0.0
        self._light_target=0.0
        self._glow_state=None
        self._stop_color_flow()
        self._stop_spectrum()
        self._clear_flash_glow()
        if self.container is not None:
            self.container.setVisibility(View.GONE)
        self._record("ball_hidden",reason="drop_target")

    def on_touch(self, event, view=None):
        try: return self._handle_touch(event, view)
        except Exception as exc:
            self._failure("touch", exc)
            return True

    def _handle_touch(self, event, view=None):
        if event.getActionMasked() in (MotionEvent.ACTION_DOWN,MotionEvent.ACTION_UP,MotionEvent.ACTION_CANCEL):
            self._diagnostic_sample("disc_touch", touch_action=int(event.getActionMasked()), expanded=self.expanded)
        action = event.getActionMasked()
        rx, ry = float(event.getRawX()), float(event.getRawY())
        if action == MotionEvent.ACTION_DOWN:
            # One logical DOWN should not be interpreted as two new gestures
            # when multiple listeners forward the same MotionEvent.
            try:
                down_ms = int(event.getDownTime())
            except Exception:
                down_ms = int(event.getEventTime())
            if self._main_touch_active and down_ms == self._main_touch_down_ms:
                self._record("main_touch_ignored", reason="duplicate_down",
                             gesture_seq=self._main_gesture_seq)
                return True
            self._main_touch_active = True
            self._main_gesture_seq += 1
            self._tap_expanded_at_down = bool(self.expanded)
            self._tap_ready_at_down = (not self._closing_menu and
                                       time.monotonic() >= self._menu_ready_at)
            self._main_touch_down_ms = down_ms
            self._main_last_down_ms = down_ms
            self._protect_main_touch()
            self.last_interaction = time.monotonic()
            self.touch_start = (rx, ry)
            # Click ownership fixed on DOWN, before layout or animation moves.
            # A separate transparent hit target widens the outer ring without
            # widening the central play region or scaling the artwork.
            try:
                ball = self._sizes()[0]
                r = float(dp(ball)) / 2.0
                padding = (float(dp(config_int(self.get_setting("touch_padding","6"),6,0,16)))
                           if view is self.main_hit else 0.0)
                local_center = r + padding
                off_x = float(event.getX()) - local_center
                off_y = float(event.getY()) - local_center
                center_ratio = config_int(self.get_setting("center_zone_pct","54"),54,38,68)/100.0
                center_radius = min(r*center_ratio, max(dp(8), r-dp(10)))
                self._main_touch_zone = ("center" if math.hypot(off_x, off_y) <= center_radius else "ring")
            except Exception:
                self._main_touch_zone = "ring"
            self._record("main_touch_down", zone=self._main_touch_zone,
                         ready=self._tap_ready_at_down,
                         touch_mode=config_int(self.get_setting("touch_mode",0),0,0,1),
                         padding_dp=config_int(self.get_setting("touch_padding","6"),6,0,16),
                         gesture_seq=self._main_gesture_seq)
            self.touch_cx = self.center_x or 0
            self.touch_cy = self.center_y or 0
            self.has_moved = False
            self.touch_start_ms = int(event.getEventTime())
            self._dismiss_gesture_generation+=1
            self._dismiss_armed=False
            self._dismiss_hover=False
            self._dismiss_start_mono=time.monotonic()
            if self.dismiss_target is not None:
                self.dismiss_target.setVisibility(View.GONE)
            if self.get_setting("dismiss_drag_enabled",True):
                generation=self._dismiss_gesture_generation
                run_on_ui_thread(lambda g=generation:self._arm_dismiss_if(g),
                                 self._dismiss_threshold_ms())
            return True
        if action == MotionEvent.ACTION_MOVE and self.touch_start is not None:
            dx, dy = rx - self.touch_start[0], ry - self.touch_start[1]
            if abs(dx) >= dp(7) or abs(dy) >= dp(7): self.has_moved = True
            if self.has_moved and self.container is not None:
                self.last_interaction = time.monotonic()
                if self._dismiss_armed and self.expanded:
                    # The normal expanded layout is edge-anchored. Switch to
                    # free-drag geometry only after the red X is armed.
                    self.expanded=False
                    self._stop_visual_animations()
                    self._clear_material_backdrops()
                w, h = self.container.getWidth(), self.container.getHeight()
                self.is_snapped = False
                self.center_x = clamp(self.touch_cx + dx, dp(10), w - dp(10))
                self.center_y = clamp(self.touch_cy + dy, dp(35), h - dp(35))
                self._relayout()
                if self._dismiss_armed:
                    self._update_dismiss_hover(rx,ry)
            return True
        if action in (MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL):
            # Previously a second/unpaired ACTION_UP toggled the freshly
            # expanded menu straight back to closed. Require a matching DOWN.
            if not self._main_touch_active or self.touch_start is None:
                self._record("main_touch_ignored", reason="unpaired_release",
                             gesture_seq=self._main_gesture_seq, touch_action=int(action))
                return True
            try:
                if int(event.getDownTime()) != self._main_touch_down_ms:
                    self._record("main_touch_ignored", reason="stale_release",
                                 gesture_seq=self._main_gesture_seq, touch_action=int(action))
                    return True
            except Exception:
                pass  # Some SDK wrappers don't expose downTime.
            self._main_touch_active = False
            self._protect_main_touch()
            try:
                self._main_last_finish_ms = int(event.getEventTime())
            except Exception:
                pass
            self.last_interaction = time.monotonic()
            # A long-held finger is NOT a playback tap. Only a RELEASE onto
            # the visible red X can dismiss the entire overlay.
            drop=(self._dismiss_armed and action==MotionEvent.ACTION_UP)
            if drop:
                self._update_dismiss_hover(rx,ry)
                drop=bool(self._dismiss_hover)
            armed=self._dismiss_armed
            self._cancel_dismiss_ui()
            if drop:
                self._hide_until_next_track()
            elif armed or (self.has_moved and self.container is not None):
                if self.container is not None:
                    self.y_fraction = self.center_y / max(1,self.container.getHeight())
                    self._snap("drag_release" if self.has_moved else "dismiss_cancel")
            elif action == MotionEvent.ACTION_UP:
                held = int(event.getEventTime()) - self.touch_start_ms
                if held >= 850:
                    self._record("main_touch_ignored",reason="long_hold_without_drop",
                                 gesture_seq=self._main_gesture_seq)
                else:
                    zone = getattr(self,"_main_touch_zone","ring")
                    self._record("main_tap_accepted",expanded=self.expanded,
                                 zone=zone,tap_elapsed_ms=held,
                                 gesture_seq=self._main_gesture_seq)
                    mode=config_int(self.get_setting("touch_mode",0),0,0,1)
                    ready=bool(getattr(self,"_tap_ready_at_down",False))
                    if bool(self.expanded)!=bool(getattr(self,"_tap_expanded_at_down",False)):
                        ready=False
                    decision=route_main_tap(mode,self.expanded,zone,ready)
                    self._record("main_tap_routed",action=decision,ready=ready,
                                 expanded=self.expanded,touch_mode=mode,
                                 gesture_seq=self._main_gesture_seq)
                    if decision=="play":
                        self._toggle_play()
                        self._record("main_center_playback",expanded=self.expanded)
                        self._refresh()
                        if self.last_paused is False: self._flash_glow()
                    elif decision=="collapse":
                        self._snap("main_ring_collapse")
                    elif decision=="expand":
                        self._expand_menu()
            self.touch_start = None
            if self.container is not None and self.container.getVisibility() != View.GONE and not self._closing_menu:
                self._relayout()
            return True
        return False

    # -----------------------------------------------------------------
    # Audio and artwork
    # -----------------------------------------------------------------
    def _playing_message(self):
        try: return get_media_controller().getPlayingMessageObject()
        except Exception as exc:
            self._failure("playing_message", exc)
            return None

    def _duration(self, msg):
        if msg is None: return 0
        try: return max(0, int(msg.getDuration()))
        except Exception: return 0

    @diagnostic_operation
    def _button_action(self, name):
        self.last_interaction = time.monotonic()
        try:
            button = self.small.get(name)
            if button is not None and self._animation_kind() > 0:
                button.animate().scaleX(.90).scaleY(.90).setDuration(75).start()
                run_on_ui_thread(lambda b=button: b.animate().scaleX(1.0).scaleY(1.0).setDuration(155).start(), 90)
        except Exception as exc:
            self._failure("material_press", exc)
        key, default = BUTTON_SETTINGS[name]
        idx = config_int(self.get_setting(key, default), default, 0, len(ACTIONS)-1)
        self._record("button_tapped", button=name, action=str(idx))
        try:
            if idx in (0, 1, 2, 3):
                self._execute_control(idx)
            elif idx == 5:
                if config_int(self.get_setting("speed_behavior", 0), 0, 0, 1) == 1:
                    self._open_speed_choice()
                else:
                    self._cycle_speed()
            elif idx == 6:
                self._view_in_chat()
            elif idx == 7:
                self._snap("custom_collapse")
            elif idx == 8:
                self._toggle_play()
            elif idx == 9:
                self._toggle_playlist()
        except Exception as exc:
            self._failure("control_button", exc)
        if self.container is not None:
            self._refresh()

    @diagnostic_operation
    def _view_in_chat(self):
        """Navigation based on Telegram FragmentContextView's 'view in chat'."""
        msg = self._playing_message()
        if msg is None:
            self._record("view_in_chat", result="no_audio")
            return
        try:
            from client_utils import get_last_fragment
            from org.telegram.ui import ChatActivity
            from org.telegram.messenger import DialogObject
            fragment = get_last_fragment()
            if fragment is None:
                raise RuntimeError("No visible fragment")
            dialog_id = int(msg.getDialogId())
            message_id = int(msg.getId())
            if isinstance(fragment, ChatActivity) and int(fragment.getDialogId()) == dialog_id:
                fragment.scrollToMessageId(message_id, 0, False, 0, True, 0)
                self._record("view_in_chat", result="scrolled")
            else:
                args = Bundle()
                if DialogObject.isEncryptedDialog(dialog_id):
                    args.putInt("enc_id", int(DialogObject.getEncryptedChatId(dialog_id)))
                elif DialogObject.isUserDialog(dialog_id):
                    args.putLong("user_id", dialog_id)
                else:
                    args.putLong("chat_id", -dialog_id)
                args.putInt("message_id", message_id)
                fragment.presentFragment(ChatActivity(args), isinstance(fragment, ChatActivity))
                self._record("view_in_chat", result="navigation_requested")
            # No dialog/message identifiers logged or sent to other services.
            self._snap("navigate_to_chat")
        except Exception as exc:
            self._failure("view_in_chat", exc)
            try: BulletinHelper.show_error("无法定位此音频消息")
            except Exception: pass


    @diagnostic_operation
    def _execute_control(self, index):
        msg = self._playing_message()
        if msg is None:
            self._record("audio_control", result="preview_only", action=str(index))
            return
        mc = get_media_controller()
        self._record("audio_control", action=str(index), duration_s=self._duration(msg))
        if index == 0:
            self._verify_media_command("previous")
            mc.playPreviousMessage()
        elif index == 1:
            self._verify_media_command("next")
            mc.playNextMessage()
        elif index in (2, 3):
            duration = self._duration(msg)
            if duration <= 0:
                self._record("seek_skipped", reason="duration_unknown")
                return
            current = max(0, int(msg.audioProgressSec))
            key = "rewind_seconds" if index == 2 else "forward_seconds"
            amount = config_int(self.get_setting(key, "15" if index == 2 else "20"), 15 if index == 2 else 20, 1, 3600)
            target = clamp(current + (-amount if index == 2 else amount), 0, duration)
            mc.seekToProgress(msg, float(target) / float(duration))
            self._verify_media_command("seek",float(target))
            self._record("seek_requested", from_s=current, target_s=target, seconds=amount, duration_s=duration)

    @diagnostic_operation
    def _set_playback_speed(self, rate):
        try:
            msg = self._playing_message()
            if msg is None:
                return
            mc = get_media_controller()
            mc.setPlaybackSpeed(bool(msg.isMusic()), float(rate))
            self._record("speed_changed", value=str(rate), result="requested")
            self._verify_media_command("speed",float(rate))
        except Exception as exc:
            self._failure("speed_set", exc)

    @diagnostic_operation
    def _cycle_speed(self):
        msg = self._playing_message()
        if msg is None:
            return
        try:
            mc = get_media_controller()
            current = float(mc.getPlaybackSpeed(bool(msg.isMusic())))
            rates = parse_speed_list(self.get_setting("speed_rates", "1,1.25,1.5,2"))
            index = next((i for i, r in enumerate(rates) if abs(r-current) < .0005), -1)
            next_rate = rates[(index+1) % len(rates)]
            self._set_playback_speed(next_rate)
        except Exception as exc:
            self._failure("speed", exc)

    @diagnostic_operation
    def _open_speed_choice(self):
        msg = self._playing_message()
        if msg is None:
            self._show_info("请先播放一条音频，再选择速度")
            return
        activity = self._get_activity()
        if activity is None:
            self._record("speed_choice", result="no_activity")
            return
        try:
            rates = parse_speed_list(self.get_setting("speed_rates", "1,1.25,1.5,2"))
            labels = [self._speed_label(x) for x in rates]
            listener = SpeedChoiceListener(self, rates)
            self._speed_choice_listener = listener  # Keep dynamic proxy alive.
            builder = AlertDialogBuilder(activity)
            builder.set_title("播放速度")
            def choose(bld,index):
                listener.onClick(None,index)
                bld.dismiss()
            builder.set_items(labels, choose)
            builder.show()
            self._record("speed_choice", result="shown", speed_count=len(rates))
        except Exception as exc:
            self._failure("speed_choice", exc)
            self._show_info("暂时无法打开倍速选择，请稍后再试")


    @diagnostic_operation
    def _toggle_play(self):
        msg = self._playing_message()
        if msg is None:
            self._record("play_button_ignored", reason="no_current_audio")
            return
        try:
            mc = get_media_controller()
            if (self._requested_paused is not None and
                    time.monotonic() < self._requested_paused_deadline):
                current_paused = self._requested_paused
            else:
                current_paused = bool(mc.isMessagePaused())
            desired_paused = not current_paused
            if desired_paused:
                mc.pauseMessage(msg)
            else:
                mc.playMessage(msg)
            self._verify_media_command("pause",desired_paused)
            self._requested_paused = desired_paused
            self._requested_paused_deadline = time.monotonic() + 1.5
            # Immediate feedback; next media refresh reconciles real state.
            self.last_paused = desired_paused
            self._update_glow(paused=desired_paused, force=True)
            self._record("play_button_pressed", status="sent", paused=desired_paused)
        except Exception as exc: self._failure("play_pause", exc)

    @diagnostic_operation
    def _cover_update(self, msg):
        if self.cover is None: return
        if not self.get_setting("show_cover", True):
            self.cover.clearImage()
            return
        self._load_audio_art(self.cover, msg)

    def _spin(self, should_spin):
        if self.cover is None or should_spin == self.animating: return
        self.animating = should_spin
        try:
            if should_spin:
                if self.animator is None:
                    self.animator = ObjectAnimator.ofFloat(self.cover, "rotation", 0.0, 360.0)
                    self.animator.setDuration(18000)
                    self.animator.setRepeatCount(ValueAnimator.INFINITE)
                    self.animator.setInterpolator(LinearInterpolator())
                if self.animator.isPaused(): self.animator.resume()
                elif not self.animator.isRunning(): self.animator.start()
            elif self.animator is not None: self.animator.pause()
        except Exception as exc:
            self.animating = False
            self._failure("cover_rotation", exc)

    def _action_label(self, idx):
        if idx == 0: return "|◀"
        if idx == 1: return "▶|"
        if idx == 2:
            return "−" + str(config_int(self.get_setting("rewind_seconds", "15"), 15, 1, 3600))
        if idx == 3:
            return "+" + str(config_int(self.get_setting("forward_seconds", "20"), 20, 1, 3600))
        if idx == 5: return "倍速"
        if idx == 6: return "💬"  # standard speech-bubble icon, no Chinese text
        if idx == 7: return "×"
        if idx == 9: return "≡"
        if idx == 8:
            return "▶" if bool(getattr(self, "last_paused", True)) else "Ⅱ"
        return "—"

    def _inside_plugin_settings(self):
        """Best-effort host fragment detection; never alter the audio state.

        Some forks rename the settings fragment. We only hide while a known
        settings fragment is visible or during the brief settings-open handoff.
        """
        if not self.get_setting("settings_autohide", True): return False
        if time.monotonic() < self._settings_preview_until: return False
        try:
            from client_utils import get_last_fragment
            fragment=get_last_fragment()
            if fragment is not None:
                name=str(fragment.getClass().getSimpleName()).lower()
                if "setting" in name and ("plugin" in name or "plugins" in name):
                    return True
        except Exception:
            pass
        return time.monotonic() < getattr(self,"_settings_hint_until",0.0)

    def _detect_page_change(self):
        try:
            from client_utils import get_last_fragment
            fragment = get_last_fragment()
            page = str(fragment.getClass().getSimpleName()) if fragment is not None else "None"
            if self.last_page is None:
                self.last_page = page
            elif self.last_page != page:
                self.last_page = page
                self._record("page_changed", activity="fragment_changed")
                if self.get_setting("auto_collapse_outside", True) and self.expanded:
                    self._snap("page_changed")
        except Exception:
            pass

    def _refresh(self):
        if not self.alive or self.backgrounded: return
        if not self.get_setting("enabled", True):
            self._remove_overlay()
            return
        msg = self._playing_message()
        self._real_audio_present = msg is not None
        # Preview is retired: never display a synthetic player without audio.
        if msg is None:
            now = time.monotonic()
            if self._track_gap_started_at is None:
                self._track_gap_started_at = now
            # Previous identity remains available for a real queued-track
            # transition, but not for unrelated playback after a long idle.
            if now - self._last_real_observed_at > 20.0:
                self._last_real_track_key = None
            if self.container is not None:
                self._light_fade_cleanup_pending = True
                self._real_audio_present = False
                self._set_light_target(False)
                if self._light_envelope <= 0.001:
                    self._record("audio_ended", status="overlay_removed")
                    self._remove_overlay()
            # Keep last_audio_key and manual_hidden_key. A temporary None
            # does NOT constitute a new song, timer completion or unhide.
            self._track_notice_until = 0.0
            self._requested_paused = None
            self._requested_paused_deadline = 0.0
            return
        # No message IDs or account IDs stored in diagnostics.
        # Internal-only identity, never serialized or logged. Stable across Java wrappers.
        if msg is None:
            key = "__preview__"
        else:
            key = self._internal_audio_key(msg)
        if msg is not None:
            self._light_fade_cleanup_pending = False
        if key != self.last_audio_key:
            # A Telegram track transition may briefly expose no current message.
            # Preserve the previous *internal* song identity for a short gap.
            previous_real = self._last_real_track_key
            # The previous version measured 15s since the PREVIOUS TRACK
            # STARTED. Every ordinary 3-minute song was then 'first play'.
            # Keep the previous identity across a brief no-message gap, but
            # forget it when there has truly been no music for a while.
            previous_live = (self._last_real_observed_at > 0.0 and
                             time.monotonic() - self._last_real_observed_at <= 20.0)
            initial_song = not (msg is not None and previous_real is not None
                               and previous_real != key and previous_live)
            # A new song in another dialog/account is a fresh session, not
            # automatically the 'next song' from the same Telegram queue.
            same_source = (isinstance(previous_real, tuple) and
                           isinstance(key, tuple) and
                           len(previous_real) >= 2 and len(key) >= 2 and
                           previous_real[:2] == key[:2])
            if not initial_song and same_source and msg is not None:
                self._notice_track_changed(msg)
            if msg is not None:
                self._last_real_track_key = key
                self._last_real_track_at = time.monotonic()
                self._last_real_observed_at = time.monotonic()
                self._track_gap_started_at = None
            self.last_audio_key = key
            self._requested_paused = None
            self._requested_paused_deadline = 0.0
            # Only a genuinely different REAL track releases a user-hidden
            # overlay. Preview and None gaps must never release it.
            if msg is not None and self.manual_hidden_key != key:
                self.manual_hidden_key = None
            self.last_cover_key = None
            self._record("audio_changed", duration_s=self._duration(msg), preview=msg is None)
            self._cover_attempts = 0
        if msg is not None:
            # Refresh every tick. Never use elapsed duration since track start.
            self._last_real_observed_at = time.monotonic()
            self._track_gap_started_at = None
        if self.manual_hidden_key is not None and (msg is None or self.manual_hidden_key == key):
            if self.container is not None: self.container.setVisibility(View.GONE)
            return
        if not self._ensure_overlay(): return
        # _ensure_overlay can rebuild its Activity view, which clears state.
        # Restore actual-media presence after rebuilding so the first frame of
        # active audio is allowed to light the halo immediately.
        self._real_audio_present = msg is not None
        # Visibility is committed only after progress and cover state are refreshed.
        desired = View.GONE if self._inside_plugin_settings() else View.VISIBLE
        if desired == View.GONE and self.container.getVisibility() != View.GONE:
            self._record("overlay_visibility", status="settings_hidden")
            self.container.setVisibility(View.GONE)
        self._detect_page_change()
        if self.get_setting("auto_collapse", True) and self.expanded and not self._main_touch_active and not self._playlist_is_open():
            delay = config_int(self.get_setting("idle_delay", "2"), 2, 1, 30)
            if time.monotonic() - self.last_interaction >= delay:
                self._snap("idle_timeout")
        if msg is None:
            paused = True
            self.time_text.setText("动画预览")
        else:
            try: paused = bool(get_media_controller().isMessagePaused())
            except Exception: paused = True
            if self._requested_paused is not None:
                if paused == self._requested_paused or time.monotonic() >= self._requested_paused_deadline:
                    self._requested_paused = None
                else:
                    paused = self._requested_paused
            sec = max(0, int(msg.audioProgressSec))
            self.time_text.setText("%s / %s" % (fmt_time(sec), fmt_time(self._duration(msg))))
        if self.last_paused is None or paused != self.last_paused:
            self.last_paused = paused
            self._record("playback_state", paused=paused)
        self.symbol.setText("▶" if paused else "Ⅱ")
        try: self._render_progress_ring(msg)
        except Exception as exc: self._failure("progress_ring", exc)
        self._update_glow(paused)
        self._spin(not paused and bool(self.get_setting("spin_cover", True)))
        if key != self.last_cover_key:
            self.last_cover_key = key
            self.cover_reported = False
            self.cover_probe_at = time.monotonic() + 2.8
            self._cover_attempts = 1
            self._cover_update(msg)
            if config_int(self.get_setting("glow_color",0),0,0,len(GLOW_COLORS)-1) == 2:
                self._glow_bitmap_key = None
        elif not self.cover_reported and time.monotonic() >= self.cover_probe_at:
            self.cover_reported = True
            if msg is not None and self.get_setting("show_cover", True):
                try:
                    received = self.cover.getImageReceiver().getBitmap() is not None
                    width_px = height_px = 0
                    if received:
                        bitmap = self.cover.getImageReceiver().getBitmap()
                        width_px, height_px = int(bitmap.getWidth()), int(bitmap.getHeight())
                        if config_int(self.get_setting("glow_color",0),0,0,len(GLOW_COLORS)-1) == 2:
                            self._glow_bitmap_key = None
                    self._record("cover_result", result="visible" if received else "not_loaded",
                                 bitmap_w_px=width_px, bitmap_h_px=height_px,
                                 attempt=self._cover_attempts)
                    if not received and self._cover_attempts < 3:
                        self.cover_reported = False
                        self._cover_attempts += 1
                        self.cover_probe_at = time.monotonic() + 3
                        self._cover_update(msg)
                except Exception as exc:
                    self._failure("cover_probe", exc)
        for name, (setting, default) in BUTTON_SETTINGS.items():
            index = config_int(self.get_setting(setting, default), default, 0, len(ACTIONS)-1)
            label = self._action_label(index)
            if index == 5 and msg is not None:
                try:
                    speed = float(get_media_controller().getPlaybackSpeed(bool(msg.isMusic())))
                    label = "%g×" % speed
                except Exception: pass
            self.small_labels[name].setText(label)
        self._relayout()
        self._render_progress_ring(msg)
        if self.overlay_ready:
            if self.container.getVisibility() != desired:
                self._record("overlay_visibility", status="visible" if desired == View.VISIBLE else "settings_hidden")
                self.container.setVisibility(desired)
                if desired == View.VISIBLE:
                    self._update_spectrum(paused)
            if getattr(self,"_resume_pending",False):
                self._record("foreground_frame", reused=getattr(self,"_resume_reused",False),
                             elapsed_ms=int((time.monotonic()-self._foreground_at)*1000),
                             fraction=float(max(0,int(msg.audioProgressSec)))/max(1,self._duration(msg)),
                             result="draw_requested")
                self._resume_pending = False
        if not self._touch_event_seen and self._touch_hook_installed_at and \
                time.monotonic() - self._touch_hook_installed_at > 20 and not getattr(self, "_touch_probe_reported", False):
            self._touch_probe_reported = True
            self._record("touch_hook_unverified", status="no_activity_touch_seen",
                         hook_active=bool(self._touch_hooks),
                         available=bool(self._fallback_touch_hooks))
        if time.monotonic() - self._last_health > 65:
            self._last_health = time.monotonic()
            self._record("heartbeat", expanded=self.expanded, edge="right" if self.right_edge else "left",
                         paused=paused, x_px=int(self.center_x or 0), y_px=int(self.center_y or 0),
                         screen_w_px=self.container.getWidth(), screen_h_px=self.container.getHeight(),
                         depth_pct=self._depth(), hook_active=self._touch_hook is not None)

    def _tick(self, generation=None):
        if generation is None:
            generation = getattr(self, "_poll_generation", 0)
        if not getattr(self, "alive", False) or generation != getattr(self, "_poll_generation", 0):
            return
        # One polling chain owns the timer, regardless of overlay visibility,
        # preview mode, foreground/background, or disabled disc rendering.
        try:
            self._poll_sleep_timer()
        except Exception as exc:
            self._failure("sleep_poll", exc)
        try:
            self._sync_sleep_settings()
            if not self.backgrounded:
                self._refresh()
            self._fft_lifecycle_sync()
        except Exception as exc:
            self._failure("refresh_tick", exc)
        if self.alive and generation == getattr(self, "_poll_generation", 0):
            run_on_ui_thread(lambda: self._tick(generation), 850)

    @diagnostic_operation
    def _remove_overlay(self):
        self._layout_generation = getattr(self,"_layout_generation",0)+1
        self._arc_generation = getattr(self,"_arc_generation",0)+1
        self._notice_generation = getattr(self,"_notice_generation",0)+1
        self._close_playlist(immediate=True)
        if (getattr(self, "_fft_visualizer", None) is not None or
                getattr(self, "_fft_native_hook", None) is not None or
                getattr(self, "_fft_analytics_hook", None) is not None):
            self._fft_release("background" if self.backgrounded else "hidden")
        self._light_transition_generation += 1
        self._light_envelope=0.0
        self._light_target=0.0
        self._light_fade_cleanup_pending=False
        self._dismiss_gesture_generation += 1
        self._dismiss_armed=False
        self._dismiss_hover=False
        self._stop_spectrum()
        self._spectrum_frames.clear()
        self._spectrum_cache_key=None
        self._clear_flash_glow()
        self._stop_material_dynamics()
        self._stop_color_flow()
        if self._glow_animator is not None:
            try: self._glow_animator.cancel()
            except Exception: pass
            self._glow_animator = None
        self._glow_state = None
        self._glow_bitmap_key = None
        self._glow_bitmap = None
        self._real_audio_present = False
        self._material_bitmaps = []
        self._clear_material_backdrops()
        self._stop_visual_animations()
        if self.animator is not None:
            try: self.animator.cancel()
            except Exception: pass
        self.animator = None
        self.animating = False
        if self.container is not None:
            try:
                parent = self.container.getParent()
                if parent is not None: parent.removeView(self.container)
            except Exception as exc: self._failure("overlay_remove", exc)
            self._record("overlay_removed", status="removed")
        self.container = None
        self.activity = None
        self.main = None
        self.cover = None
        self.symbol = None
        self.time_text = None
        self.ripple = None
        self.small = {}
        self.small_labels = {}
        self.small_backdrops = {}
        self.small_sheens = {}
        self.small_materials = {}
        self._satellite_listeners = {}
        self.main_hit = None
        self.glow = None
        self.glow_flash = None
        self.glow_host = None
        self.motion_host = None
        self._last_layout_signature = None
        self.light_host = None
        self.dismiss_target = None
        self.spectrum = None
        self.progress_ring = None
        self._wave_bitmap = None
        self._wave_shader_key = None
        self._progress_bitmap = None
        self._progress_bitmap_side = None
        self._progress_last_value = None
        self._notice_ripple = None
        self.track_notice = None
        self.track_notice_title = None
        self.track_notice_detail = None
        self._flash_animator = None
        self.touch_listener = None
        self.center_x = None
        self.center_y = None
        self.last_cover_key = None
        self.cover_reported = True
        self.overlay_ready = False
        self.is_snapped = True
        self.expanded = False
        # An Activity change should not carry an old overlay gesture forward.
        self._main_touch_active = False
        self._main_protect_until = 0.0
        self._main_touch_down_ms = -1
        self.touch_start = None
