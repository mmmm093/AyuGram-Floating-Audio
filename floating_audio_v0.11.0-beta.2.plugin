    def _settings_speed(self):
        self._settings_hint_until = time.monotonic()+1.8
        status = "未播放音频"
        msg = self._playing_message()
        if msg is not None:
            try: status = self._speed_label(float(get_media_controller().getPlaybackSpeed(bool(msg.isMusic()))))
            except Exception: status = "点击查看可选速度"
        return [Header(text="播放速度"),
                Text(text="选择当前播放速度", subtext=status,
                     on_click=lambda *a: run_on_ui_thread(self._open_speed_choice)),
                Text(text="自定义常用播放速度", subtext="1× 正常 · 1.5× 加快 · 0.75× 放慢", on_click=self._edit_speed_rates),
                Header(text="快捷按钮切换方式"),
                Selector(key="speed_behavior", text="点击倍速按钮时", items=SPEED_BEHAVIORS,
                         default=0, on_change=self._changed_callback("speed_behavior")),
                self._settings_entry("设置倍速快捷键", "可选：将任一方向按钮设为倍速", self._settings_buttons)]

    @staticmethod
    def _speed_label(rate):
        return "%g× · %s" % (rate, "正常速度" if abs(rate-1)<.001 else
                              ("加快 %g%%" % ((rate-1)*100) if rate>1 else "放慢 %g%%" % ((1-rate)*100)))

    def _show_info(self, message):
        text = str(message)
        def show():
            if len(text) <= 28 and "\n" not in text:
                BulletinHelper.show_info(text)
                return
            activity = self._get_activity()
            if activity is None: return
            builder = AlertDialogBuilder(activity)
            builder.set_title("提示")
            builder.set_message(text)
            builder.set_positive_button("知道了")
            builder.show()
        run_on_ui_thread(show)

    def _themed_edit(self, activity):
        edit = EditTextBoldCursor(activity)
        edit.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        edit.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint))
        edit.setCursorColor(Theme.getColor(Theme.key_dialogTextBlack))
        edit.setBackground(Theme.createEditTextDrawable(activity, True))
        edit.setTextSize(16.0)
        edit.setPadding(dp(20), dp(10), dp(20), dp(10))
        return edit

