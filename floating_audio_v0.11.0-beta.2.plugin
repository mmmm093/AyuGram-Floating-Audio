            Divider(text="暂停条件和自定义时间在下次开启定时器时生效。"),
            Text(text="当前状态", subtext=self._sleep_status_text(), on_click=self._sleep_status_clicked),
            Text(text="取消本次定时", on_click=self._cancel_sleep_timer),
        ]

    @diagnostic_operation
    def _edit_sleep_duration(self, view=None):
        activity = self._get_activity()
        if activity is None: return
        total = config_int(self.get_setting("sleep_custom_minutes",45),45,1,1440)
        host = LinearLayout(activity)
        host.setOrientation(LinearLayout.VERTICAL)
        host.setPadding(dp(20),dp(8),dp(20),dp(8))
        fields = []
        for label, value in (("小时",total//60),("分钟",total%60)):
            caption = self._playlist_text(activity,label,14)
            caption.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
            host.addView(caption)
            edit = self._themed_edit(activity)
            edit.setSingleLine(True)
            edit.setInputType(2)  # TYPE_CLASS_NUMBER; validation still rejects pasted text.
            edit.setText(str(value))
            host.addView(edit,LinearLayout.LayoutParams(-1,dp(48)))
            fields.append(edit)
        dialog = AlertDialog.Builder(activity).setTitle("自定义暂停时间").setMessage(
            "填写小时和分钟，总时长为 1 分钟～24 小时。保存后选用此条件，开启定时器才开始计时。正在运行的定时不受影响。"
        ).setView(host).setNegativeButton("取消",None).setPositiveButton("保存",None).create()
        def save(v):
            try:
                minutes = parse_sleep_duration(str(fields[0].getText()),str(fields[1].getText()))
            except ValueError:
                fields[1].setError("小时填 0～24，分钟填 0～59；总时长须为 1 分钟～24 小时")
                return
            self.set_setting("sleep_custom_minutes",minutes)
            self.set_setting("sleep_choice",5,reload_settings=True)
            self._record("sleep_duration_saved", duration_ms=minutes*60000, result="next_start")
            dialog.dismiss()
        dialog.show()
        # Replace the click listener after showing, so invalid input stays editable.
        dialog.getButton(-1).setOnClickListener(OnClickListener(save))

