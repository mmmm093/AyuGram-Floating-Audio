    def _active_effect_name(self):
        mode = config_int(self.get_setting("spectrum_mode", 0), 0, 0, 2)
        if mode:
            return SPECTRUM_MODES[mode]
        return GLOW_STYLES[config_int(self.get_setting("glow_style", 0), 0, 0, 2)]

    def _update_glow_style_cell(self):
        cell = getattr(self,"_glow_style_cell",None)
        if cell is not None:
            cell.setTextAndValue("光效样式", self._active_effect_name(), True)

    def _glow_style_row(self):
        from ui.settings import Custom
        from org.telegram.ui.Cells import TextSettingsCell
        cell = TextSettingsCell(self._get_activity())
        self._glow_style_cell = cell
        self._update_glow_style_cell()
        return Custom(view=cell, on_click=lambda *args:self._choose_glow_style())

    def _select_glow_style(self, index):
        index = int(index)
        if not 0 <= index < len(GLOW_STYLES): return
        self.set_setting("spectrum_mode", 0)
        self.set_setting("glow_style", index, reload_settings=True)
        self._update_glow_style_cell()
        self._setting_changed("glow_style", index)

    def _choose_glow_style(self, view=None):
        activity = self._get_activity()
        if activity is None: return
        try:
            from org.telegram.ui.Cells import RadioColorCell
            builder = AlertDialogBuilder(activity)
            builder.set_title("选择光效样式")
            body = LinearLayout(activity)
            body.setOrientation(LinearLayout.VERTICAL)
            selected = (config_int(self.get_setting("glow_style",0),0,0,2)
                        if self._spectrum_config()[0] == 0 else -1)
            listeners = []
            for index,label in enumerate(GLOW_STYLES):
                row = RadioColorCell(activity)
                row.setTextAndValue(label,index == selected)
                def choose(v, choice=index):
                    self._select_glow_style(choice)
                    builder.dismiss()
                listener = OnClickListener(choose)
                listeners.append(listener)
                row.setOnClickListener(listener)
                body.addView(row,LinearLayout.LayoutParams(-1,dp(50)))
            self._glow_choice_listeners = listeners
            def dismissed(bld):
                if self._glow_choice_listeners is listeners:
                    self._glow_choice_listeners = []
            builder.set_on_dismiss_listener(dismissed)
            builder.set_view(body)
            builder.set_negative_button("取消")
            builder.show()
        except Exception as exc:
            self._failure("glow_choice",exc)
            self._show_info("暂时无法打开光效选择，请导出诊断日志")

