def route_main_tap(mode, expanded, zone, ready):
    """Single action per completed gesture. No playback on a collapse->expand tap."""
    if not ready:
        return "ignore"
    if mode == 1:
        if not expanded:
            return "expand"
        return "play" if zone == "center" else "ignore"
    if zone == "center":
        return "play"
    return "collapse" if expanded else "expand"


def parse_sleep_duration(hours, minutes):
    """Validate both fields before mutating preferences or an active timer."""
    h, m = str(hours).strip(), str(minutes).strip()
    if not re.fullmatch(r"[0-9]{1,2}",h) or not re.fullmatch(r"[0-9]{1,2}",m):
        raise ValueError("invalid_duration")
    h, m = int(h), int(m)
    total = h*60+m
    if h > 24 or m > 59 or not 1 <= total <= 1440:
        raise ValueError("invalid_duration")
    return total


def argb32(alpha, red, green, blue):
    """Explicit signed Java int; never let Chaquopy choose ColorLong APIs.

    On Android 10+ Paint.setColor and RadialGradient have int/long color
    overloads. Passing a plain Python int can select long and throw
    ColorSpace.get(Invalid ID). jint is required at every such boundary.
    """
    return jint(Color.argb(int(clamp(alpha, 0, 255)), int(red), int(green), int(blue)))


def render_material_bitmap(style, side_px, opacity):
    """Four STRUCTURALLY different button materials, rendered with Android Canvas.

    0: milky diffusion + microsurface texture; 4: hollow transparent lens with
    strong sidewall/prism rims; 5: convex gel with internal luminous volume;
    6: machined key with a crisp hard chamfer and inset concave center.
    Colors must be explicitly jint for Android/Chaquopy overloaded APIs.
    """
    size = max(32, int(side_px))
    image = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
    cv = Canvas(image)
    p = Paint(Paint.ANTI_ALIAS_FLAG)
    mid = size*.5
    r = size*.473
    opacity = clamp(float(opacity)/100.0, .2, 1.0)
    def c(a, rr=226, gg=236, bb=247):
        return argb32(a, rr, gg, bb)
    def reset(style_value=Paint.Style.FILL):
        p.setShader(None)
        p.setStyle(style_value)
        p.setAlpha(255)
    def disc(color, radius=r, x=mid, y=mid):
        reset()
        p.setColor(color)
        cv.drawCircle(float(x),float(y),float(radius),p)
    def radial(cx,cy,rad,inner,outer,disc_radius=r):
        reset()
        p.setShader(RadialGradient(float(cx),float(cy),float(max(1.,rad)),inner,outer,Shader.TileMode.CLAMP))
        cv.drawCircle(float(mid),float(mid),float(disc_radius),p)
        p.setShader(None)
    def linear(x1,y1,x2,y2,first,last,disc_radius=r):
        reset()
        p.setShader(LinearGradient(float(x1),float(y1),float(x2),float(y2),first,last,Shader.TileMode.CLAMP))
        cv.drawCircle(float(mid),float(mid),float(disc_radius),p)
        p.setShader(None)
    def rim(radius,width,col,a=0,angle=360):
        if radius<=0:return
        reset(Paint.Style.STROKE)
        p.setStrokeWidth(float(max(.55,width)))
        p.setColor(col)
        cv.drawArc(RectF(float(mid-radius),float(mid-radius),float(mid+radius),float(mid+radius)),float(a),float(angle),False,p)
        reset()
    def oval(x0,y0,x1,y1,col):
        reset()
        p.setColor(col)
        cv.drawOval(RectF(float(x0*size),float(y0*size),float(x1*size),float(y1*size)),p)
    if style==0:   # diffuse frost, flat instead of glossy
        linear(0,0,size,size,c(191*opacity,246,249,253),c(191*opacity,112,135,157))
        radial(size*.2,size*.05,size*.95,c(92*opacity,255,255,255),c(0,255,255,255))
        rim(r-size*.012,size*.014,c(147,230,240,247))
        rim(r-size*.040,size*.011,c(88,251,252,255))
        # deterministic nonrandom dither: microscopic scatter, never glitter
        for i in range(220):
            x=size*(.08+.84*((i*73%223)/222.))
            y=size*(.08+.84*((i*101%227)/226.))
            if (x-mid)**2+(y-mid)**2 < (r-size*.055)**2:
                disc(c(24 if i%4 else 47,255,255,255), max(.28,size*.0026),x,y)
        oval(.24,.15,.76,.26,c(14,255,255,255))
    elif style==4:   # genuine-appearing glass: mostly transparent core, illuminated thick annulus
        disc(c(27*opacity,136,190,221))
        radial(size*.31,size*.22,size*.78,c(66*opacity,252,254,255),c(8,74,125,166))
        # alternating refraction walls: white edge > dark gutter > cold inner caustic
        rim(r-size*.020,size*.040,c(218,238,249,255))
        rim(r-size*.061,size*.044,c(142,42,79,121))
        rim(r-size*.105,size*.027,c(179,240,251,255))
        rim(r-size*.137,size*.012,c(64,209,232,248))
        rim(r-size*.029,size*.051,c(255,255,255,255),190,123)
        rim(r-size*.031,size*.045,c(159,84,167,238),8,104)
        rim(r-size*.111,size*.019,c(182,255,255,255),214,79)
        oval(.25,.105,.76,.155,c(100,255,255,255))
        oval(.32,.845,.69,.881,c(66,159,206,248))
    elif style==5:  # bulging soft gel: body, internal lens, liquid cap, lower meniscus
        radial(size*.32,size*.16,size*.82,c(244*opacity,245,253,255),c(204*opacity,52,109,167))
        radial(size*.36,size*.23,size*.63,c(145*opacity,255,255,255),c(0,255,255,255))
        oval(.12,.09,.88,.51,c(65*opacity,255,255,255))
        oval(.22,.13,.74,.31,c(144*opacity,255,255,255))
        oval(.16,.73,.84,.91,c(98*opacity,26,67,109))
        rim(r-size*.016,size*.039,c(157,198,231,255))
        rim(r-size*.063,size*.024,c(192,255,255,255),188,155)
        rim(r-size*.066,size*.046,c(184,18,52,92),6,129)
        oval(.40,.115,.61,.155,c(90,255,255,255))
    elif style==6:  # physical switch, opaque chamfer not an air bubble
        radial(size*.28,size*.12,size*.95,c(255,238,242,247),c(255,32,39,50))
        rim(r-size*.014,size*.044,c(248,251,254,255),188,158)
        rim(r-size*.014,size*.045,c(243,15,20,32),4,175)
        rim(r-size*.060,size*.040,c(255,17,26,39))
        rim(r-size*.082,size*.018,c(180,215,226,239),190,150)
        # recessed opaque face offset down-right, shadow ring reads as depth
        radial(size*.35,size*.22,size*.80,c(255,145,159,173),c(255,38,48,62),r-size*.105)
        rim(r-size*.121,size*.023,c(197,219,228,239),185,145)
        rim(r-size*.120,size*.026,c(232,7,12,24),9,150)
        oval(.23,.245,.77,.275,c(39,255,255,255))
    else:
        radial(mid*.7,mid*.5,size*.75,c(160,223,236,249),c(180,47,67,90))
    reset()
    return image


def glow_palette(option, rgb):
    """Opaque RGB list; palette stays distinguishable on black/white hosts."""
    if option == 3:  # cobalt / lavender
        return [(96,185,255),(172,123,255),(96,185,255)]
    if option == 4:  # peach / rose
        return [(255,155,178),(255,194,122),(255,155,178)]
    if option == 5:  # arctic cyan / blue
        return [(86,236,219),(86,149,255),(86,236,219)]
    if option == 6:  # Restrained low-saturation rainbow, retained from v0.8.5.
        return [(127,190,250),(176,143,230),(245,163,188),
                (249,204,158),(146,219,197),(127,190,250)]
    if option == 7:  # Distinct high-chroma RGB spectrum with smooth transition stops.
        return [(255,42,59),(255,210,37),(42,255,95),
                (35,220,252),(52,98,255),(190,57,245),(255,42,59)]
    return [tuple(rgb),tuple(rgb)]


def spectrum_levels(frame, count=28, speed=1, strength=1):
    """Smooth deterministic pseudo-spectrum; NEVER claim to measure audio FFT.

    Neighboring bars and adjacent frames correlate to avoid random jitter.
    No access to the microphone, audio buffer, message content, or network.
    """
    t = 2.0 * math.pi * (frame % 24) / 24.0
    levels = []
    for i in range(count):
        x = float(i)/max(1,count-1)
        band = 0.50 + 0.20*math.sin(3.4*x + 0.25) + 0.14*math.cos(9.3*x-0.7)
        wave = 0.24*math.sin(t + i*.49) + 0.13*math.sin(2*t - i*.75)
        pulse = 0.13*math.sin(3*t + i*.16)
        value = clamp(band + wave + pulse, 0.08, 0.98)
        levels.append(clamp(value * (0.68,0.86,1.0)[int(clamp(strength,0,2))],0.08,1.0))
    return levels


def fft_band_levels(data, sampling_rate_mhz, count=28, strength=1):
    """Android packed signed-byte FFT -> 20 Hz..20 kHz logarithmic bands.

    DC (byte 0) and Nyquist (byte 1) are intentionally excluded. Empty
    frequency bands and digital silence are zero; never invent an A frame.
    All inputs/results stay in memory and must never enter diagnostics.
    """
    size = len(data)
    rate = float(sampling_rate_mhz) / 1000.0
    bands = int(count)
    if (size < 4 or size > 4096 or size & (size-1) or
            not math.isfinite(rate) or not 8000 <= rate <= 384000 or
            not 1 <= bands <= 64):
        raise ValueError("unsupported FFT shape or sampling rate")
    high = min(20000.0, rate / 2.0)
    gain = (0.7, 1.0, 1.3)[int(clamp(strength, 0, 2))]
    normalizer = math.log1p(math.hypot(128.0, 128.0))
    def signed(value):
        value = int(value) & 255
        return value-256 if value >= 128 else value
    result = []
    for band in range(bands):
        low_hz = 20.0 * (high / 20.0) ** (float(band) / bands)
        high_hz = 20.0 * (high / 20.0) ** (float(band+1) / bands)
        first = max(1, int(math.ceil(low_hz * size / rate)))
        last = min(size//2-1, int(math.ceil(high_hz * size / rate))-1)
        peak = 0.0
        for k in range(first, last+1):
            peak = max(peak, math.hypot(signed(data[2*k]), signed(data[2*k+1])))
        result.append(clamp(gain * math.log1p(peak) / normalizer, 0.0, 1.0))
    return result


def spectrum_palette(color_mode, glow_color, rgb):
    if color_mode == 1: return glow_palette(7, rgb)
    if color_mode == 2: return [tuple(rgb),tuple(rgb)]
    return glow_palette(glow_color,rgb)


def render_spectrum_bitmap(side_px, margin_px, levels, style, strength, colors,
                           envelope=1.0, real_data=False, reusable=None, color_phase=0.0):
    """Small non-interactive ring composed of short bars/dots outside album rim.

    Use explicit Java int colors to avoid ColorLong overload exceptions seen on
    Android 17/Chaquopy. The glow_host parent exclusively owns X/Y motion.
    """
    side = max(64,int(side_px))
    if reusable is not None and reusable.getWidth() == side and reusable.getHeight() == side:
        image = reusable
        image.eraseColor(jint(0))  # reuse live frame; avoid allocating 60 bitmaps/second
    else:
        image = Bitmap.createBitmap(side,side,Bitmap.Config.ARGB_8888)
    cv = Canvas(image)
    paint = Paint(Paint.ANTI_ALIAS_FLAG)
    paint.setStyle(Paint.Style.STROKE)
    paint.setStrokeCap(Paint.Cap.ROUND)
    mid=side*.5
    margin=max(5.,float(margin_px))
    inner=mid-margin + margin*.18
    available=margin*.67
    bands=len(levels)
    palette=colors or [(110,185,255),(110,185,255)]
    for i,amplitude in enumerate(levels):
        angle=-math.pi*.5+2.0*math.pi*i/bands
        cosine, sine=math.cos(angle), math.sin(angle)
        height = 0.94*clamp(amplitude,0,1) if real_data else 0.22+0.72*clamp(amplitude,0,1)
        length=available*height*float(clamp(envelope,0.0,1.0))
        if length < .4: continue
        start=inner
        end=min(mid-margin*.11, start+length)
        pos=(i/max(1,bands)+color_phase)%1.0*len(palette)
        index=int(pos)
        blend=pos-index
        first,second=palette[index],palette[(index+1)%len(palette)]
        tint=tuple(a+(b-a)*blend for a,b in zip(first,second))
        paint.setColor(argb32(210,int(tint[0]),int(tint[1]),int(tint[2])))
        if style == 2:  # small dots, each bar is a series of discrete steps
            paint.setStyle(Paint.Style.FILL)
            dots=max(1,int(length/max(2.,margin*.20)))
            for k in range(dots):
                d=start+k*max(2.,margin*.21)
                cv.drawCircle(float(mid+d*cosine),float(mid+d*sine),
                              float(max(0.7,margin*.075)),paint)
            paint.setStyle(Paint.Style.STROKE)
        else:
            paint.setStrokeWidth(float(max(1.,margin*(.16 if style==0 else .075))))
            cv.drawLine(float(mid+start*cosine),float(mid+start*sine),
                        float(mid+end*cosine),float(mid+end*sine),paint)
    return image


def render_glow_bitmap(side_px, ring_px, rgb, palette=None):
    """Soft two-axis bloom and optional multi-hue sweep; NO image XY animation.

    SweepGradient supplies the angular color changes. Multiple low-alpha
    stroke rings form a soft radial envelope with no sharp neon-only outline.
    Every Paint / Shader color passes through Chaquopy jint boundaries.
    """
    size = max(12, int(side_px))
    margin = max(3.0,float(ring_px))
    image = Bitmap.createBitmap(size,size,Bitmap.Config.ARGB_8888)
    cv = Canvas(image)
    pt = Paint(Paint.ANTI_ALIAS_FLAG)
    mid=size*.5
    disc=max(4.0,mid-margin)
    red, green, blue = [int(clamp(v,0,255)) for v in rgb]
    colors = palette or [(red,green,blue),(red,green,blue)]
    positions = jarray(jfloat)([float(i/(len(colors)-1)) for i in range(len(colors))])
    sweep_colors=jarray(jint)([argb32(255,*color) for color in colors])
    shader=SweepGradient(float(mid),float(mid),sweep_colors,positions)
    pt.setStyle(Paint.Style.STROKE)
    pt.setShader(shader)
    # Layered Gaussian-like bell around disc edge. Each is transparent and
    # several overlap; one radial gradient was uniform around the circle.
    for k in range(24):
        offset=-margin*.10+(margin*1.04)*k/23.0
        gaussian=math.exp(-2.7*((offset-margin*.15)/margin)**2)
        pt.setAlpha(int(clamp(80*gaussian,0,255)))
        pt.setStrokeWidth(float(max(1.,margin*.28)))
        cv.drawCircle(float(mid),float(mid),float(disc+offset),pt)
    pt.setShader(None)
    pt.setAlpha(255)
    # Thin cold specular rim; low contrast so not a hollow hard-edged ring.
    pt.setStrokeWidth(float(max(.8,margin*.032)))
    pt.setColor(argb32(65,235,248,255))
    cv.drawCircle(float(mid),float(mid),float(disc+margin*.10),pt)
    pt.setStyle(Paint.Style.FILL)
    return image

def dp(n):
    return AndroidUtilities.dp(float(n))

def clamp(v, a, b):
    return max(a, min(b, v))

def config_int(value, fallback, low, high):
    try:
        # Forbid floats, NaN and partially numeric strings.
        v = int(str(value).strip())
        return clamp(v, low, high)
    except (ValueError, TypeError):
        return fallback

def fmt_time(n):
    try:
        n = max(0, int(n))
        return "%d:%02d" % (n // 60, n % 60)
    except (ValueError, TypeError):
        return "0:00"

def shape(fill, stroke=None, radius=99):
    bg = GradientDrawable()
    bg.setColor(jint(Color.parseColor(fill)))
    bg.setCornerRadius(float(dp(radius)))
    if stroke:
        bg.setStroke(dp(1), Color.parseColor(stroke))
    return bg

def safe_error_detail(exc):
    """Keep diagnostic API hints while masking messages, paths and identifiers."""
    msg = str(exc).replace("\n", " ").replace("\r", " ")
    msg = re.sub(r"(?i)(https?://|content://|file://)\S+", "[uri]", msg)
    msg = re.sub(r"[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}", "[email]", msg)
    msg = re.sub(r"(?:(?<=\s)|^)(?:/[^\s,:;]+)+", "[path]", msg)
    msg = re.sub(r"(?:[A-Za-z]:\\)[^\s,:;]+", "[path]", msg)
    msg = re.sub(r"['\"][^'\"]{3,}['\"]", "[quoted]", msg)
    msg = re.sub(r"\b\d{6,}\b", "[number]", msg)
    return msg[:180]

def short_stack(exc):
    """Exception names and code coordinates only. Do not include user data."""
    try:
        frames = traceback.extract_tb(exc.__traceback__)[-8:]
        return ["%s:%s:%s" % (os.path.basename(f.filename), f.name, f.lineno) for f in frames]
    except Exception:
        return []

class BallTouch(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, owner):
        super().__init__()
        self.owner = owner
    def onTouch(self, view, event):
        return self.owner.on_touch(event, view)

class SatelliteTouch(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, owner, name):
        super().__init__()
        self.owner, self.name = owner, name
    def onTouch(self, view, event):
        return self.owner._satellite_touch(view, event, self.name)

class SpeedChoiceListener(dynamic_proxy(DialogInterface.OnClickListener)):
    def __init__(self, owner, rates):
        super().__init__()
        self.owner = owner
        self.rates = rates
    def onClick(self, dialog, which):
        try:
            idx = int(which)
            if 0 <= idx < len(self.rates):
                self.owner._set_playback_speed(self.rates[idx])
        except Exception as exc:
            self.owner._failure("speed_choice", exc)


class BackupImportListener(dynamic_proxy(AlertDialog.OnButtonClickListener)):
    def __init__(self, owner, edit):
        super().__init__()
        self.owner, self.edit = owner, edit

    def onClick(self, dialog, which):
        try:
            self.owner._import_backup_text(str(self.edit.getText()))
        except Exception as exc:
            self.owner._failure("backup_import_dialog", exc)


def visible_progress_arc(x, width, radius, right=True):
    """Clockwise arc lying inside vertical screen edges, continuous at full view."""
    if radius <= 0: return -90.0,0.0
    if x-radius >= 0 and x+radius <= width: return (0.0 if right else -180.0),360.0
    if x+radius <= 0 or x-radius >= width: return -90.0,0.0
    if x < radius:
        half = math.degrees(math.acos(clamp(-x/radius,-1.0,1.0)))
        # Left visible arc, unwrapped to approach -180 smoothly as it becomes full.
        return -half,2.0*half
    cut = math.degrees(math.acos(clamp((width-x)/radius,-1.0,1.0)))
    return cut,360.0-2.0*cut


def palette_color(palette, phase):
    value = (phase%1.0)*(len(palette)-1)
    index = min(len(palette)-2,int(value))
    mix = value-index
    return tuple(int(a+(b-a)*mix) for a,b in zip(palette[index],palette[index+1]))


class DialogAction(dynamic_proxy(AlertDialog.OnButtonClickListener)):
    def __init__(self, callback):
        super().__init__()
        self.callback=callback
    def onClick(self, dialog, which): self.callback(dialog,which)


class CropCancel(dynamic_proxy(DialogInterface.OnCancelListener)):
    def __init__(self, owner):
        super().__init__()
        self.owner=owner
    def onCancel(self, dialog): self.owner._close_crop()


class CropTouch(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, owner):
        super().__init__()
        self.owner=owner
    def onTouch(self, view, event):
        try: return self.owner._crop_touch(event)
        except Exception as exc:
            self.owner._failure("crop_touch",exc)
            return True


def diagnostic_operation(method):
    @functools.wraps(method)
    def traced(self, *args, **kwargs):
        token = self._trace_begin(method.__name__)
        try:
            value = method(self, *args, **kwargs)
        except Exception as exc:
            self._failure(method.__name__,exc)
            self._trace_end(token,"raised")
            raise
        self._trace_end(token,"returned")  # API return is not proof of Android playback/render success.
        return value
    return traced


class FloatingAudioPlugin(BasePlugin):
    def on_plugin_load(self):
        if (getattr(self, "_fft_visualizer", None) is not None or
                getattr(self, "_fft_native_hook", None) is not None or
                getattr(self, "_fft_analytics_hook", None) is not None):
            self._fft_release("stopped")
        self._fft_visualizer = None
        self._fft_session = None
        self._fft_buffer = None
        self._fft_track_key = None
        self._fft_status = "simulated"
        self._fft_last_fallback_status = None
        self._fft_received_frames = 0
        self._fft_notice_at = -30.0
        self._fft_block_reason = "waiting"
        self._real_fft_levels = None
        self._fft_native_hook = None
        self._fft_native_last_values = None
        self._fft_native_at = 0.0
        self._fft_native_started = 0.0
        self._fft_native_retry_at = 0.0
        self._fft_native_want = False
        self._fft_analytics_hook = None
        self._fft_analytics_session = None
        self._fft_analytics_at = 0.0
        self._fft_analytics_retry_at = 0.0
        self._fft_32_retry_at = 0.0
        self._fft_32_diagnostic = "not_started"
        self._fft_32_last_state = None
        self._fft_32_notice_at = -30.0
        self._fft_32_frames = 0
        # Preserve monotonic generations across same-instance unload/reload.
        self._poll_generation = getattr(self, "_poll_generation", 0) + 1
        self._sleep_generation = getattr(self, "_sleep_generation", 0) + 1
        self._diagnostic_local = threading.local()
        self._log_lock = threading.RLock()
        self._operation_seq = 0
        self._log_rate = {}
        self._glow_style_cell = None
        self._glow_choice_listeners = []
        self._resume_pending = False
        self._resume_immediate = False
        self._layout_generation = getattr(self, "_layout_generation", 0) + 1
        self.alive = True
        self.backgrounded = False
        self.container = None
        self.activity = None
        self.main = None
        self.cover = None
        self.symbol = None
        self.time_text = None
        self.ripple = None
        self.small = {}
        self.small_labels = {}
        self.small_backdrops = {}
        self.small_sheens = {}
        self.small_materials = {}
        self._material_bitmaps = []
        self._material_animators = []
        self._satellite_listeners = {}
        self.main_hit = None
        self.glow = None
        self.glow_flash = None
        self.glow_host = None
        self.motion_host = None  # One shared XY parent for the entire disc assembly.
        self._last_layout_signature = None
        self._flash_animator = None
        self._glow_bitmap = None
        self._glow_bitmap_key = None
        self._glow_last_failure_time = 0.0
        self._glow_animator = None
        self._glow_color_animator = None
        self._glow_flow_speed_applied = None
        self._jelly_animators = []
        self._glow_state = None
        # Independent alpha envelope shared by every luminous child, not the
        # progress indicator. No animation should own glow_host translation.
        self.light_host = None
        self._light_envelope = 0.0
        self._light_target = 0.0
        self._light_transition_generation = 0
        self._light_fade_cleanup_pending = False
        self._glow_current_paused = True
        self.spectrum = None
        self._spectrum_generation = getattr(self, "_spectrum_generation", 0) + 1
        self._spectrum_active = False
        self._spectrum_frame = 0
        self._spectrum_frames = {}
        self._spectrum_cache_key = None
        self._spectrum_live_bitmap = None
        self._spectrum_smoothed = None
        self._spectrum_next_capture_at = 0.0
        # v0.8.8: passive progress ring, next-track notice and sleep timer.
        self.progress_ring = None
        self._wave_bitmap = None
        self._wave_shader_key = None
        self._progress_bitmap = None
        self._progress_bitmap_side = None
        self._progress_last_value = None
        self._notice_ripple = None
        self.track_notice = None
        self.track_notice_title = None
        self.track_notice_detail = None
        self._track_notice_until = 0.0
        self._track_notice_title_cache = ""
        self._track_notice_detail_cache = ""
        self._track_notice_generation = 0
        self._last_real_track_key = None
        self._last_real_track_at = 0.0
        self._last_real_observed_at = 0.0
        self._track_gap_started_at = None
        self._sleep_deadline = None
        self._sleep_track_key = None
        self._sleep_active = False
        self._sleep_gap_since = None
        self._sleep_pause_retry_at = 0.0
        self._sleep_pause_pending = False
        self._sleep_pause_accepted_key = None
        self._sleep_choice_running = None
        self._sleep_phase = "off"
        self._backup_import_listener = None
        self._menu_ready_at = 0.0
        self._blur_backdrop_bitmaps = []
        self.animator = None
        self.animating = False
        self._animation_token = 0
        self._closing_menu = False
        self.ripple = None
        self._speed_choice_listener = None
        self.expanded = False
        self.center_x = None
        self.center_y = None
        self.is_snapped = True
        self.overlay_ready = False
        self._touch_hook = None
        self._touch_hooks = []
        self._fallback_touch_hook = None
        self._fallback_touch_hooks = []
        self._touch_method_names = set()
        self._last_outside_event_ms = -1
        self._outside_gesture_start = None
        self._touch_event_seen = False
        self._touch_hook_installed_at = 0
        self._last_touch_hook_failure = False
        self._touch_probe_reported = False
        self._cover_attempts = 0
        self._pending_cover_retry = False
        self.y_fraction = 0.38
        self.right_edge = True
        self.last_audio_key = None
        self.last_cover_key = None
        self.cover_probe_at = 0
        self.cover_reported = True
        self.manual_hidden_key = None
        # This identity survives transient Telegram msg=None and Activity changes.
        self._hidden_at_monotonic = 0.0
        self.dismiss_target = None
        self._dismiss_armed = False
        self._dismiss_hover = False
        self._dismiss_gesture_generation = 0
        self._dismiss_start_mono = 0.0
        self.touch_start = None
        self._main_touch_zone = "ring"
        self.has_moved = False
        # One DOWN can complete only one gesture.  The same touch may be
        # observed by both the overlay and an Activity hook, possibly after
        # the main ball has moved from its half-hidden position.
        self._main_touch_active = False
        self._main_gesture_seq = 0
        self._main_touch_down_ms = -1
        self._main_last_down_ms = -1
        self._main_last_finish_ms = -1
        self._main_protect_until = 0.0
        self._last_guard_log_seq = -1
        self.last_interaction = time.monotonic()
        self.last_page = None
        self._settings_hint_until = 0.0
        self._settings_preview_until = 0.0  # retired; never enabled
        self.last_paused = None
        self._real_audio_present = False
        # Short-lived UI intent for asynchronous Telegram pause/play updates.
        # Prevent stale MediaController state from relighting the halo during
        # the tick immediately after a pause tap, or misrouting rapid taps.
        self._requested_paused = None
        self._requested_paused_deadline = 0.0
        self.last_progress_minute = None
        self._last_health = 0
        self.log_dir = None
        self._event_seq = 0
        try:
            self.right_edge = self.get_setting("edge", "right") != "left"
            self.y_fraction = float(self.get_setting("y_fraction", "0.38"))
            self.y_fraction = clamp(self.y_fraction, 0.12, 0.88)
        except Exception:
            self.y_fraction = 0.38
        try:
            self.log_dir = os.path.join(get_files_dir(), "floating_audio_diagnostics")
            ensure_dir_exists(self.log_dir)
        except Exception as exc:
            self.logger.error("Diagnostic storage unavailable (%s)", type(exc).__name__)
        # Persistent one-time migration. Old 4/5/7/8 were fan/cascade/fade/
        # jelly; never let them silently select the wrong new animation.
        try:
            if not self.get_setting("animation_migration_v085", False):
                old = config_int(self.get_setting("animation_style", 2),2,0,8)
                new = migrate_animation_choice(old)
                self.set_setting("animation_style", new)
                self.set_setting("animation_migration_v085", True)
                self._record("animation_migration", result="ok", setting="animation_style", value=str(new))
        except Exception as exc:
            self._failure("animation_migration", exc)
        self._record("plugin_loaded", version=__version__, enabled=True)
        self._install_plugin_icon()
        generation = self._poll_generation
        # A running timer never survives plugin reload; prevent a stale ON switch.
        self._sync_sleep_settings()
        run_on_ui_thread(lambda: self._tick(generation), 450)

    def on_plugin_unload(self):
        self._release_plugin_icon()
        self._picker_pending = False
        self._release_cover_picker()
        run_on_ui_thread(self._close_crop)
        self._flush_fft_idle_releases()
        self._glow_style_cell = None
        self._glow_choice_listeners = []
        self._record("plugin_unloaded", version=__version__)
        self.alive = False
        self._fft_release("stopped")
        self._poll_generation = getattr(self, "_poll_generation", 0) + 1
        self._clear_sleep_timer(sync=False)
        self._sync_sleep_settings()
        run_on_ui_thread(self._remove_overlay)

    @diagnostic_operation
    def on_app_event(self, event_type: AppEvent):
        # SDK variants differ: do not assume AppEvent.RESUME is available.
        tag = str(event_type)
        if event_type in (AppEvent.STOP, AppEvent.PAUSE):
            self.backgrounded = True
            self._record("app_background", status="background")
            run_on_ui_thread(self._suspend_overlay)
        elif "START" in tag or "RESUME" in tag:
            self.backgrounded = False
            self._record("app_foreground", status="foreground")
            run_on_ui_thread(self._sync_sleep_settings)
            self._foreground_at = time.monotonic()
            run_on_ui_thread(self._resume_overlay)

    @diagnostic_operation
    def _install_plugin_icon(self):
        # Metadata accepts sticker-pack/index only. This local, narrowly scoped
        # binding hook supplies our artwork while this plugin is enabled.
        self._plugin_icon_hooks = []
        self._plugin_icon_bitmap = None
        self._plugin_icon_status = "unsupported"
        try:
            cls = find_class("com.exteragram.messenger.plugins.ui.components.PluginCell")
            if cls is None:
                self._plugin_icon_status = "class_unavailable"
                self._record("plugin_icon", result=self._plugin_icon_status)
                return
            # find_class returns a Chaquopy Java class wrapper, not java.lang.Class.
            # Chaquopy's documented equivalent of Foo.class is Foo.getClass().
            reflected = cls.getClass()
            for method in reflected.getDeclaredMethods():
                parameters = [str(t.getName()) for t in method.getParameterTypes()]
                if "com.exteragram.messenger.plugins.Plugin" not in parameters: continue
                method.setAccessible(True)
                hook = self.hook_method(method, after=self._bind_plugin_icon)
                self._plugin_icon_hooks.append(hook)
            self._plugin_icon_status = "hook_installed" if self._plugin_icon_hooks else "unsupported"
            self._record("plugin_icon", result=self._plugin_icon_status, count=len(self._plugin_icon_hooks))
        except Exception as exc:
            self._plugin_icon_status = "install_failed"
            self._failure("plugin_icon_install",exc)

    def _bind_plugin_icon(self, param):
        if not self.alive: return
        try:
            plugin = None
            for arg in param.args:
                if arg is not None and hasattr(arg,"getClass") and str(arg.getClass().getName()) == "com.exteragram.messenger.plugins.Plugin":
                    plugin = arg
                    break
            # Exact internal ID only. Never modify another plugin's card by title.
            if plugin is None or str(plugin.getId()) != __id__: return
            cell = param.thisObject
            cls = cell.getClass()
            icon = None
            while cls is not None and icon is None:
                for field in cls.getDeclaredFields():
                    if str(field.getType().getName()) == "org.telegram.ui.Components.BackupImageView":
                        field.setAccessible(True)
                        candidate = field.get(cell)
                        if candidate is not None:
                            icon = candidate
                            break
                cls = cls.getSuperclass()
            if icon is None:
                self._plugin_icon_status = "image_view_unavailable"
                self._record("plugin_icon", result="image_view_unavailable")
                return
            if self._plugin_icon_bitmap is None:
                self._plugin_icon_bitmap = self._make_plugin_icon()
            icon.getImageReceiver().cancelLoadImage()
            icon.setImageBitmap(self._plugin_icon_bitmap)
            self._plugin_icon_status = "bound"
            self._record("plugin_icon", result="bound", width_px=256, height_px=256)
        except Exception as exc:
            self._plugin_icon_status = "bind_failed"
            self._failure("plugin_icon_bind",exc)

    def _make_plugin_icon(self):
        size = 256
        bmp = Bitmap.createBitmap(size,size,Bitmap.Config.ARGB_8888)
        canvas = Canvas(bmp)
        paint = Paint(Paint.ANTI_ALIAS_FLAG)
        paint.setShader(LinearGradient(0.0,0.0,256.0,256.0,
            argb32(255,29,62,108),argb32(255,5,14,32),Shader.TileMode.CLAMP))
        canvas.drawRoundRect(RectF(0.0,0.0,256.0,256.0),48.0,48.0,paint)
        paint.setShader(None)
        paint.setStyle(Paint.Style.STROKE)
        for radius in range(121,105,-1):
            paint.setStrokeWidth(3.0)
            paint.setColor(argb32(int(3+(121-radius)*2.1),91,164,255))
            canvas.drawCircle(128.0,128.0,float(radius),paint)
        paint.setStyle(Paint.Style.FILL)
        colors = [(8,12,19),(17,22,30),(64,72,84),(13,17,23),
                  (8,12,19),(17,22,30),(64,72,84),(13,17,23),(8,12,19)]
        paint.setShader(SweepGradient(128.0,128.0,
            jarray(jint)([argb32(255,*c) for c in colors]),
            jarray(jfloat)([float(i/8) for i in range(9)])))
        canvas.drawCircle(128.0,128.0,106.0,paint)
        paint.setShader(None)
        paint.setStyle(Paint.Style.STROKE)
        paint.setStrokeWidth(.5)
        paint.setColor(argb32(25,136,157,184))
        for radius in range(43,102,2):
            canvas.drawCircle(128.0,128.0,float(radius),paint)
        paint.setStrokeWidth(2.0)
        paint.setColor(argb32(255,165,218,255))
        canvas.drawCircle(128.0,128.0,106.0,paint)
        for radius in range(40,32,-1):
            paint.setStrokeWidth(2.0)
            paint.setColor(argb32(int(5+(40-radius)*4),90,171,255))
            canvas.drawCircle(128.0,128.0,float(radius),paint)
        paint.setStyle(Paint.Style.FILL)
        paint.setShader(LinearGradient(105.0,98.0,152.0,159.0,
            argb32(255,176,220,255),argb32(255,65,147,231),Shader.TileMode.CLAMP))
        canvas.drawCircle(128.0,128.0,33.0,paint)
        paint.setShader(None)
        paint.setColor(argb32(255,10,20,34))
        canvas.drawCircle(128.0,128.0,5.5,paint)
        return bmp

    def _release_plugin_icon(self):
        for hook in getattr(self,"_plugin_icon_hooks",[]):
            if hook is not None:
                try: hook.unhook()
                except Exception: pass
        self._plugin_icon_hooks = []
        self._plugin_icon_bitmap = None

    def _suspend_overlay(self):
        if not self.backgrounded or not self.alive: return
        self._close_playlist(immediate=True)
        self._layout_generation = getattr(self,"_layout_generation",0)+1
        self._arc_generation = getattr(self,"_arc_generation",0)+1
        self._notice_generation = getattr(self,"_notice_generation",0)+1
        self._light_transition_generation += 1
        self._fft_release("background")
        self._stop_spectrum()
        self._stop_color_flow()
        self._stop_material_dynamics()
        self._stop_visual_animations()
        self._cancel_dismiss_ui()
        self._main_touch_active = False
        self.touch_start = None
        self._spin(False)
        if self._glow_animator is not None:
            self._glow_animator.cancel()
            self._glow_animator = None
        if self.track_notice is not None:
            self.track_notice.animate().cancel()
            self.track_notice.setVisibility(View.GONE)
        if self._notice_ripple is not None: self._notice_ripple.animate().cancel()
        self._notice_shown = False
        self._glow_state = None
        self._last_layout_signature = None
        # Activity-owned views are already hidden by Android with their window.
        # Keep their final bitmap, placement and cover instead of blanking/rebuilding.
        if self.container is not None:
            self._relayout()
        self._record("overlay_suspended", reused=self.container is not None, result="retained")

    @diagnostic_operation
    def _resume_overlay(self):
        if not self.alive or self.backgrounded: return
        self._resume_pending = True
        self._resume_immediate = True
        self._resume_reused = False
        try:
            activity = self._get_activity()
            self._resume_reused = bool(self.container is not None and activity == self.activity
                and self.container.getParent() == activity.getWindow().getDecorView())
            self._glow_state = None
            self._last_layout_signature = None
            self._refresh()
            if self.expanded and self.container is not None:
                self._start_material_dynamics()
            if self.container is not None and not self.overlay_ready:
                self._layout_generation = getattr(self,"_layout_generation",0)+1
                token = self._layout_generation
                self._begin_layout_wait(token)
        except Exception as exc:
            self._failure("foreground_resume",exc)
        finally:
            self._resume_immediate = False

    def _begin_layout_wait(self, token):
        started = time.monotonic()
        self._record("layout_wait", result="scheduled", count=token)
        run_on_ui_thread(lambda:self._wait_for_layout(token,0,started),16)

    def _wait_for_layout(self, token, attempt, started):
        elapsed = int((time.monotonic()-started)*1000)
        reason = None
        if token != getattr(self,"_layout_generation",0):
            reason = "superseded"
        elif not self.alive:
            reason = "unloaded"
        elif self.backgrounded:
            reason = "background"
        elif self.container is None:
            reason = "no_container"
        if reason:
            self._record("layout_wait", result="cancelled", reason=reason,
                         elapsed_ms=elapsed, count=token, attempt=attempt+1)
            return
        width, height = self.container.getWidth(), self.container.getHeight()
        ready = width > dp(120) and height > dp(150)
        if not ready and attempt < 60:
            run_on_ui_thread(lambda:self._wait_for_layout(token,attempt+1,started),16)
            return
        self._record("layout_wait", result="size_ready" if ready else "timeout",
                     width_px=width, height_px=height, elapsed_ms=elapsed,
                     count=token, attempt=attempt+1)
        if ready:
            self._resume_immediate = bool(getattr(self,"_resume_pending",False))
            try: self._refresh()
            finally: self._resume_immediate = False

    def _animate_playlist(self, opening):
        panel = getattr(self,"_playlist_panel",None)
        if panel is None: return 0
        kind = self._animation_kind()
        duration = self._animation_duration() if kind else 0
        scale = .96 if kind == 5 else (.76 if kind == 6 else .88)
        shift = float(dp(4 if kind == 5 else 22)*(-1 if self.right_edge else 1))
        rotation = float(7 if self.right_edge else -7) if kind == 3 else 0.0
        panel.animate().cancel()
        panel.setPivotX(float(getattr(self,"_playlist_width",dp(304)) if self.right_edge else 0))
        panel.setPivotY(float(getattr(self,"_playlist_height",dp(400))/2))
        if opening:
            panel.setAlpha(0.0 if kind else 1.0)
            panel.setScaleX(scale if kind else 1.0)
            panel.setScaleY(scale if kind else 1.0)
            panel.setTranslationX(shift if kind else 0.0)
            panel.setRotation(rotation)
        panel.animate().alpha(1.0 if opening else 0.0).scaleX(1.0 if opening else scale).scaleY(
            1.0 if opening else scale).translationX(0.0 if opening else shift).rotation(
            0.0 if opening else rotation).setStartDelay(0).setDuration(duration).setInterpolator(
            OvershootInterpolator(1.1) if opening and kind in (4,6) else DecelerateInterpolator()).start()
        wave = getattr(self,"_playlist_wave",None)
        if wave is not None:
            wave.animate().cancel()
            wave.setVisibility(View.GONE)
            if kind == 2 and opening:
                wave.setVisibility(View.VISIBLE)
                wave.setAlpha(.65)
                wave.setScaleX(.85)
                wave.setScaleY(.85)
                wave.animate().alpha(0.0).scaleX(1.12).scaleY(1.12).setDuration(duration).start()
        self._record("playlist_animation", stage="open" if opening else "close", style=str(kind), duration_ms=duration)
        return duration

    def _verify_media_command(self, action, expected=None):
        generations = getattr(self,"_media_verify_generation",{})
        token = generations.get(action,0)+1
        generations[action] = token
        self._media_verify_generation = generations
        stack = getattr(getattr(self,"_diagnostic_local",None),"stack",[])
        operation = stack[-1][0] if stack else 0
        started = time.monotonic()
        track = self._internal_audio_key(self._playing_message())
        def verify(attempt=0):
            if not self.alive or token != self._media_verify_generation.get(action): return
            try:
                mc = get_media_controller()
                msg = self._playing_message()
                same = self._internal_audio_key(msg) == track
                if action == "pause":
                    matched = msg is not None and same and bool(mc.isMessagePaused()) == bool(expected)
                elif action == "speed":
                    matched = msg is not None and same and abs(float(mc.getPlaybackSpeed(bool(msg.isMusic())))-expected)<.0005
                elif action == "seek":
                    matched = msg is not None and same and abs(float(msg.audioProgressSec)-expected)<4
                else:
                    matched = msg is not None and not same
                if not same and action in ("pause", "speed", "seek"):
                    self._record("media_observed", action=action, operation_id=operation,
                                 result="superseded", reason="track_changed", attempt=attempt+1,
                                 elapsed_ms=int((time.monotonic()-started)*1000))
                    return
                self._record("media_observed", action=action, operation_id=operation,
                             result="matched" if matched else "waiting" if attempt<2 else "not_confirmed",
                             attempt=attempt+1, elapsed_ms=int((time.monotonic()-started)*1000))
                if not matched and attempt<2:
                    run_on_ui_thread(lambda:verify(attempt+1),500 if attempt==0 else 1000)
            except Exception as exc: self._failure("media_verify",exc)
        run_on_ui_thread(verify,200)

    def _trace_begin(self, stage):
        local = getattr(self,"_diagnostic_local",None)
        if local is None:
            self._diagnostic_local = local = threading.local()
        if not hasattr(self,"_log_lock"): self._log_lock = threading.RLock()
        with self._log_lock:
            self._operation_seq = getattr(self,"_operation_seq",0)+1
            operation = self._operation_seq
        stack = getattr(local,"stack",[])
        parent = stack[-1][0] if stack else 0
        token = (operation, time.monotonic(), stage)
        local.stack = stack + [token]
        self._record("operation", stage=stage, result="entered", operation_id=operation, parent_id=parent)
        return token

    def _trace_end(self, token, result):
        if token is None: return
        self._record("operation", stage=token[2], result=result, operation_id=token[0],
                     elapsed_ms=int((time.monotonic()-token[1])*1000))
        local = self._diagnostic_local
        local.stack = [item for item in getattr(local,"stack",[]) if item is not token]

    def _diagnostic_sample(self, stage, **fields):
        self._record("sample", stage=stage, **fields)

    def _changed_callback(self, key):
        return lambda value: self._setting_changed(key, value)

    def _settings_entry(self, title, subtitle, callback, *icons):
        # Resolve on the installed host; never hand an unknown resource to SDK.
        kwargs = dict(text=title, create_sub_fragment=callback)
        try:
            drawables = find_class("org.telegram.messenger.R$drawable")
            for name in icons:
                if int(getattr(drawables, name, 0)):
                    kwargs["icon"] = name
                    break
        except Exception:
            pass  # A clean text row is preferable to an unrelated icon.
        return Text(**kwargs)

    @diagnostic_operation
    def create_settings(self) -> List[Any]:
        self._settings_hint_until = time.monotonic()+1.8
        entry = self._settings_entry
        return [
            Header(text="悬浮音频圆盘"),
            Switch(key="enabled", text="启用悬浮圆盘", default=True,
                   on_change=self._changed_callback("enabled")),
            Divider(text="音乐控制、封面与光效 · v" + __version__),
            Header(text="分类"),
            entry("操作", "", self._settings_controls, "msg_select"),
            entry("外观", "", self._settings_appearance, "msg_theme"),
            entry("播放", "", self._settings_playback, "msg_played"),
            entry("律动频谱", "", self._settings_spectrum, "msg_stats"),
            Divider(text="律动频谱为实验功能，单独设置。"),
            Header(text="测试"),
            entry("播放目录", "", self._settings_test, "msg_list"),
            Header(text="管理"),
            entry("日志与诊断", "", self._settings_audio_diagnostics, "msg_info"),
            entry("高级设置", "", self._settings_advanced, "msg_settings"),
            entry("设置备份", "", self._settings_backup, "msg_saved"),
        ]

    def _settings_controls(self):
        e = self._settings_entry
        return [Header(text="操作"),
                e("圆盘与触摸", "", self._settings_disc, "msg_select"),
                e("快捷按钮", "", self._settings_buttons, "msg_folders"),
                e("贴边与收起", "", self._settings_snapping, "msg_pin"),
                Divider(text="调整点击方式、四向按钮和自动收起行为。")]

    def _settings_appearance(self):
        e = self._settings_entry
        return [Header(text="外观"),
                e("圆盘与按钮", "", self._settings_material, "msg_theme"),
                e("默认封面", "", self._settings_cover, "msg_gallery"),
                e("光环与流光", "", self._settings_glow, "msg_fave"),
                e("交互动画", "", self._settings_animation, "msg_played")]

    def _settings_playback(self):
        e = self._settings_entry
        return [Header(text="播放"),
                e("播放速度", "", self._settings_speed, "msg_speed", "msg_played"),
                e("睡眠定时器", "", self._settings_sleep, "msg_stories_timer"),
                e("歌曲提示", "", self._settings_song, "files_music", "msg_notifications")]

    def _settings_test(self):
        self._settings_hint_until = time.monotonic()+1.8
        return [Header(text="播放目录"),
                Text(text="打开播放目录", on_click=lambda *a: run_on_ui_thread(self._toggle_playlist)),
                self._settings_entry("设置目录快捷键", "", self._settings_buttons, "msg_folders"),
                Divider(text="先播放一条音频，即可查看播放器当前加载的队列。点击条目切换播放；不扫描手机文件。")]

    def _settings_cover(self):
        return [Header(text="默认封面"),
                Text(text="选择图片", on_click=lambda *a: run_on_ui_thread(self._choose_default_art)),
                Text(text="恢复音符图标", on_click=lambda *a: run_on_ui_thread(self._reset_default_art)),
                Divider(text="音频没有封面时，使用你选择并裁剪的图片；未设置时显示音符。原音频封面优先。")]

    def _playlist_is_open(self):
        try: return self._playlist_popup is not None and bool(self._playlist_popup.isShowing())
        except Exception: return False

    @diagnostic_operation
    def _close_playlist(self, immediate=False):
        popup = getattr(self,"_playlist_popup",None)
        if popup is None: return
        if getattr(self,"_playlist_closing",False) and not immediate: return
        self._playlist_generation = getattr(self,"_playlist_generation",0)+1
        token = self._playlist_generation
        self._playlist_closing = True
        duration = 0 if immediate else self._animate_playlist(False)
        def finish():
            if token != self._playlist_generation or self._playlist_popup is not popup: return
            self._playlist_popup = None
            self._playlist_closing = False
            self._playlist_rows = []
            self._playlist_signature = None
            self._playlist_body = None
            self._playlist_title = None
            self._playlist_scroll = None
            self._playlist_panel = None
            self._playlist_wave = None
            try: popup.dismiss()
            except Exception as exc: self._failure("playlist_dismiss",exc)
            self.last_interaction = time.monotonic()
            self._record("playlist_closed", result="dismissed")
        if duration: run_on_ui_thread(finish,duration+20)
        else: finish()

    def _playlist_messages(self):
        current = self._playing_message()
        if current is None: return []
        # Voice messages have a separate queue; don't display a stale music list.
        try:
            if not current.isMusic(): return [current]
        except Exception: pass
        items = []
        try:
            queue = get_media_controller().getPlaylist()
            for i in range(int(queue.size())):
                item = queue.get(i)
                if item is not None: items.append(item)
        except Exception as exc:
            self._failure("playlist_read", exc)
        key = self._internal_audio_key(current)
        if not any(self._internal_audio_key(m) == key for m in items):
            # Saved-profile music and forks may expose a different queue.
            return [current]
        try:
            mc = get_media_controller()
            shared = find_class("org.telegram.messenger.SharedConfig")
            reversed_order = bool(shared.playOrderReversed)
            saved = getattr(mc,"currentSavedMusicList",None) is not None
            direct = not reversed_order if saved else reversed_order
            if not direct: items.reverse()
        except Exception: pass
        return items

    @diagnostic_operation
    def _playlist_load_more(self, view=None):
        try:
            get_media_controller().loadMoreMusic()
            self._show_info("已请求播放器加载更多；目录会自动刷新")
        except Exception as exc:
            self._failure("playlist_load_more",exc)
            self._show_info("当前客户端请通过完整播放器加载更多")

    def _playlist_text(self, activity, value, size=14, color="#F3F2FA"):
        view = TextView(activity)
        view.setText(str(value))
        view.setTextSize(float(size))
        view.setTextColor(Color.parseColor(color))
        view.setGravity(Gravity.CENTER_VERTICAL)
        view.setSingleLine(True)
        view.setEllipsize(TextUtils.TruncateAt.END)
        return view

    @diagnostic_operation
    def _toggle_playlist(self):
        if getattr(self,"_playlist_closing",False): self._close_playlist(immediate=True)
        if self._playlist_is_open():
            self._close_playlist()
            return
        self._close_playlist()
        activity = self._get_activity()
        if activity is None: return
        if self._playing_message() is None:
            self._show_info("请先播放一条音频，再打开目录")
            return
        try:
            decor = activity.getWindow().getDecorView()
            from android.graphics import Rect
            bounds = Rect()
            decor.getWindowVisibleDisplayFrame(bounds)
            width = min(dp(304), max(dp(160), bounds.width()-dp(24)))
            height = min(dp(400), max(dp(100), bounds.height()-dp(32)))
            root = LinearLayout(activity)
            root.setOrientation(LinearLayout.VERTICAL)
            root.setPadding(dp(12), dp(8), dp(12), dp(8))
            root.setBackground(shape("#F528293B", "#665F678B", 22))
            header = LinearLayout(activity)
            title = self._playlist_text(activity, "播放目录", 17)
            header.addView(title, LinearLayout.LayoutParams(0, dp(44), 1.0))
            close = self._playlist_text(activity, "×", 26, "#B3B8D2")
            close.setGravity(Gravity.CENTER)
            close.setContentDescription("关闭播放目录")
            close.setOnClickListener(OnClickListener(lambda v: self._close_playlist()))
            header.addView(close, LinearLayout.LayoutParams(dp(44), dp(44)))
            root.addView(header)
            scroll = ScrollView(activity)
            scroll.setFillViewport(False)
            body = LinearLayout(activity)
            body.setOrientation(LinearLayout.VERTICAL)
            scroll.addView(body)
            root.addView(scroll, LinearLayout.LayoutParams(-1, 0, 1.0))
            footer = self._playlist_text(activity, "打开完整播放器  ›", 14, "#A9B8FF")
            footer.setGravity(Gravity.CENTER)
            footer.setOnClickListener(OnClickListener(lambda v: self._open_native_player()))
            root.addView(footer, LinearLayout.LayoutParams(-1, dp(44)))
            panel = FrameLayout(activity)
            panel.addView(root,FrameLayout.LayoutParams(-1,-1))
            wave = View(activity)
            wave.setClickable(False)
            wave.setBackground(shape("#0028293B", "#889AB9F7", 22))
            wave.setVisibility(View.GONE)
            panel.addView(wave,FrameLayout.LayoutParams(-1,-1))
            popup = PopupWindow(panel, width, height, True)
            popup.setAnimationStyle(0)
            self._playlist_panel = panel
            self._playlist_wave = wave
            self._playlist_width, self._playlist_height = width, height
            self._playlist_closing = False
            popup.setBackgroundDrawable(shape("#0028293B", radius=22))
            popup.setOutsideTouchable(True)
            popup.setElevation(float(dp(12)))
            popup.setInputMethodMode(PopupWindow.INPUT_METHOD_NOT_NEEDED)
            self._playlist_popup = popup
            self._playlist_body = body
            self._playlist_scroll = scroll
            self._playlist_title = title
            self._playlist_page = 0
            self._playlist_signature = None
            self._render_playlist(initial=True)
            x = bounds.right-width-dp(12)
            y = bounds.top+(bounds.height()-height)//2
            main = getattr(self, "main", None)
            if main is not None and main.isShown():
                xy = jarray(jint)([0, 0])
                main.getLocationOnScreen(xy)
                cx = int(xy[0])+main.getWidth()//2
                x = int(xy[0])-width-dp(10) if cx > bounds.centerX() else int(xy[0])+main.getWidth()+dp(10)
                y = int(xy[1])+main.getHeight()//2-height//2
            x = max(bounds.left+dp(8), min(x, bounds.right-width-dp(8)))
            y = max(bounds.top+dp(8), min(y, bounds.bottom-height-dp(8)))
            popup.showAtLocation(decor, Gravity.TOP | Gravity.LEFT, x, y)
            self._animate_playlist(True)
            self._playlist_watch(popup)
        except Exception as exc:
            self._failure("playlist_open", exc)
            self._close_playlist()
            BulletinHelper.show_error("目录暂时无法打开，请导出诊断日志")

    def _render_playlist(self, initial=False):
        items = self._playlist_messages()
        key = self._internal_audio_key(self._playing_message())
        signature = tuple(self._internal_audio_key(m) for m in items)
        body = self._playlist_body
        if body is None: return
        current_index = next((i for i,m in enumerate(items) if self._internal_audio_key(m)==key), 0)
        # Bound native views and image requests; every queue item remains accessible.
        if initial: self._playlist_page = current_index//50
        page = min(getattr(self, "_playlist_page", 0), max(0, (len(items)-1)//50))
        start = page*50
        rebuild = (signature, page) != getattr(self, "_playlist_signature", None)
        if rebuild:
            self._playlist_signature = (signature, page)
            body.removeAllViews()
            self._playlist_rows = []
            activity = self._get_activity()
            self._playlist_title.setText("播放目录 · %d" % len(items))
            for item in items[start:start+50]:
                row = LinearLayout(activity)
                row.setGravity(Gravity.CENTER_VERTICAL)
                row.setPadding(dp(8), dp(7), dp(8), dp(7))
                art = BackupImageView(activity)
                art.setRoundRadius(dp(11))
                self._load_audio_art(art, item)
                row.addView(art, LinearLayout.LayoutParams(dp(42), dp(42)))
                labels = LinearLayout(activity)
                labels.setOrientation(LinearLayout.VERTICAL)
                labels.setPadding(dp(10), 0, dp(4), 0)
                title, desc = self._song_label(item)
                tv = self._playlist_text(activity, title, 14)
                subtitle = self._playlist_text(activity, desc, 11, "#A4A9BF")
                labels.addView(tv, LinearLayout.LayoutParams(-1, dp(23)))
                labels.addView(subtitle, LinearLayout.LayoutParams(-1, dp(19)))
                row.addView(labels, LinearLayout.LayoutParams(0, -2, 1.0))
                marker = self._playlist_text(activity, "", 12, "#ADBAFF")
                row.addView(marker, LinearLayout.LayoutParams(dp(28), dp(36)))
                row.setOnClickListener(OnClickListener(lambda v,m=item: self._playlist_play(m)))
                body.addView(row, LinearLayout.LayoutParams(-1, dp(62)))
                self._playlist_rows.append((self._internal_audio_key(item),row,tv,marker))
            if len(items)>50:
                nav = LinearLayout(activity)
                for label, target in (("‹ 上一页",page-1),("下一页 ›",page+1)):
                    button = self._playlist_text(activity,label,13,"#ADBAFF")
                    button.setGravity(Gravity.CENTER)
                    valid = 0 <= target <= (len(items)-1)//50
                    button.setEnabled(valid)
                    button.setAlpha(1.0 if valid else .3)
                    button.setOnClickListener(OnClickListener(lambda v,p=target:self._playlist_change_page(p)))
                    nav.addView(button, LinearLayout.LayoutParams(0, dp(44), 1.0))
                body.addView(nav)
            more = self._playlist_text(activity,"加载更多音频",13,"#ADBAFF")
            more.setGravity(Gravity.CENTER)
            more.setOnClickListener(OnClickListener(self._playlist_load_more))
            body.addView(more,LinearLayout.LayoutParams(-1,dp(44)))
        try: paused = bool(get_media_controller().isMessagePaused())
        except Exception: paused = True
        for item_key,row,title,marker in self._playlist_rows:
            active = item_key==key
            row.setBackground(shape("#FF3C4261" if active else "#0028293B", radius=12))
            title.setTextColor(Color.parseColor("#C7D2FF" if active else "#F3F2FA"))
            try: downloading = active and bool(get_media_controller().isDownloadingCurrentMessage())
            except Exception: downloading = False
            marker.setText(("↓" if downloading else "Ⅱ" if paused else "♫") if active else "")
        if initial and self._playlist_scroll is not None:
            scroll = self._playlist_scroll
            run_on_ui_thread(lambda: scroll.scrollTo(0,dp(max(0,current_index-start-1)*62)),80)

    @diagnostic_operation
    def _playlist_change_page(self, page):
        self._playlist_page = max(0,page)
        self._render_playlist()
        self._playlist_scroll.scrollTo(0,0)

    def _playlist_watch(self, popup):
        if getattr(self,"_playlist_popup",None) is not popup or getattr(self,"_playlist_closing",False): return
        if not self.alive or not popup.isShowing():
            self._close_playlist(immediate=True)
            return
        try: self._render_playlist()
        except Exception as exc:
            self._failure("playlist_refresh",exc)
            self._close_playlist()
            return
        run_on_ui_thread(lambda:self._playlist_watch(popup),850)

    @diagnostic_operation
    def _playlist_play(self, message):
        try:
            key = self._internal_audio_key(message)
            # Re-resolve after queue updates; never play a stale detached row.
            current = self._playing_message()
            if self._internal_audio_key(current)==key:
                self._toggle_play()
            else:
                item = next((m for m in self._playlist_messages() if self._internal_audio_key(m)==key),None)
                if item is None:
                    self._show_info("队列已更新，请重新选择")
                    self._render_playlist()
                    return
                self._verify_media_command("playlist")
                accepted = bool(get_media_controller().findMessageInPlaylistAndPlay(item))
                self._record("playlist_play_request", result="accepted" if accepted else "rejected")
                if not accepted:
                    BulletinHelper.show_error("此音频暂时无法播放")
            self.last_interaction = time.monotonic()
            self._render_playlist()
        except Exception as exc:
            self._failure("playlist_play",exc)
            BulletinHelper.show_error("切换失败，请导出诊断日志")

    @diagnostic_operation
    def _open_native_player(self):
        try:
            from org.telegram.ui.Components import AudioPlayerAlert
            activity = self._get_activity()
            self._close_playlist()
            AudioPlayerAlert(activity, None).show()
        except Exception as exc:
            self._failure("playlist_native",exc)
            BulletinHelper.show_error("无法打开原生播放器")

    def _default_art_path(self):
        folder = os.path.join(get_files_dir(), "floating_audio_assets")
        ensure_dir_exists(folder)
        return os.path.join(folder, "default_cover.png")

    def _default_art_drawable(self, activity):
        from android.graphics import BitmapFactory
        bitmap = getattr(self, "_default_art_bitmap", None)
        if bitmap is None:
            path = self._default_art_path()
            if os.path.isfile(path): bitmap = BitmapFactory.decodeFile(path)
            if bitmap is None:
                bitmap = Bitmap.createBitmap(128,128,Bitmap.Config.ARGB_8888)
                canvas = Canvas(bitmap)
                paint = Paint(Paint.ANTI_ALIAS_FLAG)
                paint.setColor(argb32(255,43,48,73))
                canvas.drawRect(0.0,0.0,128.0,128.0,paint)
                paint.setColor(argb32(255,178,193,255))
                paint.setStrokeWidth(7.0)
                paint.setStrokeCap(Paint.Cap.ROUND)
                canvas.drawLine(53.0,83.0,53.0,42.0,paint)
                canvas.drawLine(87.0,75.0,87.0,34.0,paint)
                canvas.drawLine(53.0,42.0,87.0,34.0,paint)
                canvas.drawOval(RectF(31.0,76.0,56.0,94.0),paint)
                canvas.drawOval(RectF(65.0,68.0,90.0,86.0),paint)
            self._default_art_bitmap = bitmap
        return BitmapDrawable(activity.getResources(),bitmap)

    def _load_audio_art(self, view, message):
        try:
            placeholder = self._default_art_drawable(view.getContext())
            view.clearImage()
            view.setImageDrawable(placeholder)
            if message is None: return
            quality = config_int(self.get_setting("cover_quality","320"),320,128,512)
            doc = message.getDocument()
            if doc is not None and doc.thumbs is not None and int(doc.thumbs.size()):
                thumb = FileLoader.getClosestPhotoSizeWithSize(doc.thumbs,quality)
                if thumb is not None:
                    location = ImageLocation.getForDocument(thumb,doc)
                    if location is not None:
                        view.setImage(location,"%d_%d"%(quality,quality),placeholder,0,message)
                        return
            url = message.getArtworkUrl(True)
            if url: view.setImage(str(url),"%d_%d"%(quality,quality),placeholder)
        except Exception as exc:
            self._failure("audio_art",exc)

    def _art_changed(self):
        self._default_art_bitmap = None
        self.last_cover_key = None
        self._close_playlist()
        self._cover_update(self._playing_message())

    @diagnostic_operation
    def _reset_default_art(self):
        if getattr(self,"_art_importing",False):
            self._show_info("图片正在处理，请稍候")
            return
        try:
            path = self._default_art_path()
            if os.path.isfile(path): os.remove(path)
            self._art_changed()
            self._show_info("已恢复默认音符图标")
        except Exception as exc:
            self._failure("default_art_reset",exc)
            BulletinHelper.show_error("恢复失败，请导出诊断日志")

    def _release_cover_picker(self):
        hook = getattr(self,"_cover_picker_hook",None)
        self._cover_picker_hook = None
        if hook is not None:
            try: hook.unhook()
            except Exception: pass

    @diagnostic_operation
    def _choose_default_art(self):
        if getattr(self,"_art_importing",False) or getattr(self,"_picker_pending",False): return
        try:
            activity = self._get_activity()
            if activity is None: return
            if getattr(self,"_cover_picker_hook",None) is None:
                cursor = activity.getClass()
                method = None
                for _ in range(16):
                    if cursor is None: break
                    for candidate in cursor.getDeclaredMethods():
                        if str(candidate.getName())=="onActivityResult" and len(candidate.getParameterTypes())==3:
                            method = candidate
                            break
                    if method is not None: break
                    cursor = cursor.getSuperclass()
                if method is None: raise RuntimeError("activity_result_unavailable")
                method.setAccessible(True)
                self._cover_picker_hook = self.hook_method(method,after=self._cover_picker_result)
            self._picker_pending = True
            intent = Intent(Intent.ACTION_OPEN_DOCUMENT)
            intent.addCategory(Intent.CATEGORY_OPENABLE)
            intent.setType("image/*")
            activity.startActivityForResult(intent,58321)
        except Exception as exc:
            self._picker_pending = False
            self._release_cover_picker()
            self._failure("default_art_picker",exc)
            BulletinHelper.show_error("无法打开图片选择器，请导出诊断日志")

    @diagnostic_operation
    def _cover_picker_result(self,param):
        if not getattr(self,"_picker_pending",False) or not self.alive: return
        if int(param.args[0])!=58321: return
        self._picker_pending = False
        if int(param.args[1]) != Activity.RESULT_OK:
            result = "cancelled" if int(param.args[1]) == 0 else "unexpected_result"
            self._record("cover_picker_result", result=result)
            return
        uri = param.args[2].getData() if param.args[2] is not None else None
        if uri is None:
            self._record("cover_picker_result", result="missing_image")
            BulletinHelper.show_error("未收到图片，请重新选择")
            return
        self._record("cover_picker_result", result="received")
        resolver = param.thisObject.getContentResolver()
        self._art_importing = True
        # Decode away from the UI thread, bounded to a 512 px output.
        import threading
        threading.Thread(target=self._import_default_art,args=(resolver,uri),daemon=True).start()

    @diagnostic_operation
    def _import_default_art(self,resolver,uri):
        try:
            from android.graphics import BitmapFactory
            options = BitmapFactory.Options()
            options.inJustDecodeBounds=True
            stream=resolver.openInputStream(uri)
            try: BitmapFactory.decodeStream(stream,None,options)
            finally:
                if stream is not None: stream.close()
            w,h=int(options.outWidth),int(options.outHeight)
            if w<=0 or h<=0 or w*h>100000000: raise ValueError("invalid_image_dimensions")
            sample=1
            while max(w,h)//sample>1536: sample*=2
            options.inJustDecodeBounds=False
            options.inSampleSize=sample
            stream=resolver.openInputStream(uri)
            try: bitmap=BitmapFactory.decodeStream(stream,None,options)
            finally:
                if stream is not None: stream.close()
            if bitmap is None: raise ValueError("image_decode_failed")
            # Honor camera orientation before presenting crop coordinates.
            try:
                from android.media import ExifInterface
                stream=resolver.openInputStream(uri)
                try: orientation=ExifInterface(stream).getAttributeInt(ExifInterface.TAG_ORIENTATION,1)
                finally:
                    if stream is not None: stream.close()
                matrix=Matrix()
                if orientation in (3,4): matrix.postRotate(180.0)
                elif orientation in (5,6): matrix.postRotate(90.0)
                elif orientation in (7,8): matrix.postRotate(270.0)
                if orientation in (2,4,5,7): matrix.postScale(-1.0,1.0)
                if orientation!=1:
                    bitmap=Bitmap.createBitmap(bitmap,0,0,bitmap.getWidth(),bitmap.getHeight(),matrix,True)
            except Exception: pass
            def show():
                try: self._show_crop(bitmap)
                except Exception as exc:
                    self._close_crop()
                    self._failure("cover_crop_open",exc)
                    BulletinHelper.show_error("无法打开裁剪界面，原封面未改动")
            run_on_ui_thread(show)
        except Exception as exc:
            self._art_importing=False
            self._failure("default_art_import",exc)
            run_on_ui_thread(lambda:BulletinHelper.show_error("图片读取失败，请选择 JPG 或 PNG 图片"))

    @diagnostic_operation
    def _edit_speed_rates(self, view=None):
        activity = self._get_activity()
        if activity is None: return
        edit = self._themed_edit(activity)
        edit.setSingleLine(True)
        edit.setText(str(self.get_setting("speed_rates","1,1.25,1.5,2")))
        edit.setPadding(dp(20),dp(12),dp(20),dp(12))
        message = ("1 = 正常速度；1.25 = 快 25%；1.5 = 快 50%；2 = 两倍速度。\n"
                   "小于 1 会变慢，例如 0.75。可填 0.5～3，最多 8 个速度。\n\n"
                   "用逗号分隔，例如：1,1.25,1.5,2\n"
                   "顺序循环：每点一次倍速按钮，按填写顺序切到下一个速度，再回到第一个。\n\n"
                   "可在“播放速度”页面直接选择。也可把任一快捷按钮设为“倍速”。")
        def save(view):
            try:
                value = validate_speed_input(str(edit.getText()))
            except ValueError as exc:
                edit.setError(str(exc))
                self._record("speed_edit", result="invalid_input")
                return
            self.set_setting("speed_rates",value)
            self._setting_changed("speed_rates",value)
            builder.dismiss()
        builder = AlertDialogBuilder(activity)
        builder.set_title("常用播放速度")
        builder.set_message(message)
        builder.set_view(edit)
        builder.set_negative_button("取消")
        builder.set_positive_button("保存")
        builder.show()
        builder.get_button(-1).setOnClickListener(OnClickListener(save))

    def _animate_progress_arc(self, duration):
        self._arc_generation = getattr(self,"_arc_generation",0)+1
        token = self._arc_generation
        end = time.monotonic()+duration/1000.0+.08
        def frame():
            if token != self._arc_generation or not self.alive or self.progress_ring is None: return
            try: self._render_progress_ring(self._playing_message())
            except Exception as exc:
                self._failure("progress_arc_motion",exc)
                return
            if time.monotonic()<end: run_on_ui_thread(frame,16)
        frame()

    def _wave_tick(self, token):
        reason = None
        if token != getattr(self, "_wave_generation", 0):
            reason = "superseded"
        elif not self.alive or self.glow is None:
            reason = "inactive"
        elif self.container is None or self.container.getVisibility()!=View.VISIBLE or self.backgrounded:
            reason = "hidden"
        elif self._spectrum_config()[0]:
            reason = "spectrum_selected"
        style = config_int(self.get_setting("glow_style",0),0,0,2)
        if reason or not style:
            reason = reason or "classic_selected"
            if reason != "superseded":
                self._wave_active = False
            self._diagnostic_sample("wave_callback", result="skipped", reason=reason)
            return
        try:
            side = dp(self._sizes()[0]+36)
            bmp = getattr(self,"_wave_bitmap",None)
            if bmp is None or bmp.getWidth()!=side:
                bmp = Bitmap.createBitmap(side,side,Bitmap.Config.ARGB_8888)
                self._wave_bitmap = bmp
                self._wave_paint = Paint(Paint.ANTI_ALIAS_FLAG)
                self._wave_path = Path()
                self._wave_rect = RectF()
            bmp.eraseColor(0)
            canvas = Canvas(bmp)
            paint = self._wave_paint
            paint.setStyle(Paint.Style.STROKE)
            paint.setStrokeCap(Paint.Cap.ROUND)
            speed = config_int(self.get_setting("glow_flow_speed",1),1,0,2)
            t = time.monotonic()/(6.0,4.0,2.5)[speed]
            mode = config_int(self.get_setting("glow_color",0),0,0,7)
            if self._spectrum_config()[0]==2: mode=7
            mid = side/2.0
            r = dp(self._sizes()[0]/2+2)
            shader_key = (side,mode,self.last_cover_key if mode==2 else None)
            if shader_key != getattr(self,"_wave_shader_key",None):
                palette = glow_palette(mode,self._glow_rgb())
                colors = jarray(jint)([argb32(255,*rgb) for rgb in palette])
                stops = jarray(jfloat)([float(i/(len(palette)-1)) for i in range(len(palette))])
                self._wave_shader = SweepGradient(float(mid),float(mid),colors,stops)
                self._wave_shader_matrix = Matrix()
                self._wave_shader_key = shader_key
            self._wave_shader_matrix.setRotate(float((t*.25%1)*360),float(mid),float(mid))
            self._wave_shader.setLocalMatrix(self._wave_shader_matrix)
            paint.setShader(self._wave_shader)
            for band in range(3):
                q = (t+band/3.0)%1.0
                # Fade both ends so a newly emitted ripple never pops into view.
                alpha = int(240*math.sin(math.pi*q)*(1-q)) if style==1 else (210,125,60)[band]
                if style==1:
                    rr = r+dp(13)*q
                    paint.setAlpha(max(0,alpha//5))
                    paint.setStrokeWidth(float(dp(4)))
                    canvas.drawCircle(float(mid),float(mid),float(rr),paint)
                    paint.setAlpha(max(0,alpha))
                    paint.setStrokeWidth(float(dp(1.1)))
                    canvas.drawCircle(float(mid),float(mid),float(rr),paint)
                else:
                    path = self._wave_path
                    path.reset()
                    for i in range(65):
                        angle = i*2*math.pi/64
                        rr = r+dp(3+band*3)+dp(1.8)*math.sin(5*angle-t*math.tau)+dp(1.0)*math.sin(3*angle+t*math.tau*.7)
                        x,y = float(mid+rr*math.cos(angle)),float(mid+rr*math.sin(angle))
                        if i==0: path.moveTo(x,y)
                        else: path.lineTo(x,y)
                    path.close()
                    paint.setAlpha(alpha//5)
                    paint.setStrokeWidth(float(dp(5)))
                    canvas.drawPath(path,paint)
                    paint.setAlpha(alpha)
                    paint.setStrokeWidth(float(dp(1.4)))
                    canvas.drawPath(path,paint)
            self.glow.setImageBitmap(bmp)
            self.glow_flash.setImageBitmap(bmp)
            self._diagnostic_sample("wave_frame", result="bitmap_updated", style=str(style))
            run_on_ui_thread(lambda:self._wave_tick(token),33)
        except Exception as exc:
            self._wave_active = False
            self._failure("water_glow",exc)

    @diagnostic_operation
    def _close_crop(self):
        dialog = getattr(self,"_crop_dialog",None)
        self._crop_dialog = None
        self._crop_state = None
        self._art_importing = False
        if dialog is not None:
            try: dialog.dismiss()
            except Exception: pass

    @diagnostic_operation
    def _show_crop(self, bitmap):
        if not self.alive:
            self._art_importing = False
            return
        activity = self._get_activity()
        if activity is None:
            self._art_importing = False
            return
        self._close_crop()
        self._art_importing = True
        # Square editor, circular visible area. ImageView matrix avoids copying on drag.
        size = min(dp(260),int(activity.getResources().getDisplayMetrics().widthPixels)-dp(96))
        size = max(dp(120),size)
        host = FrameLayout(activity)
        image = ImageView(activity)
        image.setScaleType(ImageView.ScaleType.MATRIX)
        image.setImageBitmap(bitmap)
        host.addView(image,FrameLayout.LayoutParams(size,size,Gravity.CENTER))
        mask = Bitmap.createBitmap(size,size,Bitmap.Config.ARGB_8888)
        c = Canvas(mask)
        p = Paint(Paint.ANTI_ALIAS_FLAG)
        path = Path()
        path.setFillType(Path.FillType.EVEN_ODD)
        path.addRect(0.0,0.0,float(size),float(size),Path.Direction.CW)
        path.addCircle(size/2.0,size/2.0,size/2.0-1,Path.Direction.CW)
        p.setColor(argb32(190,0,0,0))
        c.drawPath(path,p)
        p.setStyle(Paint.Style.STROKE)
        p.setStrokeWidth(float(dp(1)))
        p.setColor(jint(Color.WHITE))
        c.drawCircle(size/2.0,size/2.0,size/2.0-dp(1),p)
        overlay = ImageView(activity)
        overlay.setImageBitmap(mask)
        host.addView(overlay,FrameLayout.LayoutParams(size,size,Gravity.CENTER))
        minimum = max(size/float(bitmap.getWidth()),size/float(bitmap.getHeight()))
        self._crop_state = dict(bitmap=bitmap,image=image,size=size,scale=minimum,minimum=minimum,
                                x=(size-bitmap.getWidth()*minimum)/2,y=(size-bitmap.getHeight()*minimum)/2,
                                gesture=None,mask=mask,matrix=Matrix())
        self._crop_touch_listener = CropTouch(self)
        image.setOnTouchListener(self._crop_touch_listener)
        self._crop_update_matrix()
        wrapper = LinearLayout(activity)
        wrapper.setOrientation(LinearLayout.VERTICAL)
        hint = self._playlist_text(activity,"拖动选择位置，双指缩放；圆形内就是封面",13)
        hint.setSingleLine(False)
        hint.setEllipsize(None)
        hint.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
        hint.setPadding(dp(16),dp(8),dp(16),dp(12))
        wrapper.addView(hint)
        wrapper.addView(host,LinearLayout.LayoutParams(-1,size))
        dialog = AlertDialog.Builder(activity).setTitle("选取默认封面区域").setView(wrapper).setNegativeButton(
            "取消",DialogAction(lambda d,w:self._close_crop())).setPositiveButton(
            "使用此区域",DialogAction(lambda d,w:self._save_crop())).create()
        self._crop_dialog = dialog
        dialog.setOnCancelListener(CropCancel(self))
        dialog.show()
        self._record("cover_crop_open", result="shown")

    def _crop_update_matrix(self):
        state = getattr(self,"_crop_state",None)
        if state is None: return
        bmp,side,scale = state['bitmap'],state['size'],state['scale']
        state['x'] = clamp(state['x'],side-bmp.getWidth()*scale,0.0)
        state['y'] = clamp(state['y'],side-bmp.getHeight()*scale,0.0)
        matrix = state['matrix']
        matrix.setScale(float(scale),float(scale))
        matrix.postTranslate(float(state['x']),float(state['y']))
        state['image'].setImageMatrix(matrix)

    def _crop_touch(self,event):
        st = getattr(self,"_crop_state",None)
        if st is None: return False
        action = event.getActionMasked()
        if action != MotionEvent.ACTION_MOVE:
            self._diagnostic_sample("crop_gesture", touch_action=int(action), count=int(event.getPointerCount()))
        count = event.getPointerCount()
        if action in (MotionEvent.ACTION_UP,MotionEvent.ACTION_CANCEL,MotionEvent.ACTION_POINTER_UP):
            st['gesture']=None
            return True
        x,y = float(event.getX(0)),float(event.getY(0))
        distance = 0.0
        if count>=2:
            x2,y2 = float(event.getX(1)),float(event.getY(1))
            distance = math.hypot(x-x2,y-y2)
            x,y = (x+x2)/2,(y+y2)/2
        mode = 2 if count>=2 else 1
        previous = st['gesture']
        if previous is not None and previous[0]==mode and action==MotionEvent.ACTION_MOVE:
            _,px,py,pd = previous
            old = st['scale']
            new = clamp(old*distance/pd,st['minimum'],st['minimum']*6) if mode==2 and pd>1 else old
            st['x'] = x-(px-st['x'])*new/old
            st['y'] = y-(py-st['y'])*new/old
            st['scale'] = new
            self._crop_update_matrix()
        st['gesture']=(mode,x,y,distance)
        return True

    @diagnostic_operation
    def _save_crop(self):
        st = getattr(self,"_crop_state",None)
        if st is None: return
        self._crop_state = None
        self._crop_dialog = None
        def save():
            temp = None
            success = False
            try:
                from java.io import FileOutputStream
                result = Bitmap.createBitmap(512,512,Bitmap.Config.ARGB_8888)
                canvas = Canvas(result)
                ratio = 512.0/st['size']
                matrix = Matrix()
                matrix.setScale(float(st['scale']*ratio),float(st['scale']*ratio))
                matrix.postTranslate(float(st['x']*ratio),float(st['y']*ratio))
                paint = Paint(Paint.ANTI_ALIAS_FLAG)
                paint.setFilterBitmap(True)
                canvas.drawBitmap(st['bitmap'],matrix,paint)
                path = self._default_art_path()
                temp = path+'.tmp'
                out = FileOutputStream(temp)
                try:
                    if not result.compress(Bitmap.CompressFormat.PNG,100,out): raise IOError('encode_failed')
                finally: out.close()
                if self.alive:
                    os.replace(temp,path)
                    success=True
            except Exception as exc: self._failure('cover_crop_save',exc)
            finally:
                if temp and os.path.exists(temp): os.remove(temp)
            def done():
                self._art_importing=False
                if not self.alive: return
                if success:
                    self._art_changed()
                    self._record("cover_crop_save", result="saved", width_px=512, height_px=512)
                    self._show_info('封面区域已保存，仅替代缺失的封面')
                else: BulletinHelper.show_error('保存失败，原来的默认封面已保留')
            run_on_ui_thread(done)
        import threading
        threading.Thread(target=save,daemon=True).start()

